[{"action": "block_replace", "block_id": "bXM", "replacement": "<shape width=\"654\" height=\"45.12503937007874\" topLeftX=\"30\" topLeftY=\"38.87496062992126\" type=\"text\" id=\"bXM\">\n        <content textType=\"headline\" paddingTop=\"3.6\" paddingBottom=\"3.6\" paddingLeft=\"7.2\" paddingRight=\"7.2\" fontSize=\"36\" fontFamily=\"Calibri\" color=\"rgba(0, 0, 0, 1)\" bold=\"true\" italic=\"false\" underline=\"false\" strikethrough=\"false\" lineSpacing=\"multiple:1.2\" textAlign=\"left\">\n          <p textAlign=\"left\" lineSpacing=\"multiple:1.2\" marginLeft=\"9.38\" indent=\"-9.38\"><strong><span color=\"rgba(0, 0, 0, 1)\" fontSize=\"36\" fontFamily=\"Calibri\" italic=\"false\" strikethrough=\"false\" underline=\"false\">可移植的信号处理</span></strong></p>\n        </content>\n      </shape>"}, {"action": "block_replace", "block_id": "bXn", "replacement": "<shape width=\"654\" height=\"168\" topLeftX=\"30\" topLeftY=\"90\" type=\"text\" id=\"bXn\">\n        <content verticalAlign=\"top\" paddingTop=\"3.6\" paddingBottom=\"3.6\" paddingLeft=\"7.2\" paddingRight=\"7.2\" fontSize=\"24\" fontFamily=\"Calibri\" color=\"rgba(0, 0, 0, 1)\" bold=\"true\" italic=\"false\" underline=\"false\" strikethrough=\"false\" lineSpacing=\"multiple:1.2\" textAlign=\"left\">\n          <ul>\n            <li>\n              <p textAlign=\"left\" lineSpacing=\"multiple:1.2\" beforeLineSpacing=\"multiple:0.20\" marginLeft=\"27\" indent=\"-27\" bulletColor=\"rgba(153, 0, 0, 1)\" bulletSize=\"60px\" bulletChar=\"¢\"><strong><span color=\"rgba(0, 0, 0, 1)\" fontSize=\"24\" fontFamily=\"Calibri\" italic=\"false\" strikethrough=\"false\" underline=\"false\">唉！不同版本的 Unix 可能有不同的信号处理语义</span></strong></p>\n            </li>\n          </ul>\n          <ul listStyle=\"pptx-square\">\n            <li>\n              <p textAlign=\"left\" lineSpacing=\"multiple:1.2\" beforeLineSpacing=\"multiple:0.20\" level=\"2\" marginLeft=\"58.5\" indent=\"-22.5\" bulletColor=\"rgba(153, 0, 0, 1)\" bulletSize=\"110px\"><span color=\"rgba(0, 0, 0, 1)\" fontSize=\"20\" fontFamily=\"Calibri\" bold=\"false\" italic=\"false\" strikethrough=\"false\" underline=\"false\">一些较旧的系统在捕获信号后将动作恢复为默认</span></p>\n            </li>\n            <li>\n              <p textAlign=\"left\" lineSpacing=\"multiple:1.2\" beforeLineSpacing=\"multiple:0.20\" level=\"2\" marginLeft=\"58.5\" indent=\"-22.5\" bulletColor=\"rgba(153, 0, 0, 1)\" bulletSize=\"110px\"><span color=\"rgba(0, 0, 0, 1)\" fontSize=\"20\" fontFamily=\"Calibri\" bold=\"false\" italic=\"false\" strikethrough=\"false\" underline=\"false\">一些被中断的系统调用可能以 errno == EINTR 返回</span></p>\n            </li>\n            <li>\n              <p textAlign=\"left\" lineSpacing=\"multiple:1.2\" beforeLineSpacing=\"multiple:0.20\" level=\"2\" marginLeft=\"58.5\" indent=\"-22.5\" bulletColor=\"rgba(153, 0, 0, 1)\" bulletSize=\"110px\"><span color=\"rgba(0, 0, 0, 1)\" fontSize=\"20\" fontFamily=\"Calibri\" bold=\"false\" italic=\"false\" strikethrough=\"false\" underline=\"false\">一些系统不会阻塞正在被处理的信号类型</span></p>\n            </li>\n          </ul>\n          <ul>\n            <li>\n              <p textAlign=\"left\" lineSpacing=\"multiple:1.2\" beforeLineSpacing=\"multiple:0.20\" marginLeft=\"27\" indent=\"-27\" bulletColor=\"rgba(153, 0, 0, 1)\" bulletSize=\"60px\" bulletChar=\"¢\"><strong><span color=\"rgba(0, 0, 0, 1)\" fontSize=\"24\" fontFamily=\"Calibri\" italic=\"false\" strikethrough=\"false\" underline=\"false\">解决方案：sigaction</span></strong></p>\n            </li>\n          </ul>\n        </content>\n      </shape>"}, {"action": "block_replace", "block_id": "bXz", "replacement": "<shape width=\"671.1051968503937\" height=\"225.3796850393701\" topLeftX=\"18.894803149606275\" topLeftY=\"294.0796850393701\" type=\"rect\" id=\"bXz\">\n        <fill>\n          <fillColor color=\"rgba(246, 245, 189, 1)\"/>\n        </fill>\n        <border color=\"rgba(0, 0, 0, 1)\" width=\"1\" lineJoin=\"miter\"/>\n        <content verticalAlign=\"top\" paddingTop=\"3.6\" paddingBottom=\"3.6\" paddingLeft=\"7.2\" paddingRight=\"7.2\" fontSize=\"16\" fontFamily=\"思源黑体\" color=\"rgba(31, 35, 41, 1)\" textAlign=\"left\" autoFit=\"shape-auto-fit\" wrap=\"false\">\n          <p textAlign=\"left\" lineSpacing=\"multiple:1.2\" defaultTabSize=\"72\"><strong><span color=\"rgba(45, 150, 30, 1)\" fontSize=\"15\" fontFamily=\"Menlo-Regular\" italic=\"false\" strikethrough=\"false\" underline=\"false\">handler_t</span></strong><strong><span color=\"rgba(0, 0, 0, 1)\" fontSize=\"15\" fontFamily=\"Menlo-Regular\" italic=\"false\" strikethrough=\"false\" underline=\"false\"> *</span></strong><strong><span color=\"rgba(74, 0, 255, 1)\" fontSize=\"15\" fontFamily=\"Menlo-Regular\" italic=\"false\" strikethrough=\"false\" underline=\"false\">Signal</span></strong><strong><span color=\"rgba(0, 0, 0, 1)\" fontSize=\"15\" fontFamily=\"Menlo-Regular\" italic=\"false\" strikethrough=\"false\" underline=\"false\">(</span></strong><strong><span color=\"rgba(45, 150, 30, 1)\" fontSize=\"15\" fontFamily=\"Menlo-Regular\" italic=\"false\" strikethrough=\"false\" underline=\"false\">int</span></strong><strong><span color=\"rgba(0, 0, 0, 1)\" fontSize=\"15\" fontFamily=\"Menlo-Regular\" italic=\"false\" strikethrough=\"false\" underline=\"false\"> </span></strong><strong><span color=\"rgba(193, 101, 28, 1)\" fontSize=\"15\" fontFamily=\"Menlo-Regular\" italic=\"false\" strikethrough=\"false\" underline=\"false\">signum</span></strong><strong><span color=\"rgba(0, 0, 0, 1)\" fontSize=\"15\" fontFamily=\"Menlo-Regular\" italic=\"false\" strikethrough=\"false\" underline=\"false\">, </span></strong><strong><span color=\"rgba(45, 150, 30, 1)\" fontSize=\"15\" fontFamily=\"Menlo-Regular\" italic=\"false\" strikethrough=\"false\" underline=\"false\">handler_t</span></strong><strong><span color=\"rgba(0, 0, 0, 1)\" fontSize=\"15\" fontFamily=\"Menlo-Regular\" italic=\"false\" strikethrough=\"false\" underline=\"false\"> *</span></strong><strong><span color=\"rgba(193, 101, 28, 1)\" fontSize=\"15\" fontFamily=\"Menlo-Regular\" italic=\"false\" strikethrough=\"false\" underline=\"false\">handler</span></strong><strong><span color=\"rgba(0, 0, 0, 1)\" fontSize=\"15\" fontFamily=\"Menlo-Regular\" italic=\"false\" strikethrough=\"false\" underline=\"false\">)</span></strong></p>\n          <p textAlign=\"left\" lineSpacing=\"multiple:1.2\" defaultTabSize=\"72\"><strong><span color=\"rgba(0, 0, 0, 1)\" fontSize=\"15\" fontFamily=\"Menlo-Regular\" italic=\"false\" strikethrough=\"false\" underline=\"false\">{</span></strong></p>\n          <p textAlign=\"left\" lineSpacing=\"multiple:1.2\" defaultTabSize=\"72\"><strong><span color=\"rgba(0, 0, 0, 1)\" fontSize=\"15\" fontFamily=\"Menlo-Regular\" italic=\"false\" strikethrough=\"false\" underline=\"false\">    </span></strong><strong><span color=\"rgba(194, 0, 255, 1)\" fontSize=\"15\" fontFamily=\"Menlo-Regular\" italic=\"false\" strikethrough=\"false\" underline=\"false\">struct</span></strong><strong><span color=\"rgba(0, 0, 0, 1)\" fontSize=\"15\" fontFamily=\"Menlo-Regular\" italic=\"false\" strikethrough=\"false\" underline=\"false\"> </span></strong><strong><span color=\"rgba(45, 150, 30, 1)\" fontSize=\"15\" fontFamily=\"Menlo-Regular\" italic=\"false\" strikethrough=\"false\" underline=\"false\">sigaction</span></strong><strong><span color=\"rgba(0, 0, 0, 1)\" fontSize=\"15\" fontFamily=\"Menlo-Regular\" italic=\"false\" strikethrough=\"false\" underline=\"false\"> </span></strong><strong><span color=\"rgba(193, 101, 28, 1)\" fontSize=\"15\" fontFamily=\"Menlo-Regular\" italic=\"false\" strikethrough=\"false\" underline=\"false\">action</span></strong><strong><span color=\"rgba(0, 0, 0, 1)\" fontSize=\"15\" fontFamily=\"Menlo-Regular\" italic=\"false\" strikethrough=\"false\" underline=\"false\">, </span></strong><strong><span color=\"rgba(193, 101, 28, 1)\" fontSize=\"15\" fontFamily=\"Menlo-Regular\" italic=\"false\" strikethrough=\"false\" underline=\"false\">old_action</span></strong><strong><span color=\"rgba(0, 0, 0, 1)\" fontSize=\"15\" fontFamily=\"Menlo-Regular\" italic=\"false\" strikethrough=\"false\" underline=\"false\">;</span></strong></p>\n          <p textAlign=\"left\" lineSpacing=\"multiple:1.2\" defaultTabSize=\"72\"/>\n          <p textAlign=\"left\" lineSpacing=\"multiple:1.2\" defaultTabSize=\"72\"><strong><span color=\"rgba(0, 0, 0, 1)\" fontSize=\"15\" fontFamily=\"Menlo-Regular\" italic=\"false\" strikethrough=\"false\" underline=\"false\">    action.sa_handler = handler;</span></strong></p>\n          <p textAlign=\"left\" lineSpacing=\"multiple:1.2\" defaultTabSize=\"72\"><strong><span color=\"rgba(0, 0, 0, 1)\" fontSize=\"15\" fontFamily=\"Menlo-Regular\" italic=\"false\" strikethrough=\"false\" underline=\"false\">    sigemptyset(&amp;action.sa_mask); </span></strong><strong><span color=\"rgba(203, 36, 24, 1)\" fontSize=\"15\" fontFamily=\"Menlo-Regular\" italic=\"false\" strikethrough=\"false\" underline=\"false\">/* 阻塞正在被处理的信号类型 */</span></strong></p>\n          <p textAlign=\"left\" lineSpacing=\"multiple:1.2\" defaultTabSize=\"72\"><strong><span color=\"rgba(0, 0, 0, 1)\" fontSize=\"15\" fontFamily=\"Menlo-Regular\" italic=\"false\" strikethrough=\"false\" underline=\"false\">    action.sa_flags = SA_RESTART; </span></strong><strong><span color=\"rgba(203, 36, 24, 1)\" fontSize=\"15\" fontFamily=\"Menlo-Regular\" italic=\"false\" strikethrough=\"false\" underline=\"false\">/* 如果可能则重启系统调用 */</span></strong></p>\n          <p textAlign=\"left\" lineSpacing=\"multiple:1.2\" defaultTabSize=\"72\"/>\n          <p textAlign=\"left\" lineSpacing=\"multiple:1.2\" defaultTabSize=\"72\"><strong><span color=\"rgba(0, 0, 0, 1)\" fontSize=\"15\" fontFamily=\"Menlo-Regular\" italic=\"false\" strikethrough=\"false\" underline=\"false\">    </span></strong><strong><span color=\"rgba(194, 0, 255, 1)\" fontSize=\"15\" fontFamily=\"Menlo-Regular\" italic=\"false\" strikethrough=\"false\" underline=\"false\">if</span></strong><strong><span color=\"rgba(0, 0, 0, 1)\" fontSize=\"15\" fontFamily=\"Menlo-Regular\" italic=\"false\" strikethrough=\"false\" underline=\"false\"> (sigaction(signum, &amp;action, &amp;old_action) &lt; 0)</span></strong></p>\n          <p textAlign=\"left\" lineSpacing=\"multiple:1.2\" defaultTabSize=\"72\"><strong><span color=\"rgba(0, 0, 0, 1)\" fontSize=\"15\" fontFamily=\"Menlo-Regular\" italic=\"false\" strikethrough=\"false\" underline=\"false\">        unix_error(</span></strong><strong><span color=\"rgba(157, 32, 111, 1)\" fontSize=\"15\" fontFamily=\"Menlo-Regular\" italic=\"false\" strikethrough=\"false\" underline=\"false\">&quot;Signal 错误&quot;</span></strong><strong><span color=\"rgba(0, 0, 0, 1)\" fontSize=\"15\" fontFamily=\"Menlo-Regular\" italic=\"false\" strikethrough=\"false\" underline=\"false\">);</span></strong></p>\n          <p textAlign=\"left\" lineSpacing=\"multiple:1.2\" defaultTabSize=\"72\"><strong><span color=\"rgba(0, 0, 0, 1)\" fontSize=\"15\" fontFamily=\"Menlo-Regular\" italic=\"false\" strikethrough=\"false\" underline=\"false\">    </span></strong><strong><span color=\"rgba(194, 0, 255, 1)\" fontSize=\"15\" fontFamily=\"Menlo-Regular\" italic=\"false\" strikethrough=\"false\" underline=\"false\">return</span></strong><strong><span color=\"rgba(0, 0, 0, 1)\" fontSize=\"15\" fontFamily=\"Menlo-Regular\" italic=\"false\" strikethrough=\"false\" underline=\"false\"> (old_action.sa_handler);</span></strong></p>\n          <p textAlign=\"left\" lineSpacing=\"multiple:1.2\" defaultTabSize=\"72\"><strong><span color=\"rgba(0, 0, 0, 1)\" fontSize=\"15\" fontFamily=\"Menlo-Regular\" italic=\"false\" strikethrough=\"false\" underline=\"false\">}</span></strong></p>\n        </content>\n      </shape>"}, {"action": "block_replace", "block_id": "bXc", "replacement": "<shape width=\"70.33708661417323\" height=\"29.081259842519685\" topLeftX=\"619.6629133858268\" topLeftY=\"491.3781102362205\" type=\"text\" id=\"bXc\">\n        <co