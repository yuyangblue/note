[{"action": "block_replace", "block_id": "biO", "replacement": "<shape width=\"597.8025984251968\" height=\"60\" topLeftX=\"28.111653543307114\" topLeftY=\"34.30535433070867\" type=\"text\" id=\"biO\">\n        <content textType=\"headline\" paddingTop=\"3.6\" paddingBottom=\"3.6\" paddingLeft=\"7.2\" paddingRight=\"7.2\" fontSize=\"36\" fontFamily=\"Calibri\" color=\"rgba(0, 0, 0, 1)\" bold=\"true\" italic=\"false\" underline=\"false\" strikethrough=\"false\" lineSpacing=\"multiple:1.2\" textAlign=\"left\">\n          <p textAlign=\"left\" lineSpacing=\"multiple:1.2\" marginLeft=\"9.38\" indent=\"-9.38\"><strong><span color=\"rgba(0, 0, 0, 1)\" fontSize=\"36\" fontFamily=\"Calibri\" italic=\"false\" strikethrough=\"false\" underline=\"false\">信号概念：待处理/阻塞位</span></strong></p>\n        </content>\n      </shape>"}, {"action": "block_replace", "block_id": "biR", "replacement": "<shape width=\"662.9829133858268\" height=\"291.37496062992125\" topLeftX=\"27.01708661417325\" topLeftY=\"132\" type=\"text\" id=\"biR\">\n        <content verticalAlign=\"top\" paddingTop=\"3.6\" paddingBottom=\"3.6\" paddingLeft=\"7.2\" paddingRight=\"7.2\" fontSize=\"24\" fontFamily=\"Calibri\" color=\"rgba(0, 0, 0, 1)\" bold=\"true\" italic=\"false\" underline=\"false\" strikethrough=\"false\" lineSpacing=\"multiple:1.2\" textAlign=\"left\">\n          <ul>\n            <li>\n              <p textAlign=\"left\" lineSpacing=\"multiple:1.2\" beforeLineSpacing=\"multiple:0.20\" marginLeft=\"27\" indent=\"-27\" bulletColor=\"rgba(153, 0, 0, 1)\" bulletSize=\"60px\" bulletChar=\"¢\"><strong><span color=\"rgba(0, 0, 0, 1)\" fontSize=\"24\" fontFamily=\"Calibri\" italic=\"false\" strikethrough=\"false\" underline=\"false\">内核在每个进程的上下文中维护待处理（pending）和阻塞（blocked）位向量</span></strong></p>\n            </li>\n          </ul>\n          <ul listStyle=\"pptx-square\">\n            <li>\n              <p textAlign=\"left\" lineSpacing=\"multiple:1.2\" beforeLineSpacing=\"multiple:0.20\" level=\"2\" marginLeft=\"58.5\" indent=\"-22.5\" bulletColor=\"rgba(153, 0, 0, 1)\" bulletSize=\"110px\"><strong><span color=\"rgba(0, 0, 0, 1)\" fontSize=\"20\" fontFamily=\"Courier New\" italic=\"false\" strikethrough=\"false\" underline=\"false\">pending：表示待处理信号的集合</span></strong></p>\n            </li>\n            <li>\n              <p textAlign=\"left\" lineSpacing=\"multiple:1.2\" beforeLineSpacing=\"multiple:0.20\" level=\"3\" marginLeft=\"90\" indent=\"-18\" bulletSize=\"80px\"><span color=\"rgba(0, 0, 0, 1)\" fontSize=\"20\" fontFamily=\"Calibri\" bold=\"false\" italic=\"false\" strikethrough=\"false\" underline=\"false\">当类型 k 的信号被递送时，内核在 pending 中置位 k</span></p>\n            </li>\n            <li>\n              <p textAlign=\"left\" lineSpacing=\"multiple:1.2\" beforeLineSpacing=\"multiple:0.20\" level=\"3\" marginLeft=\"90\" indent=\"-18\" bulletSize=\"80px\"><span color=\"rgba(0, 0, 0, 1)\" fontSize=\"20\" fontFamily=\"Calibri\" bold=\"false\" italic=\"false\" strikethrough=\"false\" underline=\"false\">当类型 k 的信号被接收时，内核清除 pending 中的位 k</span></p>\n            </li>\n          </ul>\n          <p textAlign=\"left\" lineSpacing=\"multiple:1.2\" beforeLineSpacing=\"multiple:0.20\" level=\"2\" marginLeft=\"58.5\" indent=\"-22.5\"></p>\n          <ul listStyle=\"pptx-square\">\n            <li>\n              <p textAlign=\"left\" lineSpacing=\"multiple:1.2\" beforeLineSpacing=\"multiple:0.20\" level=\"2\" marginLeft=\"58.5\" indent=\"-22.5\" bulletColor=\"rgba(153, 0, 0, 1)\" bulletSize=\"110px\"><strong><span color=\"rgba(0, 0, 0, 1)\" fontSize=\"20\" fontFamily=\"Courier New\" italic=\"false\" strikethrough=\"false\" underline=\"false\">blocked：表示被阻塞信号的集合</span></strong></p>\n            </li>\n            <li>\n              <p textAlign=\"left\" lineSpacing=\"multiple:1.2\" beforeLineSpacing=\"multiple:0.20\" level=\"3\" marginLeft=\"90\" indent=\"-18\" bulletSize=\"80px\"><span color=\"rgba(0, 0, 0, 1)\" fontSize=\"20\" fontFamily=\"Calibri\" bold=\"false\" italic=\"false\" strikethrough=\"false\" underline=\"false\">可以使用 sigprocmask 函数设置和清除</span></p>\n            </li>\n            <li>\n              <p textAlign=\"left\" lineSpacing=\"multiple:1.2\" beforeLineSpacing=\"multiple:0.20\" level=\"3\" marginLeft=\"90\" indent=\"-18\" bulletSize=\"80px\"><span color=\"rgba(0, 0, 0, 1)\" fontSize=\"20\" fontFamily=\"Calibri\" bold=\"false\" italic=\"false\" strikethrough=\"false\" underline=\"false\">也称为信号掩码（signal mask）。</span></p>\n            </li>\n          </ul>\n        </content>\n      </shape>"}]