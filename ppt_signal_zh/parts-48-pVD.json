[{"action": "block_replace", "block_id": "bsF", "replacement": "<shape width=\"672\" height=\"72\" topLeftX=\"36\" topLeftY=\"30\" type=\"text\" id=\"bsF\">\n        <content textType=\"headline\" paddingTop=\"3.6\" paddingBottom=\"3.6\" paddingLeft=\"7.2\" paddingRight=\"7.2\" fontSize=\"36\" fontFamily=\"Calibri\" color=\"rgba(0, 0, 0, 1)\" bold=\"true\" italic=\"false\" underline=\"false\" strikethrough=\"false\" lineSpacing=\"multiple:1.2\" textAlign=\"left\">\n          <p textAlign=\"left\" lineSpacing=\"multiple:1.2\" marginLeft=\"9.38\" indent=\"-9.38\"><strong><span color=\"rgba(0, 0, 0, 1)\" fontSize=\"36\" fontFamily=\"Calibri\" italic=\"false\" strikethrough=\"false\" underline=\"false\">非本地跳转：setjmp/longjmp</span></strong></p>\n        </content>\n      </shape>"}, {"action": "block_replace", "block_id": "bsX", "replacement": "<shape width=\"654.1249606299212\" height=\"354.25\" topLeftX=\"35.87503937007875\" topLeftY=\"113.75\" type=\"text\" id=\"bsX\">\n        <content verticalAlign=\"top\" paddingTop=\"3.6\" paddingBottom=\"3.6\" paddingLeft=\"7.2\" paddingRight=\"7.2\" fontSize=\"24\" fontFamily=\"Calibri\" color=\"rgba(0, 0, 0, 1)\" bold=\"true\" italic=\"false\" underline=\"false\" strikethrough=\"false\" lineSpacing=\"multiple:1.0\" textAlign=\"left\">\n          <ul>\n            <li>\n              <p textAlign=\"left\" lineSpacing=\"multiple:1.0\" beforeLineSpacing=\"multiple:0.20\" marginLeft=\"27\" indent=\"-27\" bulletColor=\"rgba(153, 0, 0, 1)\" bulletSize=\"60px\" bulletChar=\"¢\"><strong><span color=\"rgba(0, 0, 0, 1)\" fontSize=\"24\" fontFamily=\"Calibri\" italic=\"false\" strikethrough=\"false\" underline=\"false\">一种强大（但危险）的用户级机制，用于把控制转移到任意位置</span></strong></p>\n            </li>\n          </ul>\n          <ul listStyle=\"pptx-square\">\n            <li>\n              <p textAlign=\"left\" lineSpacing=\"multiple:1.1\" beforeLineSpacing=\"multiple:0.20\" level=\"2\" marginLeft=\"58.5\" indent=\"-22.5\" bulletColor=\"rgba(153, 0, 0, 1)\" bulletSize=\"110px\"><span color=\"rgba(0, 0, 0, 1)\" fontSize=\"20\" fontFamily=\"Calibri\" bold=\"false\" italic=\"false\" strikethrough=\"false\" underline=\"false\">一种受控的、打破过程调用/返回纪律的方式</span></p>\n            </li>\n            <li>\n              <p textAlign=\"left\" lineSpacing=\"multiple:1.1\" beforeLineSpacing=\"multiple:0.20\" level=\"2\" marginLeft=\"58.5\" indent=\"-22.5\" bulletColor=\"rgba(153, 0, 0, 1)\" bulletSize=\"110px\"><span color=\"rgba(0, 0, 0, 1)\" fontSize=\"20\" fontFamily=\"Calibri\" bold=\"false\" italic=\"false\" strikethrough=\"false\" underline=\"false\">对错误恢复和信号处理很有用</span></p>\n            </li>\n          </ul>\n          <p textAlign=\"left\" lineSpacing=\"multiple:1.0\" beforeLineSpacing=\"multiple:0.20\" marginLeft=\"27\" indent=\"-27\"></p>\n          <ul>\n            <li>\n              <p textAlign=\"left\" lineSpacing=\"multiple:1.0\" beforeLineSpacing=\"multiple:0.20\" marginLeft=\"27\" indent=\"-27\" bulletColor=\"rgba(153, 0, 0, 1)\" bulletSize=\"60px\" bulletChar=\"¢\"><strong><span color=\"rgba(0, 0, 0, 1)\" fontSize=\"24\" fontFamily=\"Courier New\" italic=\"false\" strikethrough=\"false\" underline=\"false\">int setjmp(jmp_buf j)</span></strong></p>\n            </li>\n          </ul>\n          <ul listStyle=\"pptx-square\">\n            <li>\n              <p textAlign=\"left\" lineSpacing=\"multiple:1.1\" beforeLineSpacing=\"multiple:0.20\" level=\"2\" marginLeft=\"58.5\" indent=\"-22.5\" bulletColor=\"rgba(153, 0, 0, 1)\" bulletSize=\"110px\"><span color=\"rgba(0, 0, 0, 1)\" fontSize=\"20\" fontFamily=\"Calibri\" bold=\"false\" italic=\"false\" strikethrough=\"false\" underline=\"false\">必须在 longjmp 之前调用</span></p>\n            </li>\n            <li>\n              <p textAlign=\"left\" lineSpacing=\"multiple:1.1\" beforeLineSpacing=\"multiple:0.20\" level=\"2\" marginLeft=\"58.5\" indent=\"-22.5\" bulletColor=\"rgba(153, 0, 0, 1)\" bulletSize=\"110px\"><span color=\"rgba(0, 0, 0, 1)\" fontSize=\"20\" fontFamily=\"Calibri\" bold=\"false\" italic=\"false\" strikethrough=\"false\" underline=\"false\">为后续的 longjmp 标识一个返回点</span></p>\n            </li>\n            <li>\n              <p textAlign=\"left\" lineSpacing=\"multiple:1.1\" beforeLineSpacing=\"multiple:0.20\" level=\"2\" marginLeft=\"58.5\" indent=\"-22.5\" bulletColor=\"rgba(153, 0, 0, 1)\" bulletSize=\"110px\"><span color=\"rgba(0, 0, 0, 1)\" fontSize=\"20\" fontFamily=\"Calibri\" bold=\"false\" italic=\"false\" strikethrough=\"false\" underline=\"false\">只调用一次，但返回一次或多次</span></p>\n            </li>\n          </ul>\n          <p textAlign=\"left\" lineSpacing=\"multiple:1.0\" beforeLineSpacing=\"multiple:0.20\" marginLeft=\"27\" indent=\"-27\"></p>\n          <ul>\n            <li>\n              <p textAlign=\"left\" lineSpacing=\"multiple:1.0\" beforeLineSpacing=\"multiple:0.20\" marginLeft=\"27\" indent=\"-27\" bulletColor=\"rgba(153, 0, 0, 1)\" bulletSize=\"60px\" bulletChar=\"¢\"><strong><span color=\"rgba(0, 0, 0, 1)\" fontSize=\"24\" fontFamily=\"Calibri\" italic=\"false\" strikethrough=\"false\" underline=\"false\">实现：</span></strong></p>\n            </li>\n          </ul>\n          <ul listStyle=\"pptx-square\">\n            <li>\n              <p textAlign=\"left\" lineSpacing=\"multiple:1.1\" beforeLineSpacing=\"multiple:0.20\" level=\"2\" marginLeft=\"58.5\" indent=\"-22.5\" bulletColor=\"rgba(153, 0, 0, 1)\" bulletSize=\"110px\"><span color=\"rgba(0, 0, 0, 1)\" fontSize=\"20\" fontFamily=\"Calibri\" bold=\"false\" italic=\"false\" strikethrough=\"false\" underline=\"false\">把当前寄存器上下文、栈指针和 PC 值存储在 jmp_buf 中，以记住你所在的位置</span></p>\n            </li>\n            <li>\n              <p textAlign=\"left\" lineSpacing=\"multiple:1.1\" beforeLineSpacing=\"multiple:0.20\" level=\"2\" marginLeft=\"58.5\" indent=\"-22.5\" bulletColor=\"rgba(153, 0, 0, 1)\" bulletSize=\"110px\"><span color=\"rgba(0, 0, 0, 1)\" fontSize=\"20\" fontFamily=\"Calibri\" bold=\"false\" italic=\"false\" strikethrough=\"false\" underline=\"false\">返回 0</span></p>\n            </li>\n          </ul>\n        </content>\n      </shape>"}]