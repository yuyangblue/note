[{"action": "block_replace", "block_id": "bFm", "replacement": "<shape width=\"597.8025984251968\" height=\"60\" topLeftX=\"28.111653543307114\" topLeftY=\"24\" type=\"text\" id=\"bFm\">\n        <content textType=\"headline\" paddingTop=\"3.6\" paddingBottom=\"3.6\" paddingLeft=\"7.2\" paddingRight=\"7.2\" fontSize=\"36\" fontFamily=\"Calibri\" color=\"rgba(0, 0, 0, 1)\" bold=\"true\" italic=\"false\" underline=\"false\" strikethrough=\"false\" lineSpacing=\"multiple:1.2\" textAlign=\"left\">\n          <p textAlign=\"left\" lineSpacing=\"multiple:1.2\" marginLeft=\"9.38\" indent=\"-9.38\"><strong><span color=\"rgba(0, 0, 0, 1)\" fontSize=\"36\" fontFamily=\"Calibri\" italic=\"false\" strikethrough=\"false\" underline=\"false\">编写安全处理程序的准则</span></strong></p>\n        </content>\n      </shape>"}, {"action": "block_replace", "block_id": "bFL", "replacement": "<shape width=\"664.75\" height=\"414.75\" topLeftX=\"31.25\" topLeftY=\"96\" type=\"text\" id=\"bFL\">\n        <content verticalAlign=\"top\" paddingTop=\"3.6\" paddingBottom=\"3.6\" paddingLeft=\"7.2\" paddingRight=\"7.2\" fontSize=\"24\" fontFamily=\"Calibri\" color=\"rgba(0, 0, 0, 1)\" bold=\"true\" italic=\"false\" underline=\"false\" strikethrough=\"false\" lineSpacing=\"multiple:1.1\" textAlign=\"left\" autoFit=\"normal-auto-fit\">\n          <ul>\n            <li>\n              <p textAlign=\"left\" lineSpacing=\"multiple:1.1\" beforeLineSpacing=\"multiple:0.20\" marginLeft=\"27\" indent=\"-27\" bulletColor=\"rgba(153, 0, 0, 1)\" bulletSize=\"60px\" bulletChar=\"¢\"><strong><span color=\"rgba(0, 0, 0, 1)\" fontSize=\"24\" fontFamily=\"Calibri\" italic=\"false\" strikethrough=\"false\" underline=\"false\">G0：让处理程序尽可能简单</span></strong></p>\n            </li>\n          </ul>\n          <ul listStyle=\"pptx-square\">\n            <li>\n              <p textAlign=\"left\" lineSpacing=\"multiple:1.1\" beforeLineSpacing=\"multiple:0.20\" level=\"2\" marginLeft=\"58.5\" indent=\"-22.5\" bulletColor=\"rgba(153, 0, 0, 1)\" bulletSize=\"110px\"><span color=\"rgba(0, 0, 0, 1)\" fontSize=\"20\" fontFamily=\"Calibri\" bold=\"false\" italic=\"false\" strikethrough=\"false\" underline=\"false\">例如，设置一个全局标志然后返回</span></p>\n            </li>\n          </ul>\n          <ul>\n            <li>\n              <p textAlign=\"left\" lineSpacing=\"multiple:1.1\" beforeLineSpacing=\"multiple:0.20\" marginLeft=\"27\" indent=\"-27\" bulletColor=\"rgba(153, 0, 0, 1)\" bulletSize=\"60px\" bulletChar=\"¢\"><strong><span color=\"rgba(0, 0, 0, 1)\" fontSize=\"24\" fontFamily=\"Calibri\" italic=\"false\" strikethrough=\"false\" underline=\"false\">G1：在处理程序中只调用异步信号安全函数</span></strong></p>\n            </li>\n          </ul>\n          <ul listStyle=\"pptx-square\">\n            <li>\n              <p textAlign=\"left\" lineSpacing=\"multiple:1.1\" beforeLineSpacing=\"multiple:0.20\" level=\"2\" marginLeft=\"58.5\" indent=\"-22.5\" bulletColor=\"rgba(153, 0, 0, 1)\" bulletSize=\"110px\"><span color=\"rgba(0, 0, 0, 1)\" fontSize=\"20\" fontFamily=\"Courier New\" bold=\"false\" italic=\"false\" strikethrough=\"false\" underline=\"false\">printf、sprintf、malloc 和 exit 都是不安全的！</span></p>\n            </li>\n          </ul>\n          <ul>\n            <li>\n              <p textAlign=\"left\" lineSpacing=\"multiple:1.1\" beforeLineSpacing=\"multiple:0.20\" marginLeft=\"27\" indent=\"-27\" bulletColor=\"rgba(153, 0, 0, 1)\" bulletSize=\"60px\" bulletChar=\"¢\"><strong><span color=\"rgba(0, 0, 0, 1)\" fontSize=\"24\" fontFamily=\"Calibri\" italic=\"false\" strikethrough=\"false\" underline=\"false\">G2：进入和退出时保存并恢复 errno</span></strong></p>\n            </li>\n          </ul>\n          <ul listStyle=\"pptx-square\">\n            <li>\n              <p textAlign=\"left\" lineSpacing=\"multiple:1.1\" beforeLineSpacing=\"multiple:0.20\" level=\"2\" marginLeft=\"58.5\" indent=\"-22.5\" bulletColor=\"rgba(153, 0, 0, 1)\" bulletSize=\"110px\"><span color=\"rgba(0, 0, 0, 1)\" fontSize=\"20\" fontFamily=\"Calibri\" bold=\"false\" italic=\"false\" strikethrough=\"false\" underline=\"false\">以免其他处理程序覆盖你的 errno 值</span></p>\n            </li>\n          </ul>\n          <ul>\n            <li>\n              <p textAlign=\"left\" lineSpacing=\"multiple:1.1\" beforeLineSpacing=\"multiple:0.20\" marginLeft=\"27\" indent=\"-27\" bulletColor=\"rgba(153, 0, 0, 1)\" bulletSize=\"60px\" bulletChar=\"¢\"><strong><span color=\"rgba(0, 0, 0, 1)\" fontSize=\"24\" fontFamily=\"Calibri\" italic=\"false\" strikethrough=\"false\" underline=\"false\">G3：通过临时阻塞所有信号来保护对共享数据结构的访问。</span></strong></p>\n            </li>\n          </ul>\n          <ul listStyle=\"pptx-square\">\n            <li>\n              <p textAlign=\"left\" lineSpacing=\"multiple:1.1\" beforeLineSpacing=\"multiple:0.20\" level=\"2\" marginLeft=\"58.5\" indent=\"-22.5\" bulletColor=\"rgba(153, 0, 0, 1)\" bulletSize=\"110px\"><span color=\"rgba(0, 0, 0, 1)\" fontSize=\"20\" fontFamily=\"Calibri\" bold=\"false\" italic=\"false\" strikethrough=\"false\" underline=\"false\">以防止可能的破坏</span></p>\n            </li>\n          </ul>\n          <ul>\n            <li>\n              <p textAlign=\"left\" lineSpacing=\"multiple:1.1\" beforeLineSpacing=\"multiple:0.20\" marginLeft=\"27\" indent=\"-27\" bulletColor=\"rgba(153, 0, 0, 1)\" bulletSize=\"60px\" bulletChar=\"¢\"><strong><span color=\"rgba(0, 0, 0, 1)\" fontSize=\"24\" fontFamily=\"Calibri\" italic=\"false\" strikethrough=\"false\" underline=\"false\">G4：将全局变量声明为 volatile</span></strong></p>\n            </li>\n          </ul>\n          <ul listStyle=\"pptx-square\">\n            <li>\n              <p textAlign=\"left\" lineSpacing=\"multiple:1.1\" beforeLineSpacing=\"multiple:0.20\" level=\"2\" marginLeft=\"58.5\" indent=\"-22.5\" bulletColor=\"rgba(153, 0, 0, 1)\" bulletSize=\"110px\"><span color=\"rgba(0, 0, 0, 1)\" fontSize=\"20\" fontFamily=\"Calibri\" bold=\"false\" italic=\"false\" strikethrough=\"false\" underline=\"false\">防止编译器把它们存到寄存器中</span></p>\n            </li>\n          </ul>\n          <ul>\n            <li>\n              <p textAlign=\"left\" lineSpacing=\"multiple:1.1\" beforeLineSpacing=\"multiple:0.20\" marginLeft=\"27\" indent=\"-27\" bulletColor=\"rgba(153, 0, 0, 1)\" bulletSize=\"60px\" bulletChar=\"¢\"><strong><span color=\"rgba(0, 0, 0, 1)\" fontSize=\"24\" fontFamily=\"Calibri\" italic=\"false\" strikethrough=\"false\" underline=\"false\">G5：将全局标志声明为 volatile sig_atomic_t</span></strong></p>\n            </li>\n          </ul>\n          <ul listStyle=\"pptx-square\">\n            <li>\n              <p textAlign=\"left\" lineSpacing=\"multiple:1.1\" beforeLineSpacing=\"multiple:0.20\" level=\"2\" marginLeft=\"58.5\" indent=\"-22.5\" bulletColor=\"rgba(153, 0, 0, 1)\" bulletSize=\"110px\"><span color=\"rgba(0, 0, 0, 1)\" fontSize=\"20\" fontFamily=\"Calibri\" bold=\"false\" strikethrough=\"false\" underline=\"false\">flag：只被读取或写入的变量（例如 flag = 1，而不是 flag++）</span></p>\n            </li>\n            <li>\n              <p textAlign=\"left\" lineSpacing=\"multiple:1.1\" beforeLineSpacing=\"multiple:0.20\" level=\"2\" marginLeft=\"58.5\" indent=\"-22.5\" bulletColor=\"rgba(153, 0, 0, 1)\" bulletSize=\"110px\"><span color=\"rgba(0, 0, 0, 1)\" fontSize=\"20\" fontFamily=\"Calibri\" bold=\"false\" italic=\"false\" strikethrough=\"false\" underline=\"false\">这样声明的标志不需要像其他全局变量那样被保护</span></p>\n            </li>\n          </ul>\n        </content>\n      </shape>"}]