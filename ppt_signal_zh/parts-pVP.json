[{"action": "block_replace", "block_id": "bwE", "replacement": "<shape width=\"597.8025984251968\" height=\"60\" topLeftX=\"28.111653543307114\" topLeftY=\"34.30535433070867\" type=\"text\" id=\"bwE\">\n        <content textType=\"headline\" paddingTop=\"3.6\" paddingBottom=\"3.6\" paddingLeft=\"7.2\" paddingRight=\"7.2\" fontSize=\"36\" fontFamily=\"Calibri\" color=\"rgba(0, 0, 0, 1)\" bold=\"true\" italic=\"false\" underline=\"false\" strikethrough=\"false\" lineSpacing=\"multiple:1.2\" textAlign=\"left\">\n          <p textAlign=\"left\" lineSpacing=\"multiple:1.2\" marginLeft=\"9.38\" indent=\"-9.38\"><strong><span color=\"rgba(0, 0, 0, 1)\" fontSize=\"36\" fontFamily=\"Calibri\" italic=\"false\" strikethrough=\"false\" underline=\"false\">信号</span></strong></p>\n        </content>\n      </shape>"}, {"action": "block_replace", "block_id": "bwV", "replacement": "<shape width=\"661.1249606299212\" height=\"215.87496062992125\" topLeftX=\"28.875039370078753\" topLeftY=\"96.12503937007875\" type=\"text\" id=\"bwV\">\n        <content verticalAlign=\"top\" paddingTop=\"3.6\" paddingBottom=\"3.6\" paddingLeft=\"7.2\" paddingRight=\"7.2\" fontSize=\"24\" fontFamily=\"Calibri\" color=\"rgba(0, 0, 0, 1)\" bold=\"true\" italic=\"false\" underline=\"false\" strikethrough=\"false\" lineSpacing=\"multiple:1.2\" textAlign=\"left\">\n          <ul>\n            <li>\n              <p textAlign=\"left\" lineSpacing=\"multiple:1.2\" beforeLineSpacing=\"multiple:0.20\" marginLeft=\"27\" indent=\"-27\" bulletColor=\"rgba(153, 0, 0, 1)\" bulletSize=\"60px\" bulletChar=\"¢\"><strong><span color=\"rgba(0, 0, 0, 1)\" fontSize=\"24\" fontFamily=\"Calibri\" italic=\"false\" strikethrough=\"false\" underline=\"false\">信号是一种小消息，用于通知进程系统中发生了某类事件</span></strong></p>\n            </li>\n          </ul>\n          <ul listStyle=\"pptx-square\">\n            <li>\n              <p textAlign=\"left\" lineSpacing=\"multiple:1.2\" beforeLineSpacing=\"multiple:0.20\" level=\"2\" marginLeft=\"58.5\" indent=\"-22.5\" bulletColor=\"rgba(153, 0, 0, 1)\" bulletSize=\"110px\"><span color=\"rgba(0, 0, 0, 1)\" fontSize=\"20\" fontFamily=\"Calibri\" bold=\"false\" italic=\"false\" strikethrough=\"false\" underline=\"false\">类似于异常和中断</span></p>\n            </li>\n            <li>\n              <p textAlign=\"left\" lineSpacing=\"multiple:1.2\" beforeLineSpacing=\"multiple:0.20\" level=\"2\" marginLeft=\"58.5\" indent=\"-22.5\" bulletColor=\"rgba(153, 0, 0, 1)\" bulletSize=\"110px\"><span color=\"rgba(0, 0, 0, 1)\" fontSize=\"20\" fontFamily=\"Calibri\" bold=\"false\" italic=\"false\" strikethrough=\"false\" underline=\"false\">由内核（有时应另一个进程的请求）发送给进程</span></p>\n            </li>\n            <li>\n              <p textAlign=\"left\" lineSpacing=\"multiple:1.2\" beforeLineSpacing=\"multiple:0.20\" level=\"2\" marginLeft=\"58.5\" indent=\"-22.5\" bulletColor=\"rgba(153, 0, 0, 1)\" bulletSize=\"110px\"><span color=\"rgba(0, 0, 0, 1)\" fontSize=\"20\" fontFamily=\"Calibri\" bold=\"false\" italic=\"false\" strikethrough=\"false\" underline=\"false\">信号类型由小整数 ID（1-30）标识</span></p>\n            </li>\n            <li>\n              <p textAlign=\"left\" lineSpacing=\"multiple:1.2\" beforeLineSpacing=\"multiple:0.20\" level=\"2\" marginLeft=\"58.5\" indent=\"-22.5\" bulletColor=\"rgba(153, 0, 0, 1)\" bulletSize=\"110px\"><span color=\"rgba(0, 0, 0, 1)\" fontSize=\"20\" fontFamily=\"Calibri\" bold=\"false\" italic=\"false\" strikethrough=\"false\" underline=\"false\">信号中仅包含其 ID 和“已到达”这一事实</span></p>\n            </li>\n          </ul>\n        </content>\n      </shape>"}]