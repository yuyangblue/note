[{"action": "block_replace", "block_id": "bIO", "replacement": "<shape width=\"597.8025984251968\" height=\"60\" topLeftX=\"21.9623622047244\" topLeftY=\"34.30535433070867\" type=\"text\" id=\"bIO\">\n        <content textType=\"headline\" paddingTop=\"3.6\" paddingBottom=\"3.6\" paddingLeft=\"7.2\" paddingRight=\"7.2\" fontSize=\"36\" fontFamily=\"Calibri\" color=\"rgba(0, 0, 0, 1)\" bold=\"true\" italic=\"false\" underline=\"false\" strikethrough=\"false\" lineSpacing=\"multiple:1.2\" textAlign=\"left\">\n          <p textAlign=\"left\" lineSpacing=\"multiple:1.2\" marginLeft=\"9.38\" indent=\"-9.38\"><strong><span color=\"rgba(0, 0, 0, 1)\" fontSize=\"36\" fontFamily=\"Calibri\" italic=\"false\" strikethrough=\"false\" underline=\"false\">安装信号处理程序</span></strong></p>\n        </content>\n      </shape>"}, {"action": "block_replace", "block_id": "bIR", "replacement": "<shape width=\"685.1249606299212\" height=\"411.37496062992125\" topLeftX=\"22.875039370078753\" topLeftY=\"96.12503937007875\" type=\"text\" id=\"bIR\">\n        <content verticalAlign=\"top\" paddingTop=\"3.6\" paddingBottom=\"3.6\" paddingLeft=\"7.2\" paddingRight=\"7.2\" fontSize=\"24\" fontFamily=\"Calibri\" color=\"rgba(0, 0, 0, 1)\" bold=\"true\" italic=\"false\" underline=\"false\" strikethrough=\"false\" lineSpacing=\"multiple:1.2\" textAlign=\"left\">\n          <ul>\n            <li>\n              <p textAlign=\"left\" lineSpacing=\"multiple:1.2\" beforeLineSpacing=\"multiple:0.20\" marginLeft=\"27\" indent=\"-27\" bulletColor=\"rgba(153, 0, 0, 1)\" bulletSize=\"60px\" bulletChar=\"¢\"><strong><span color=\"rgba(0, 0, 0, 1)\" fontSize=\"24\" fontFamily=\"Calibri\" italic=\"false\" strikethrough=\"false\" underline=\"false\">signal 函数修改接收信号 signum 时的默认动作：</span></strong></p>\n            </li>\n          </ul>\n          <ul listStyle=\"pptx-square\">\n            <li>\n              <p textAlign=\"left\" lineSpacing=\"multiple:1.2\" beforeLineSpacing=\"multiple:0.20\" level=\"2\" marginLeft=\"58.5\" indent=\"-22.5\" bulletColor=\"rgba(153, 0, 0, 1)\" bulletSize=\"110px\"><strong><span color=\"rgba(0, 0, 0, 1)\" fontSize=\"20\" fontFamily=\"Courier New\" italic=\"false\" strikethrough=\"false\" underline=\"false\">handler_t *signal(int signum, handler_t *handler)</span></strong></p>\n            </li>\n          </ul>\n          <p textAlign=\"left\" lineSpacing=\"multiple:1.2\" beforeLineSpacing=\"multiple:0.20\" marginLeft=\"27\" indent=\"-27\"></p>\n          <ul>\n            <li>\n              <p textAlign=\"left\" lineSpacing=\"multiple:1.2\" beforeLineSpacing=\"multiple:0.20\" marginLeft=\"27\" indent=\"-27\" bulletColor=\"rgba(153, 0, 0, 1)\" bulletSize=\"60px\" bulletChar=\"¢\"><strong><span color=\"rgba(0, 0, 0, 1)\" fontSize=\"24\" fontFamily=\"Calibri\" italic=\"false\" strikethrough=\"false\" underline=\"false\">handler 的不同取值：</span></strong></p>\n            </li>\n          </ul>\n          <ul listStyle=\"pptx-square\">\n            <li>\n              <p textAlign=\"left\" lineSpacing=\"multiple:1.2\" beforeLineSpacing=\"multiple:0.20\" level=\"2\" marginLeft=\"58.5\" indent=\"-22.5\" bulletColor=\"rgba(153, 0, 0, 1)\" bulletSize=\"110px\"><span color=\"rgba(0, 0, 0, 1)\" fontSize=\"20\" fontFamily=\"Calibri\" bold=\"false\" italic=\"false\" strikethrough=\"false\" underline=\"false\">SIG_IGN：忽略类型为 signum 的信号</span></p>\n            </li>\n            <li>\n              <p textAlign=\"left\" lineSpacing=\"multiple:1.2\" beforeLineSpacing=\"multiple:0.20\" level=\"2\" marginLeft=\"58.5\" indent=\"-22.5\" bulletColor=\"rgba(153, 0, 0, 1)\" bulletSize=\"110px\"><span color=\"rgba(0, 0, 0, 1)\" fontSize=\"20\" fontFamily=\"Calibri\" bold=\"false\" italic=\"false\" strikethrough=\"false\" underline=\"false\">SIG_DFL：收到类型为 signum 的信号时恢复默认动作</span></p>\n            </li>\n            <li>\n              <p textAlign=\"left\" lineSpacing=\"multiple:1.2\" beforeLineSpacing=\"multiple:0.20\" level=\"2\" marginLeft=\"58.5\" indent=\"-22.5\" bulletColor=\"rgba(153, 0, 0, 1)\" bulletSize=\"110px\"><span color=\"rgba(0, 0, 0, 1)\" fontSize=\"20\" fontFamily=\"Calibri\" bold=\"false\" italic=\"false\" strikethrough=\"false\" underline=\"false\">否则，handler 是用户级信号处理程序的地址</span></p>\n            </li>\n            <li>\n              <p textAlign=\"left\" lineSpacing=\"multiple:1.2\" beforeLineSpacing=\"multiple:0.20\" level=\"3\" marginLeft=\"90\" indent=\"-18\" bulletSize=\"80px\"><span color=\"rgba(0, 0, 0, 1)\" fontSize=\"20\" fontFamily=\"Calibri\" bold=\"false\" italic=\"false\" strikethrough=\"false\" underline=\"false\">进程收到类型为 signum 的信号时被调用</span></p>\n            </li>\n            <li>\n              <p textAlign=\"left\" lineSpacing=\"multiple:1.2\" beforeLineSpacing=\"multiple:0.20\" level=\"3\" marginLeft=\"90\" indent=\"-18\" bulletSize=\"80px\"><span color=\"rgba(0, 0, 0, 1)\" fontSize=\"20\" fontFamily=\"Calibri\" bold=\"false\" italic=\"false\" strikethrough=\"false\" underline=\"false\">这被称为“安装”处理程序</span></p>\n            </li>\n            <li>\n              <p textAlign=\"left\" lineSpacing=\"multiple:1.2\" beforeLineSpacing=\"multiple:0.20\" level=\"3\" marginLeft=\"90\" indent=\"-18\" bulletSize=\"80px\"><span color=\"rgba(0, 0, 0, 1)\" fontSize=\"20\" fontFamily=\"Calibri\" bold=\"false\" italic=\"false\" strikethrough=\"false\" underline=\"false\">执行处理程序称为“捕获”或“处理”信号</span></p>\n            </li>\n            <li>\n              <p textAlign=\"left\" lineSpacing=\"multiple:1.2\" beforeLineSpacing=\"multiple:0.20\" level=\"3\" marginLeft=\"90\" indent=\"-18\" bulletSize=\"80px\"><span color=\"rgba(0, 0, 0, 1)\" fontSize=\"20\" fontFamily=\"Calibri\" bold=\"false\" italic=\"false\" strikethrough=\"false\" underline=\"false\">当处理程序执行其 return 语句时，控制权交回被信号接收所中断的进程控制流中的那条指令</span></p>\n            </li>\n          </ul>\n        </content>\n      </shape>"}]