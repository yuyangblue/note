[{"action": "block_replace", "block_id": "bwR", "replacement": "<shape width=\"597.8025984251968\" height=\"60\" topLeftX=\"28.111653543307114\" topLeftY=\"34.30535433070867\" type=\"text\" id=\"bwR\">\n        <content textType=\"headline\" paddingTop=\"3.6\" paddingBottom=\"3.6\" paddingLeft=\"7.2\" paddingRight=\"7.2\" fontSize=\"36\" fontFamily=\"Calibri\" color=\"rgba(0, 0, 0, 1)\" bold=\"true\" italic=\"false\" underline=\"false\" strikethrough=\"false\" lineSpacing=\"multiple:1.2\" textAlign=\"left\">\n          <p textAlign=\"left\" lineSpacing=\"multiple:1.2\" marginLeft=\"9.38\" indent=\"-9.38\"><strong><span color=\"rgba(0, 0, 0, 1)\" fontSize=\"36\" fontFamily=\"Calibri\" italic=\"false\" strikethrough=\"false\" underline=\"false\">信号概念：发送信号</span></strong></p>\n        </content>\n      </shape>"}, {"action": "block_replace", "block_id": "bwb", "replacement": "<shape width=\"673.1249606299212\" height=\"369.37496062992125\" topLeftX=\"28.875039370078753\" topLeftY=\"104.62503937007875\" type=\"text\" id=\"bwb\">\n        <content verticalAlign=\"top\" paddingTop=\"3.6\" paddingBottom=\"3.6\" paddingLeft=\"7.2\" paddingRight=\"7.2\" fontSize=\"24\" fontFamily=\"Calibri\" color=\"rgba(0, 0, 0, 1)\" bold=\"true\" italic=\"false\" underline=\"false\" strikethrough=\"false\" lineSpacing=\"multiple:1.2\" textAlign=\"left\">\n          <ul>\n            <li>\n              <p textAlign=\"left\" lineSpacing=\"multiple:1.2\" beforeLineSpacing=\"multiple:0.20\" marginLeft=\"27\" indent=\"-27\" bulletColor=\"rgba(153, 0, 0, 1)\" bulletSize=\"60px\" bulletChar=\"¢\"><strong><span color=\"rgba(0, 0, 0, 1)\" fontSize=\"24\" fontFamily=\"Calibri\" italic=\"false\" strikethrough=\"false\" underline=\"false\">内核通过更新目标进程上下文中的某些状态，向目标进程发送（递送）信号</span></strong></p>\n            </li>\n          </ul>\n          <p textAlign=\"left\" lineSpacing=\"multiple:1.2\" beforeLineSpacing=\"multiple:0.20\" marginLeft=\"27\" indent=\"-27\"></p>\n          <ul>\n            <li>\n              <p textAlign=\"left\" lineSpacing=\"multiple:1.2\" beforeLineSpacing=\"multiple:0.20\" marginLeft=\"27\" indent=\"-27\" bulletColor=\"rgba(153, 0, 0, 1)\" bulletSize=\"60px\" bulletChar=\"¢\"><strong><span color=\"rgba(0, 0, 0, 1)\" fontSize=\"24\" fontFamily=\"Calibri\" italic=\"false\" strikethrough=\"false\" underline=\"false\">内核因以下原因之一发送信号：</span></strong></p>\n            </li>\n          </ul>\n          <ul listStyle=\"pptx-square\">\n            <li>\n              <p textAlign=\"left\" lineSpacing=\"multiple:1.2\" beforeLineSpacing=\"multiple:0.20\" level=\"2\" marginLeft=\"58.5\" indent=\"-22.5\" bulletColor=\"rgba(153, 0, 0, 1)\" bulletSize=\"110px\"><span color=\"rgba(0, 0, 0, 1)\" fontSize=\"20\" fontFamily=\"Calibri\" bold=\"false\" italic=\"false\" strikethrough=\"false\" underline=\"false\">内核检测到系统事件，如除零（SIGFPE）或子进程终止（SIGCHLD）</span></p>\n            </li>\n            <li>\n              <p textAlign=\"left\" lineSpacing=\"multiple:1.2\" beforeLineSpacing=\"multiple:0.20\" level=\"2\" marginLeft=\"58.5\" indent=\"-22.5\" bulletColor=\"rgba(153, 0, 0, 1)\" bulletSize=\"110px\"><span color=\"rgba(0, 0, 0, 1)\" fontSize=\"20\" fontFamily=\"Calibri\" bold=\"false\" italic=\"false\" strikethrough=\"false\" underline=\"false\">另一进程调用了 kill 系统调用，显式请求内核向目标进程发送信号</span></p>\n            </li>\n          </ul>\n          <p textAlign=\"left\" lineSpacing=\"multiple:1.2\" beforeLineSpacing=\"multiple:0.20\" level=\"4\" marginLeft=\"126\" indent=\"-18\"><span color=\"rgba(0, 0, 0, 1)\" fontSize=\"20\" fontFamily=\"Calibri\" bold=\"false\" italic=\"false\" strikethrough=\"false\" underline=\"false\"> </span></p>\n        </content>\n      </shape>"}]