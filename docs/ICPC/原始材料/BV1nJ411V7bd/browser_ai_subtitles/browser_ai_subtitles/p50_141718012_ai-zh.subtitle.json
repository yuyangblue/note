  "body": [
    {
      "from": 2.18,
      "to": 3.05,
      "sid": 1,
      "location": 2,
      "content": "同学们好"
    },
    {
      "from": 3.05,
      "to": 6.77,
      "sid": 2,
      "location": 2,
      "content": "上一小节我们学习了栈的定义和特点"
    },
    {
      "from": 6.77,
      "to": 11.44,
      "sid": 3,
      "location": 2,
      "content": "那么这一小节呢我们再来学习一下队列的定义和特点"
    },
    {
      "from": 11.879,
      "to": 15.57,
      "sid": 4,
      "location": 2,
      "content": "那么队列呢它也是一种线性表"
    },
    {
      "from": 15.57,
      "to": 15.93,
      "sid": 5,
      "location": 2,
      "content": "嗯"
    },
    {
      "from": 15.93,
      "to": 19.83,
      "sid": 6,
      "location": 2,
      "content": "我们也是限定了它的插入和删除位置"
    },
    {
      "from": 19.83,
      "to": 22.02,
      "sid": 7,
      "location": 2,
      "content": "那么它在插入的时候呢"
    },
    {
      "from": 22.02,
      "to": 25.74,
      "sid": 8,
      "location": 2,
      "content": "我们规定它只能在表尾这一段嗯"
    },
    {
      "from": 25.74,
      "to": 27.56,
      "sid": 9,
      "location": 2,
      "content": "表尾这一端来插入"
    },
    {
      "from": 27.56,
      "to": 29.36,
      "sid": 10,
      "location": 2,
      "content": "那么它删除的时候呢"
    },
    {
      "from": 29.36,
      "to": 32.99,
      "sid": 11,
      "location": 2,
      "content": "我们规定它只能在表头这一段来插入"
    },
    {
      "from": 32.99,
      "to": 38.79,
      "sid": 12,
      "location": 2,
      "content": "嗯也就是说要插入呢我们只能在尾部来进行"
    },
    {
      "from": 38.79,
      "to": 43.31,
      "sid": 13,
      "location": 2,
      "content": "要删除呢我们只能在头部来进行嗯"
    },
    {
      "from": 43.31,
      "to": 46.04,
      "sid": 14,
      "location": 2,
      "content": "诶那么这就很像咱们的排队"
    },
    {
      "from": 46.04,
      "to": 46.43,
      "sid": 15,
      "location": 2,
      "content": "嗯"
    },
    {
      "from": 46.43,
      "to": 47.69,
      "sid": 16,
      "location": 2,
      "content": "就很像咱们的排队"
    },
    {
      "from": 47.69,
      "to": 50.99,
      "sid": 17,
      "location": 2,
      "content": "所以呢我们就把这种结构称作队列嗯"
    },
    {
      "from": 50.99,
      "to": 51.93,
      "sid": 18,
      "location": 2,
      "content": "称作队列"
    },
    {
      "from": 51.93,
      "to": 55.47,
      "sid": 19,
      "location": 2,
      "content": "那么队列呢就是一种先进先出"
    },
    {
      "from": 55.47,
      "to": 57.63,
      "sid": 20,
      "location": 2,
      "content": "first in first out"
    },
    {
      "from": 57.63,
      "to": 58.21,
      "sid": 21,
      "location": 2,
      "content": "嗯"
    },
    {
      "from": 58.21,
      "to": 60.4,
      "sid": 22,
      "location": 2,
      "content": "先来的先排上队伍的"
    },
    {
      "from": 60.4,
      "to": 61.81,
      "sid": 23,
      "location": 2,
      "content": "我们就先进来的"
    },
    {
      "from": 61.81,
      "to": 63.55,
      "sid": 24,
      "location": 2,
      "content": "我们就先解决它嗯"
    },
    {
      "from": 63.55,
      "to": 64.699,
      "sid": 25,
      "location": 2,
      "content": "先删除掉"
    },
    {
      "from": 64.699,
      "to": 67.129,
      "sid": 26,
      "location": 2,
      "content": "而后来的就在后面排队嗯"
    },
    {
      "from": 67.129,
      "to": 72.14,
      "sid": 27,
      "location": 2,
      "content": "或者诶所以把这一种结构呢就叫做嗯faithful"
    },
    {
      "from": 72.14,
      "to": 72.8,
      "sid": 28,
      "location": 2,
      "content": "faithful"
    },
    {
      "from": 72.8,
      "to": 73.49,
      "sid": 29,
      "location": 2,
      "content": "first thing"
    },
    {
      "from": 73.49,
      "to": 75.5,
      "sid": 30,
      "location": 2,
      "content": "first first out"
    },
    {
      "from": 75.5,
      "to": 76.07,
      "sid": 31,
      "location": 2,
      "content": "好"
    },
    {
      "from": 76.07,
      "to": 78.32,
      "sid": 32,
      "location": 2,
      "content": "那么这个队列我们怎么表示呢"
    },
    {
      "from": 78.32,
      "to": 81.44,
      "sid": 33,
      "location": 2,
      "content": "我们通常用字母q来表示啊"
    },
    {
      "from": 81.44,
      "to": 82.51,
      "sid": 34,
      "location": 2,
      "content": "字母q哎"
    },
    {
      "from": 82.51,
      "to": 84.97,
      "sid": 35,
      "location": 2,
      "content": "队列呢英文单词就是这个q"
    },
    {
      "from": 84.97,
      "to": 87.949,
      "sid": 36,
      "location": 2,
      "content": "所以呢我们用字母q来表示一个队列嗯"
    },
    {
      "from": 87.949,
      "to": 91.789,
      "sid": 37,
      "location": 2,
      "content": "有队列当中有a一到a an n个元素嗯"
    },
    {
      "from": 91.789,
      "to": 98.75,
      "sid": 38,
      "location": 2,
      "content": "那么这n个元素呢我们依次存储在嗯咱们的这个数组当中啊"
    },
    {
      "from": 98.75,
      "to": 100.49,
      "sid": 39,
      "location": 2,
      "content": "依次存储在数组当中"
    },
    {
      "from": 100.49,
      "to": 106.34,
      "sid": 40,
      "location": 2,
      "content": "那我们在这个呃在这个数组当中加入一个新元素呢"
    },
    {
      "from": 106.34,
      "to": 109.22,
      "sid": 41,
      "location": 2,
      "content": "就只能加入在这个对尾嗯"
    },
    {
      "from": 109.22,
      "to": 111.34,
      "sid": 42,
      "location": 2,
      "content": "这个最后一个元素嗯"
    },
    {
      "from": 111.34,
      "to": 114.78,
      "sid": 43,
      "location": 2,
      "content": "最后一个元素这个表尾我们就称作对尾嗯"
    },
    {
      "from": 114.78,
      "to": 117.81,
      "sid": 44,
      "location": 2,
      "content": "我们加入的时候就只能从这边来加入"
    },
    {
      "from": 117.81,
      "to": 119.46,
      "sid": 45,
      "location": 2,
      "content": "那么删除的时候呢"
    },
    {
      "from": 119.46,
      "to": 121.98,
      "sid": 46,
      "location": 2,
      "content": "我们就只能在这一头嗯"
    },
    {
      "from": 121.98,
      "to": 126.16,
      "sid": 47,
      "location": 2,
      "content": "这一头我们这个表头呢就称作对头啊"
    },
    {
      "from": 126.16,
      "to": 127.37,
      "sid": 48,
      "location": 2,
      "content": "对头诶"
    },
    {
      "from": 127.37,
      "to": 128.9,
      "sid": 49,
      "location": 2,
      "content": "这边呢是对尾"
    },
    {
      "from": 128.9,
      "to": 130.04,
      "sid": 50,
      "location": 2,
      "content": "这边是队尾"
    },
    {
      "from": 130.04,
      "to": 133.31,
      "sid": 51,
      "location": 2,
      "content": "我们插入的时候只能插入在队尾啊"
    },
    {
      "from": 133.31,
      "to": 134.38,
      "sid": 52,
      "location": 2,
      "content": "就像排队一样"
    },
    {
      "from": 134.38,
      "to": 137.83,
      "sid": 53,
      "location": 2,
      "content": "你排队你只能排在一个队伍的尾上嗯"
    },
    {
      "from": 137.83,
      "to": 140.62,
      "sid": 54,
      "location": 2,
      "content": "你不能来的时候插入插插队"
    },
    {
      "from": 140.62,
      "to": 141.55,
      "sid": 55,
      "location": 2,
      "content": "是不是啊"
    },
    {
      "from": 141.55,
      "to": 143.92,
      "sid": 56,
      "location": 2,
      "content": "唉只能插入在对位诶"
    },
    {
      "from": 143.92,
      "to": 145.48,
      "sid": 57,
      "location": 2,
      "content": "那我们说要删除的话"
    },
    {
      "from": 145.48,
      "to": 148.269,
      "sid": 58,
      "location": 2,
      "content": "嗯我们这个要离开的话"
    },
    {
      "from": 148.269,
      "to": 150.189,
      "sid": 59,
      "location": 2,
      "content": "我们是从对头离开的"
    },
    {
      "from": 150.189,
      "to": 152.469,
      "sid": 60,
      "location": 2,
      "content": "嗯删除的时候从对头离开"
    },
    {
      "from": 152.469,
      "to": 156.4,
      "sid": 61,
      "location": 2,
      "content": "这就是咱们这个队列的特点嗯"
    },
    {
      "from": 156.4,
      "to": 160.03,
      "sid": 62,
      "location": 2,
      "content": "他的入队出队有这样的一个顺序"
    },
    {
      "from": 160.03,
      "to": 161.68,
      "sid": 63,
      "location": 2,
      "content": "嗯这样的一个顺序好"
    },
    {
      "from": 161.68,
      "to": 164.35,
      "sid": 64,
      "location": 2,
      "content": "那咱们来看一下队列的相关概念"
    },
    {
      "from": 164.35,
      "to": 165.73,
      "sid": 65,
      "location": 2,
      "content": "那什么是队列啊"
    },
    {
      "from": 165.73,
      "to": 167.98,
      "sid": 66,
      "location": 2,
      "content": "嗯它还是线性表嗯"
    },
    {
      "from": 167.98,
      "to": 170.18,
      "sid": 67,
      "location": 2,
      "content": "操作受限的线性表"
    },
    {
      "from": 170.18,
      "to": 173.94,
      "sid": 68,
      "location": 2,
      "content": "我们规定它只能在表的一端进行插入"
    },
    {
      "from": 173.94,
      "to": 177.12,
      "sid": 69,
      "location": 2,
      "content": "在表的另外一端嗯进行删除"
    },
    {
      "from": 177.12,
      "to": 179.7,
      "sid": 70,
      "location": 2,
      "content": "而通常称作头山尾"
    },
    {
      "from": 179.7,
      "to": 183.0,
      "sid": 71,
      "location": 2,
      "content": "插头部呢删除尾部插入嗯"
    },
    {
      "from": 183.0,
      "to": 184.69,
      "sid": 72,
      "location": 2,
      "content": "头山尾差好"
    },
    {
      "from": 184.69,
      "to": 187.42,
      "sid": 73,
      "location": 2,
      "content": "那么它的逻辑结构呢和线性结构是一样的"
    },
    {
      "from": 187.42,
      "to": 190.29,
      "sid": 74,
      "location": 2,
      "content": "仍然是嗯和这个线性表一样"
    },
    {
      "from": 190.29,
      "to": 191.61,
      "sid": 75,
      "location": 2,
      "content": "仍然是线性结构"
    },
    {
      "from": 191.61,
      "to": 194.14,
      "sid": 76,
      "location": 2,
      "content": "元素之间的关系是一对一的"
    },
    {
      "from": 194.14,
      "to": 196.42,
      "sid": 77,
      "location": 2,
      "content": "它的存储结构呢也是这样嗯"
    },
    {
      "from": 196.42,
      "to": 198.41,
      "sid": 78,
      "location": 2,
      "content": "我们可以用顺序存储法"
    },
    {
      "from": 198.41,
      "to": 202.19,
      "sid": 79,
      "location": 2,
      "content": "顺序存储法存储的队列就叫做顺序对"
    },
    {
      "from": 202.19,
      "to": 202.61,
      "sid": 80,
      "location": 2,
      "content": "嗯"
    },
    {
      "from": 202.61,
      "to": 204.14,
      "sid": 81,
      "location": 2,
      "content": "也可以用链式存储法"
    },
    {
      "from": 204.14,
      "to": 208.09,
      "sid": 82,
      "location": 2,
      "content": "那么链式存储法存储的队列呢就叫做练对"
    },
    {
      "from": 208.09,
      "to": 211.72,
      "sid": 83,
      "location": 2,
      "content": "那么其中这个顺序存储的队列呢更常见"
    },
    {
      "from": 211.72,
      "to": 214.46,
      "sid": 84,
      "location": 2,
      "content": "而且呢我们是用的循环嗯"
    },
    {
      "from": 214.46,
      "to": 217.36,
      "sid": 85,
      "location": 2,
      "content": "循环循环顺序队列哎"
    },
    {
      "from": 217.36,
      "to": 220.06,
      "sid": 86,
      "location": 2,
      "content": "具体时候顺序队列怎么表示的"
    },
    {
      "from": 220.06,
      "to": 222.769,
      "sid": 87,
      "location": 2,
      "content": "咱们后面再详细的来介绍嗯"
    },
    {
      "from": 222.769,
      "to": 226.6,
      "sid": 88,
      "location": 2,
      "content": "好那么这个队列的运算规则咱们说了嗯"
    },
    {
      "from": 226.6,
      "to": 229.03,
      "sid": 89,
      "location": 2,
      "content": "只能在对手来删除"
    },
    {
      "from": 229.03,
      "to": 230.77,
      "sid": 90,
      "location": 2,
      "content": "在队尾来插入"
    },
    {
      "from": 230.77,
      "to": 232.63,
      "sid": 91,
      "location": 2,
      "content": "所以访问节点的时候呢"
    },
    {
      "from": 232.63,
      "to": 235.22,
      "sid": 92,
      "location": 2,
      "content": "必须按照先进先出"
    },
    {
      "from": 235.22,
      "to": 238.52,
      "sid": 93,
      "location": 2,
      "content": "我们是不能随意访问某一个节点嗯"
    },
    {
      "from": 238.52,
      "to": 242.4,
      "sid": 94,
      "location": 2,
      "content": "只能按照先进先出的这个原则来访问"
    },
    {
      "from": 243.52,
      "to": 247.91,
      "sid": 95,
      "location": 2,
      "content": "那么它的操作呢也主要是嗯插入和删除"
    },
    {
      "from": 247.91,
      "to": 250.83,
      "sid": 96,
      "location": 2,
      "content": "其中插入操作呢就叫做入对嗯"
    },
    {
      "from": 250.83,
      "to": 252.93,
      "sid": 97,
      "location": 2,
      "content": "删除操作呢就叫做初对"
    },
    {
      "from": 252.93,
      "to": 254.7,
      "sid": 98,
      "location": 2,
      "content": "那么具体怎么实现呢"
    },
    {
      "from": 254.7,
      "to": 259.81,
      "sid": 99,
      "location": 2,
      "content": "还是后面我们要看具体采用什么样的数据结构啊"
    },
    {
      "from": 259.81,
      "to": 261.7,
      "sid": 100,
      "location": 2,
      "content": "什么样的存储结构诶"
    },
    {
      "from": 261.7,
      "to": 265.98,
      "sid": 101,
      "location": 2,
      "content": "我们分别来实现顺序对和面对上的操作"
    },
    {
      "from": 265.98,
      "to": 266.58,
      "sid": 102,
      "location": 2,
      "content": "好的"
    },
    {
      "from": 266.58,
      "to": 270.72,
      "sid": 103,
      "location": 2,
      "content": "那么这一小节呢关于队列的定义和特点"
    },
    {
      "from": 270.72,
      "to": 272.64,
      "sid": 104,
      "location": 2,
      "content": "咱们就介绍到这里嗯"
    },
    {
      "from": 272.64,
      "to": 273.56,
      "sid": 105,
      "location": 2,
      "content": "就介绍到这里"
    }
  ]
