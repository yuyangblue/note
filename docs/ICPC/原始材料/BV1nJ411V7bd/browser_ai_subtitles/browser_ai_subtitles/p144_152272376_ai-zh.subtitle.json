      "sid": 96,
      "location": 2,
      "content": "左子树上呢都小于根节点嗯"
    },
    {
      "from": 274.41,
      "to": 275.37,
      "sid": 97,
      "location": 2,
      "content": "小于根节点"
    },
    {
      "from": 275.37,
      "to": 276.85,
      "sid": 98,
      "location": 2,
      "content": "以此类推"
    },
    {
      "from": 276.85,
