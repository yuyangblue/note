    {
      "from": 152.399,
      "to": 154.409,
      "sid": 56,
      "location": 2,
      "content": "什么是二叉排序树呢"
    },
    {
      "from": 154.409,
      "to": 158.459,
      "sid": 57,
      "location": 2,
      "content": "它也被称为二叉搜索树或者是二叉查找树"
    },
    {
      "from": 158.459,
      "to": 160.109,
      "sid": 58,
      "location": 2,
      "content": "那么它是这样的数嗯"
    },
    {
      "from": 160.109,
      "to": 161.91,
      "sid": 59,
      "location": 2,
      "content": "可以是空数嗯"
    },
    {
      "from": 161.91,
      "to": 163.29,
      "sid": 60,
      "location": 2,
      "content": "如果不是空树的话"
    },
    {
      "from": 163.29,
      "to": 166.05,
      "sid": 61,
      "location": 2,
      "content": "必须满足下面的性质"
    },
    {
      "from": 166.05,
      "to": 168.72,
      "sid": 62,
      "location": 2,
      "content": "第一条性质呢说左子树"
    },
    {
      "from": 168.72,
      "to": 170.43,
      "sid": 63,
      "location": 2,
      "content": "左子树如果不为空"
    },
    {
      "from": 170.43,
      "to": 175.77,
      "sid": 64,
      "location": 2,
      "content": "那么左子树上所有的节点的值必须小于根节点嗯"
    },
    {
      "from": 175.77,
      "to": 177.69,
      "sid": 65,
      "location": 2,
      "content": "第二条呢是说右子数"
    },
    {
      "from": 177.69,
      "to": 179.79,
      "sid": 66,
      "location": 2,
      "content": "柚子数如果不为空的话"
    },
    {
      "from": 179.79,
      "to": 185.55,
      "sid": 67,
      "location": 2,
      "content": "右子树上所有节点的值要大于等于根节点嗯"
    },
    {
      "from": 185.55,
      "to": 191.25,
      "sid": 68,
      "location": 2,
      "content": "大于等于根节点左子树上不包括等于嗯嗯柚子树上包括等于"
