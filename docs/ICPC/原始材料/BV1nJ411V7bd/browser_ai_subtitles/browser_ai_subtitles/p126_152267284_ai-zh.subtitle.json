      "from": 28.55,
      "to": 31.189,
      "sid": 8,
      "location": 2,
      "content": "我们了解一下什么是最小生成树"
    },
    {
      "from": 31.189,
      "to": 33.259,
      "sid": 9,
      "location": 2,
      "content": "这个是最小生成树有什么用"
    },
    {
      "from": 33.259,
      "to": 37.57,
      "sid": 10,
      "location": 2,
      "content": "然后我们怎么构造它嗯为了了解这个最小生成树啊"
    },
    {
      "from": 37.57,
      "to": 41.4,
      "sid": 11,
      "location": 2,
      "content": "咱们先来回顾一下关于生成数的概念"
    },
    {
      "from": 41.4,
      "to": 43.29,
      "sid": 12,
      "location": 2,
      "content": "什么是生成数来着"
