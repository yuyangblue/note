      "sid": 25,
      "location": 2,
      "content": "诶"
    },
    {
      "from": 77.32,
      "to": 80.99,
      "sid": 26,
      "location": 2,
      "content": "这部分边嗯既不能多也不能少"
    },
    {
      "from": 80.99,
      "to": 81.77,
      "sid": 27,
      "location": 2,
      "content": "为什么呢"
    },
    {
      "from": 81.77,
      "to": 84.05,
      "sid": 28,
      "location": 2,
      "content": "我说少了少了以后呢"
    },
    {
      "from": 84.05,
      "to": 87.199,
      "sid": 29,
      "location": 2,
      "content": "这些顶点就不能连接在一起了"
    },
    {
      "from": 87.199,
      "to": 89.179,
      "sid": 30,
      "location": 2,
      "content": "它还必须得是联通的"
    },
    {
      "from": 89.179,
      "to": 90.99,
      "sid": 31,
      "location": 2,
      "content": "这是生成树的特点嗯"
    },
    {
      "from": 90.99,
      "to": 92.46,
      "sid": 32,
      "location": 2,
      "content": "它必须得是连通的"
    },
    {
      "from": 92.46,
      "to": 93.96,
