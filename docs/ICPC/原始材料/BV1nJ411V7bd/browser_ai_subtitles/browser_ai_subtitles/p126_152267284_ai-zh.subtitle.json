      "from": 8.76,
      "to": 14.38,
      "sid": 3,
      "location": 2,
      "content": "接下来呢咱们重点来学习第六节图的应用图啊"
    },
    {
      "from": 14.38,
      "to": 17.14,
      "sid": 4,
