      "to": 678.9,
      "sid": 247,
      "location": 2,
      "content": "嗯这两串才是相等的"
    },
    {
      "from": 679.02,
      "to": 682.29,
      "sid": 248,
      "location": 2,
      "content": "比如说咱们看到的下面这两个串是不等呢"
    },
    {
      "from": 682.29,
      "to": 683.839,
      "sid": 249,
      "location": 2,
      "content": "呃为什么不等呢"
    },
    {
      "from": 683.839,
      "to": 687.859,
      "sid": 250,
      "location": 2,
      "content": "嗯原因是因为嗯首先呢长度不一样"
    },
    {
      "from": 687.859,
      "to": 689.119,
      "sid": 251,
      "location": 2,
      "content": "嗯长度不一样"
    },
    {
      "from": 689.119,
      "to": 690.499,
      "sid": 252,
      "location": 2,
      "content": "这是几个字符呢"
    },
    {
      "from": 690.499,
      "to": 691.639,
      "sid": 253,
      "location": 2,
      "content": "这是四个字符"
    },
    {
      "from": 691.639,
      "to": 692.989,
      "sid": 254,
      "location": 2,
      "content": "这是三个字符"
    },
    {
      "from": 692.989,
      "to": 694.39,
      "sid": 255,
      "location": 2,
      "content": "所以它们两个不等"
    },
    {
      "from": 694.39,
      "to": 696.64,
      "sid": 256,
      "location": 2,
      "content": "哎同理这是四个字符"
    },
    {
      "from": 696.64,
      "to": 698.17,
      "sid": 257,
      "location": 2,
      "content": "这是五个字符"
    },
    {
      "from": 698.17,
      "to": 701.17,
      "sid": 258,
      "location": 2,
      "content": "哎这两个字符串也不相等啊"
    },
    {
      "from": 701.17,
      "to": 703.39,
      "sid": 259,
      "location": 2,
      "content": "那么说字符串长度相等了"
    },
    {
      "from": 703.39,
      "to": 705.439,
      "sid": 260,
      "location": 2,
      "content": "比如说a b c嗯"
    },
    {
      "from": 705.439,
      "to": 713.16,
      "sid": 261,
      "location": 2,
      "content": "a b c和这个bbc嗯长度相等了"
    },
    {
      "from": 713.26,
      "to": 716.53,
      "sid": 262,
      "location": 2,
      "content": "但是呢这个字符不一样啊"
    },
    {
      "from": 716.53,
      "to": 717.46,
      "sid": 263,
      "location": 2,
      "content": "字符不一样"
    },
    {
      "from": 717.46,
      "to": 720.49,
      "sid": 264,
      "location": 2,
      "content": "那我们说他们两个也不相等啊"
    },
    {
      "from": 720.49,
      "to": 721.38,
      "sid": 265,
      "location": 2,
      "content": "也不相等"
    },
    {
      "from": 721.38,
      "to": 724.56,
      "sid": 266,
      "location": 2,
      "content": "好这是咱们说串儿相等的概念是什么"
    },
    {
      "from": 724.56,
      "to": 727.56,
      "sid": 267,
      "location": 2,
      "content": "嗯那么另外呢同学们需要知道的是"
    },
    {
      "from": 727.56,
      "to": 730.99,
      "sid": 268,
      "location": 2,
      "content": "所有的空串都是相等的嗯"
    },
    {
      "from": 730.99,
      "to": 732.16,
      "sid": 269,
      "location": 2,
      "content": "空这都是相等的"
    },
    {
      "from": 732.16,
      "to": 733.21,
      "sid": 270,
      "location": 2,
      "content": "长度都为零"
    },
    {
      "from": 733.21,
      "to": 736.63,
      "sid": 271,
      "location": 2,
      "content": "然后呢呃包含的字符都是空嗯"
    },
    {
      "from": 736.63,
      "to": 737.42,
      "sid": 272,
      "location": 2,
      "content": "都是浮空"
    },
    {
      "from": 737.42,
      "to": 739.93,
      "sid": 273,
      "location": 2,
      "content": "所以所有的空串是相等的"
    },
    {
      "from": 739.93,
      "to": 740.59,
      "sid": 274,
      "location": 2,
      "content": "好嘞"
    },
    {
      "from": 740.59,
      "to": 745.96,
      "sid": 275,
      "location": 2,
      "content": "那么这一小节呢咱们就介绍了串的定义以及几个相关的概念"
    },
    {
      "from": 745.96,
      "to": 748.26,
      "sid": 276,
      "location": 2,
      "content": "嗯这一小节咱们就学到这里"
    }
  ]
}