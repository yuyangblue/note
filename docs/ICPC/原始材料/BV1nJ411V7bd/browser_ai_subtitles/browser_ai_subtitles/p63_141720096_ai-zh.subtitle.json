  "type": "AIsubtitle",
  "lang": "zh",
  "version": "sync-v1.4.0.4",
  "body": [
    {
      "from": 2.3,
      "to": 3.2,
      "sid": 1,
      "location": 2,
      "content": "同学们好"
    },
    {
      "from": 3.2,
      "to": 8.54,
      "sid": 2,
      "location": 2,
      "content": "这一周呢我们来学习第四章串数组和广义表"
    },
    {
      "from": 8.559,
      "to": 11.379,
      "sid": 3,
      "location": 2,
      "content": "前面呢咱们学习了第二章线性表"
    },
    {
      "from": 11.379,
      "to": 12.879,
      "sid": 4,
      "location": 2,
      "content": "第三章栈和队列"
    },
    {
      "from": 12.879,
      "to": 14.949,
      "sid": 5,
      "location": 2,
      "content": "那我们说这些数据结构"
    },
    {
      "from": 14.949,
      "to": 18.41,
      "sid": 6,
      "location": 2,
      "content": "它的逻辑结构呢都是线性结构呃"
    },
    {
      "from": 18.41,
      "to": 23.82,
      "sid": 7,
      "location": 2,
      "content": "线性结构当中数据元素之间的关系是一对一的线性关系"
    },
    {
      "from": 24.08,
      "to": 28.82,
      "sid": 8,
      "location": 2,
      "content": "那么其中这个栈和队列呢我们说是比较特殊的"
    },
    {
      "from": 28.82,
      "to": 29.36,
      "sid": 9,
      "location": 2,
      "content": "线性表"
    },
    {
      "from": 29.36,
      "to": 30.32,
      "sid": 10,
      "location": 2,
      "content": "特殊在哪呢"
    },
    {
      "from": 30.32,
      "to": 31.67,
      "sid": 11,
      "location": 2,
      "content": "它的操作受限"
    },
    {
      "from": 31.67,
      "to": 32.659,
      "sid": 12,
      "location": 2,
      "content": "操作受限"
    },
    {
      "from": 32.659,
      "to": 37.52,
      "sid": 13,
      "location": 2,
      "content": "其实这个站呢它的插入和删除只能在表尾进行"
    },
    {
      "from": 37.52,
      "to": 40.95,
      "sid": 14,
      "location": 2,
      "content": "队列呢插入只能在表尾嗯"
    },
    {
      "from": 40.95,
      "to": 43.41,
      "sid": 15,
      "location": 2,
      "content": "删除呢只能在表头嗯"
    },
    {
      "from": 43.41,
      "to": 48.84,
      "sid": 16,
      "location": 2,
      "content": "那么咱们接下来要学的这个第四章串数组和广义表"
    },
    {
      "from": 48.84,
      "to": 51.42,
      "sid": 17,
      "location": 2,
      "content": "那么他们又是线性结构吗"
    },
    {
      "from": 51.42,
      "to": 53.34,
      "sid": 18,
      "location": 2,
      "content": "嗯它们又是线性的结构吗"
    },
    {
      "from": 53.34,
      "to": 59.77,
      "sid": 19,
      "location": 2,
      "content": "哎首先呢我们说这个串我们嗯可以把它仍然看作是线性结构"
    },
    {
      "from": 59.77,
      "to": 60.25,
      "sid": 20,
      "location": 2,
      "content": "诶"
    },
    {
      "from": 60.25,
      "to": 61.24,
      "sid": 21,
      "location": 2,
      "content": "它是什么样呢"
    },
    {
      "from": 61.24,
      "to": 63.9,
      "sid": 22,
      "location": 2,
      "content": "线性结构呢它也是一个线性表"
    },
    {
      "from": 63.9,
      "to": 68.91,
      "sid": 23,
      "location": 2,
      "content": "那么和我们之前第二章学的线性表不一样的地方在哪呢"
    },
    {
      "from": 68.91,
      "to": 70.98,
      "sid": 24,
      "location": 2,
      "content": "唉它的内容受限制"
    },
    {
      "from": 70.98,
      "to": 71.37,
      "sid": 25,
      "location": 2,
      "content": "嗯"
    },
    {
      "from": 71.37,
      "to": 76.31,
      "sid": 26,
      "location": 2,
      "content": "这个串嗯这个串当中的每一个数据元素"
    },
    {
      "from": 76.31,
      "to": 77.51,
      "sid": 27,
      "location": 2,
      "content": "每一个数据元素"
    },
    {
      "from": 77.51,
      "to": 80.92,
      "sid": 28,
      "location": 2,
      "content": "我们规定它只能是字符嗯"
    },
    {
      "from": 80.92,
      "to": 84.55,
      "sid": 29,
      "location": 2,
      "content": "只能是字符a不像咱们线性结构当中呢"
    },
    {
      "from": 84.55,
      "to": 86.44,
      "sid": 30,
      "location": 2,
      "content": "可以是整数嗯"
    },
    {
      "from": 86.44,
      "to": 87.88,
      "sid": 31,
      "location": 2,
      "content": "可以是小数"
    },
    {
      "from": 87.88,
      "to": 90.28,
      "sid": 32,
      "location": 2,
      "content": "也可以是特殊的嗯"
    },
    {
      "from": 90.28,
      "to": 94.53,
      "sid": 33,
      "location": 2,
      "content": "比如说图书哎这种这种数据元素嗯"
    },
    {
      "from": 94.53,
      "to": 98.94,
      "sid": 34,
      "location": 2,
      "content": "但是呢这个串当中数据元素只能是字符"
    },
    {
      "from": 99.6,
      "to": 107.1,
      "sid": 35,
      "location": 2,
      "content": "那么数组和广义表呢我们也可以把它看成是嗯这个线性结构"
    },
    {
      "from": 107.1,
      "to": 110.31,
      "sid": 36,
      "location": 2,
      "content": "那么数组当中的每一个元素"
    },
    {
      "from": 110.31,
      "to": 113.01,
      "sid": 37,
      "location": 2,
      "content": "数组当中的每一个元素诶"
    },
    {
      "from": 113.01,
      "to": 117.05,
      "sid": 38,
      "location": 2,
      "content": "如果又是一个这个线性表嗯"
    },
    {
      "from": 117.05,
      "to": 118.67,
      "sid": 39,
      "location": 2,
      "content": "又是一个线性表诶"
    },
    {
      "from": 118.67,
      "to": 120.44,
      "sid": 40,
      "location": 2,
      "content": "那我们说就是数组"
    },
    {
      "from": 120.44,
      "to": 125.169,
      "sid": 41,
      "location": 2,
      "content": "那广义表呢我们也可以把它看成是线性结构嗯"
    },
    {
      "from": 125.169,
      "to": 126.489,
      "sid": 42,
      "location": 2,
      "content": "看成是线性结构"
    },
    {
      "from": 126.489,
      "to": 131.469,
      "sid": 43,
      "location": 2,
      "content": "广义表当中的每一个元素呢又是一个广义表嗯"
    },
    {
      "from": 131.469,
      "to": 134.57,
      "sid": 44,
      "location": 2,
      "content": "又可以又可以看成是一个广义表诶"
    },
    {
      "from": 134.57,
      "to": 140.68,
      "sid": 45,
      "location": 2,
      "content": "所以我们说呢他们呢可以看成是这个呃线性结构"
    },
    {
      "from": 140.68,
      "to": 143.209,
      "sid": 46,
      "location": 2,
      "content": "它们是线性结构的推广"
    },
    {
      "from": 143.209,
      "to": 143.689,
      "sid": 47,
      "location": 2,
      "content": "唉"
    },
    {
      "from": 143.689,
      "to": 147.979,
      "sid": 48,
      "location": 2,
      "content": "但是呢严格来说它们已经是非线性结构了"
    },
    {
      "from": 147.979,
      "to": 149.82,
      "sid": 49,
      "location": 2,
      "content": "非线性结构好的"
    },
    {
      "from": 149.82,
      "to": 153.12,
      "sid": 50,
      "location": 2,
      "content": "那么接下来呢咱们首先来学习嗯"
    },
    {
      "from": 153.12,
      "to": 155.9,
      "sid": 51,
      "location": 2,
      "content": "这一章我们要学习的这个串"
    },
    {
      "from": 157.3,
      "to": 159.57,
      "sid": 52,
      "location": 2,
      "content": "第四第四章的第一节"
    },
    {
      "from": 159.57,
      "to": 161.7,
      "sid": 53,
      "location": 2,
      "content": "咱们先来学习这个串嗯"
    },
    {
      "from": 161.7,
      "to": 163.7,
      "sid": 54,
      "location": 2,
      "content": "那我们说这个串嗯"
    },
    {
      "from": 163.7,
      "to": 165.92,
      "sid": 55,
      "location": 2,
      "content": "串也叫做字符串"
    },
    {
      "from": 165.92,
      "to": 168.05,
      "sid": 56,
      "location": 2,
      "content": "英文名字叫做string嗯"
    },
    {
      "from": 168.05,
      "to": 173.33,
      "sid": 57,
      "location": 2,
      "content": "那么它是由零个或者是多个任意字符嗯"
    },
    {
      "from": 173.33,
      "to": 176.33,
      "sid": 58,
      "location": 2,
      "content": "任意字符是由字符组成的"
    },
    {
      "from": 176.33,
      "to": 179.42,
      "sid": 59,
      "location": 2,
      "content": "任意字符组成的有限序列嗯"
    },
    {
      "from": 179.42,
      "to": 180.79,
      "sid": 60,
      "location": 2,
      "content": "有限序列诶"
    },
    {
      "from": 180.79,
      "to": 185.53,
      "sid": 61,
      "location": 2,
      "content": "比如说咱们这块有一个串s它的值是多少呢"
    },
    {
      "from": 185.53,
      "to": 186.85,
      "sid": 62,
      "location": 2,
      "content": "是a1 a2 "
    },
    {
      "from": 186.85,
      "to": 188.21,
      "sid": 63,
      "location": 2,
      "content": "一直到a n"
    },
    {
      "from": 188.21,
      "to": 192.26,
      "sid": 64,
      "location": 2,
      "content": "那么其中这个n呢也是要大于等于零"
    },
    {
      "from": 192.26,
      "to": 193.37,
      "sid": 65,
      "location": 2,
      "content": "大于等于零"
    },
    {
      "from": 193.37,
      "to": 194.63,
      "sid": 66,
      "location": 2,
      "content": "但是呢是有限的"
    },
    {
      "from": 194.63,
      "to": 196.35,
      "sid": 67,
      "location": 2,
      "content": "不能是无限的嗯"
    },
    {
      "from": 196.35,
      "to": 200.85,
      "sid": 68,
      "location": 2,
      "content": "那么其中这个s呢我们就称作串名嗯"
    },
    {
      "from": 200.85,
      "to": 203.54,
      "sid": 69,
      "location": 2,
      "content": "这个字符串的名字串名"
    },
    {
      "from": 203.54,
      "to": 208.869,
      "sid": 70,
      "location": 2,
      "content": "那么后面这一大串呢我们就叫做这个串的串直嗯"
    },
    {
      "from": 208.869,
      "to": 211.629,
      "sid": 71,
      "location": 2,
      "content": "这个串这个字符串的值是什么"
    },
    {
      "from": 211.629,
      "to": 214.78,
      "sid": 72,
      "location": 2,
      "content": "哎值是a一到a n嗯串直"
    },
    {
      "from": 214.78,
      "to": 218.14,
      "sid": 73,
      "location": 2,
      "content": "那么其中这个串儿当中字符的个数"
    },
    {
      "from": 218.14,
      "to": 223.379,
      "sid": 74,
      "location": 2,
      "content": "我嗯字符的个数也就是这个n我们就叫做串的长度"
    },
    {
      "from": 223.379,
      "to": 224.69,
      "sid": 75,
      "location": 2,
      "content": "简称为串长"
    },
    {
      "from": 224.69,
      "to": 227.75,
      "sid": 76,
      "location": 2,
      "content": "那么如果这个长度是零嗯"
    },
    {
      "from": 227.75,
      "to": 228.62,
      "sid": 77,
      "location": 2,
      "content": "长度是零"
    },
    {
      "from": 228.62,
      "to": 231.14,
      "sid": 78,
      "location": 2,
      "content": "我们就称作这种字符串"
    },
    {
      "from": 231.14,
      "to": 232.88,
      "sid": 79,
      "location": 2,
      "content": "叫做空串的空串"
    },
    {
      "from": 232.88,
      "to": 233.99,
      "sid": 80,
      "location": 2,
      "content": "一个字符都没有"
    },
    {
      "from": 233.99,
      "to": 235.11,
      "sid": 81,
      "location": 2,
      "content": "叫做空串"
    },
    {
      "from": 235.11,
      "to": 238.23,
      "sid": 82,
      "location": 2,
      "content": "那么空串呢我们用这样的符号嗯"
    },
    {
      "from": 238.23,
      "to": 240.57,
      "sid": 83,
      "location": 2,
      "content": "用这样的符号来表示哎"
    },
    {
      "from": 240.57,
      "to": 244.79,
      "sid": 84,
      "location": 2,
      "content": "这个符号我们通常在表示集合的时候表示空集嗯"
    },
    {
      "from": 244.79,
      "to": 246.95,
      "sid": 85,
      "location": 2,
      "content": "空串呢就是一个字符都没有"
    },
    {
      "from": 246.95,
      "to": 249.32,
      "sid": 86,
      "location": 2,
      "content": "所以我们也用这个符号来表示"
    },
    {
      "from": 249.32,
      "to": 251.83,
      "sid": 87,
      "location": 2,
      "content": "嗯好这就是咱们说的串"
    },
    {
      "from": 251.83,
      "to": 258.1,
      "sid": 88,
      "location": 2,
      "content": "那么接下来呢给同学们再介绍几个关于串的术语嗯"
    },
    {
      "from": 258.1,
      "to": 259.08,
      "sid": 89,
      "location": 2,
      "content": "关于串的术语"
    },
    {
      "from": 259.08,
      "to": 261.9,
      "sid": 90,
      "location": 2,
      "content": "首先第一个是子串嗯"
    },
    {
      "from": 261.9,
      "to": 263.46,
      "sid": 91,
      "location": 2,
      "content": "什么叫做子串呢"
    },
    {
      "from": 263.46,
      "to": 268.86,
      "sid": 92,
      "location": 2,
      "content": "就是一个串儿当中任意一个连续的字符嗯"
    },
    {
      "from": 268.86,
      "to": 273.28,
      "sid": 93,
      "location": 2,
      "content": "任意一个连续的字符所组成的这个子序列嗯"
    },
    {
      "from": 273.28,
      "to": 275.86,
      "sid": 94,
      "location": 2,
      "content": "就叫做这个串的子串嗯"
    },
    {
      "from": 275.86,
      "to": 277.68,
      "sid": 95,
      "location": 2,
      "content": "就叫做这个串的子串"
    },
    {
      "from": 277.94,
      "to": 279.94,
      "sid": 96,
      "location": 2,
      "content": "那我们来看一下嗯"
    },
    {
      "from": 279.96,
      "to": 283.68,
      "sid": 97,
      "location": 2,
      "content": "哎咱们说任意一个字符组成的子序列"
    },
    {
      "from": 283.68,
      "to": 286.32,
      "sid": 98,
      "location": 2,
      "content": "包含这个空串都称为子串"
    },
    {
      "from": 286.32,
      "to": 291.04,
      "sid": 99,
      "location": 2,
      "content": "比如说咱们有一个字符串里面有五个字符a b c d e嗯"
    },
    {
      "from": 291.04,
      "to": 292.51,
      "sid": 100,
      "location": 2,
      "content": "那么它的子串是谁呢"
    },
    {
      "from": 292.51,
      "to": 293.86,
      "sid": 101,
      "location": 2,
      "content": "我说空串啊"
    },
    {
      "from": 293.86,
      "to": 295.0,
      "sid": 102,
      "location": 2,
      "content": "什么字符都没有"
    },
    {
      "from": 295.0,
      "to": 297.179,
      "sid": 103,
      "location": 2,
      "content": "也是它的子串诶"
    },
    {
      "from": 297.179,
      "to": 298.529,
      "sid": 104,
      "location": 2,
      "content": "任意一个字符"
    },
    {
      "from": 298.529,
      "to": 299.609,
      "sid": 105,
      "location": 2,
      "content": "任意一个连续的"
    },
    {
      "from": 299.609,
      "to": 303.7,
      "sid": 106,
      "location": 2,
      "content": "所以我们取一个字符a或者取一个字符d诶"
    },
    {
      "from": 303.7,
      "to": 305.26,
      "sid": 107,
      "location": 2,
      "content": "那都是它的字串"
    },
    {
      "from": 305.26,
      "to": 307.42,
      "sid": 108,
      "location": 2,
      "content": "我们取两个字符a b啊"
    },
    {
      "from": 307.42,
      "to": 308.44,
      "sid": 109,
      "location": 2,
      "content": "或者b c啊"
    },
    {
      "from": 308.44,
      "to": 310.29,
      "sid": 110,
      "location": 2,
      "content": "那也是他的字串嗯"
    },
    {
      "from": 310.29,
      "to": 312.01,
      "sid": 111,
      "location": 2,
      "content": "我们取三个字符"
    },
    {
      "from": 312.01,
      "to": 315.04,
      "sid": 112,
      "location": 2,
      "content": "比如说a b c或者是b c d"
    },
    {
      "from": 315.04,
      "to": 316.69,
      "sid": 113,
      "location": 2,
      "content": "但是要连续的嗯"
    },
    {
      "from": 316.69,
      "to": 317.71,
      "sid": 114,
      "location": 2,
      "content": "连续的诶"
    },
    {
      "from": 317.71,
      "to": 319.0,
      "sid": 115,
      "location": 2,
      "content": "那也是它的字串"
    },
    {
      "from": 319.0,
      "to": 321.07,
      "sid": 116,
      "location": 2,
      "content": "那我们取四个字符啊"
    },
    {
      "from": 321.07,
      "to": 327.46,
      "sid": 117,
      "location": 2,
      "content": "a b c d或者是这个嗯b c d e也是它的字串哎"
    },
    {
      "from": 327.46,
      "to": 330.7,
      "sid": 118,
      "location": 2,
      "content": "另外呢它自身也是它的词串嗯"
    },
    {
      "from": 330.7,
      "to": 332.57,
      "sid": 119,
      "location": 2,
      "content": "它自身也是它的词串"
    },
    {
      "from": 332.57,
      "to": 334.91,
      "sid": 120,
      "location": 2,
      "content": "那么如果是榛子串的话"
    },
    {
      "from": 334.91,
      "to": 338.4,
      "sid": 121,
      "location": 2,
      "content": "那就是不包含自身的所有子串"
    },
    {
      "from": 338.4,
      "to": 338.82,
      "sid": 122,
      "location": 2,
      "content": "嗯"
