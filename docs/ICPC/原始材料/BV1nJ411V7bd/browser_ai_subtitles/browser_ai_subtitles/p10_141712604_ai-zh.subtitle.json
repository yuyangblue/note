    {
      "from": 36.7,
      "to": 38.02,
      "sid": 15,
      "location": 2,
      "content": "把数据存储好"
    },
    {
      "from": 38.02,
      "to": 41.769,
      "sid": 16,
      "location": 2,
      "content": "还要把数据和数据之间的关系还要存储好"
    },
    {
      "from": 41.769,
      "to": 43.94,
      "sid": 17,
      "location": 2,
      "content": "这是数据的存储结构"
    },
    {
      "from": 43.94,
      "to": 47.6,
      "sid": 18,
      "location": 2,
      "content": "那么另外呢我们说存储的数据我们该如何进行操作"
    },
    {
      "from": 47.6,
      "to": 48.65,
      "sid": 19,
      "location": 2,
      "content": "进行运算呢"
    },
    {
      "from": 48.65,
      "to": 51.97,
      "sid": 20,
      "location": 2,
      "content": "唉这就是数据结构要研究的第三部分问题"
    },
    {
      "from": 51.97,
      "to": 53.22,
      "sid": 21,
      "location": 2,
      "content": "数据的运算"
    },
    {
      "from": 53.22,
      "to": 58.74,
      "sid": 22,
      "location": 2,
      "content": "那么其中数据元素之间的逻辑结构我们又分为线性结构嗯"
    },
    {
      "from": 58.74,
      "to": 60.15,
      "sid": 23,
      "location": 2,
      "content": "和非线性结构"
    },
    {
      "from": 60.15,
      "to": 66.68,
      "sid": 24,
      "location": 2,
      "content": "那么其中线性结构嗯是指的数据元素之间的关系存在着一对一的关系"
    },
    {
      "from": 66.68,
      "to": 68.18,
      "sid": 25,
      "location": 2,
      "content": "包括有线性表"
    },
    {
      "from": 68.18,
      "to": 69.17,
      "sid": 26,
      "location": 2,
      "content": "栈队列"
    },
    {
      "from": 69.17,
      "to": 69.8,
      "sid": 27,
      "location": 2,
      "content": "字符串"
    },
    {
      "from": 69.8,
      "to": 71.39,
      "sid": 28,
      "location": 2,
      "content": "数组广义表等等"
    },
    {
      "from": 71.39,
      "to": 71.84,
      "sid": 29,
      "location": 2,
      "content": "嗯"
    },
    {
      "from": 71.84,
      "to": 74.9,
      "sid": 30,
      "location": 2,
      "content": "那么非线性结构呢是指的数据元素之间"
    },
    {
      "from": 74.9,
      "to": 81.64,
      "sid": 31,
      "location": 2,
      "content": "存在着一对多或者多对多的关系诶那么如果存在的是一对多的关系"
    },
    {
      "from": 81.64,
      "to": 83.3,
      "sid": 32,
      "location": 2,
      "content": "那么就是树形结构"
    },
    {
      "from": 83.3,
      "to": 86.15,
      "sid": 33,
      "location": 2,
      "content": "如果存在的是多对多的关系"
    },
    {
      "from": 86.15,
      "to": 88.4,
      "sid": 34,
      "location": 2,
      "content": "那么就是图形结构嗯"
    },
    {
      "from": 88.4,
      "to": 90.379,
      "sid": 35,
      "location": 2,
      "content": "图形结构好嘞"
    },
    {
      "from": 90.379,
      "to": 95.31,
      "sid": 36,
      "location": 2,
      "content": "那么嗯除了要考虑数据元素之间的关系"
    },
    {
      "from": 95.31,
      "to": 98.37,
      "sid": 37,
      "location": 2,
      "content": "我们还要考虑这些数据元素啊"
    },
    {
      "from": 98.37,
      "to": 102.68,
      "sid": 38,
      "location": 2,
      "content": "如何在计算机内存当中来存储嗯"
    },
    {
      "from": 102.68,
      "to": 103.82,
      "sid": 39,
      "location": 2,
      "content": "来存储"
    },
    {
      "from": 103.82,
      "to": 107.06,
      "sid": 40,
      "location": 2,
      "content": "也就是说我们不仅要存储这些数据"
    },
    {
      "from": 107.06,
      "to": 109.4,
      "sid": 41,
      "location": 2,
      "content": "还要存储数据之间的关系"
    },
    {
      "from": 109.4,
      "to": 111.72,
      "sid": 42,
      "location": 2,
      "content": "也就是存储它的结构诶"
    },
    {
      "from": 111.72,
      "to": 116.47,
      "sid": 43,
      "location": 2,
      "content": "那么这就是我们要研究的是呃数据的存储结构嗯"
    },
    {
      "from": 116.47,
      "to": 117.67,
      "sid": 44,
      "location": 2,
      "content": "数据的存储结构"
    },
    {
      "from": 117.67,
      "to": 120.25,
      "sid": 45,
      "location": 2,
      "content": "那这个存储结构呢我们介绍了四种"
    },
    {
      "from": 120.25,
      "to": 125.31,
      "sid": 46,
      "location": 2,
      "content": "同学们重点掌握顺序存储结构和链式存储结构"
    },
    {
      "from": 125.31,
      "to": 129.95,
      "sid": 47,
      "location": 2,
      "content": "那么另外呢存储到计算机当中顺序这个数据嗯"
    },
    {
      "from": 129.95,
      "to": 133.37,
      "sid": 48,
      "location": 2,
      "content": "我们还要研究如何对它们进行运算"
    },
    {
      "from": 133.37,
      "to": 133.82,
      "sid": 49,
      "location": 2,
      "content": "嗯"
    },
    {
      "from": 133.82,
      "to": 139.69,
      "sid": 50,
      "location": 2,
      "content": "包括检索排序插入删除修改等等嗯等等"
    },
    {
      "from": 139.69,
      "to": 147.659,
      "sid": 51,
      "location": 2,
      "content": "那好那么我们接下来呢就先从所有的呃这些数据结构当中嗯"
    },
    {
      "from": 147.659,
      "to": 152.129,
      "sid": 52,
      "location": 2,
      "content": "第一种最常用的也是最简单的线性表开始"
    },
    {
      "from": 152.129,
      "to": 156.12,
      "sid": 53,
      "location": 2,
      "content": "这就是咱们第二章线性表要研究的内容"
    },
    {
      "from": 156.72,
      "to": 162.549,
      "sid": 54,
      "location": 2,
      "content": "那么咱们在第二章呢首先要研究一下什么是线性表嗯"
    },
    {
      "from": 162.549,
      "to": 163.479,
      "sid": 55,
      "location": 2,
      "content": "什么是线性表"
    },
    {
      "from": 163.479,
      "to": 165.18,
      "sid": 56,
      "location": 2,
      "content": "它有什么样的特点"
    },
    {
      "from": 165.18,
      "to": 169.5,
      "sid": 57,
      "location": 2,
      "content": "那么线性表有什么样的典型的应用嗯"
    },
    {
      "from": 169.5,
      "to": 174.14,
      "sid": 58,
      "location": 2,
      "content": "我们如何来定义线性表的呃抽象类型"
    },
    {
      "from": 174.14,
      "to": 178.67,
      "sid": 59,
      "location": 2,
      "content": "以及呢线性表如果用顺序存储方式来存储"
    },
    {
      "from": 178.67,
      "to": 180.47,
      "sid": 60,
      "location": 2,
      "content": "我们如何实现它"
    },
    {
      "from": 180.47,
      "to": 183.59,
      "sid": 61,
      "location": 2,
      "content": "如何来实现这个各种操作"
    },
    {
      "from": 183.59,
      "to": 187.31,
      "sid": 62,
      "location": 2,
      "content": "嗯如果线性表用链式存储结构来存储"
    },
    {
      "from": 187.31,
      "to": 191.03,
      "sid": 63,
      "location": 2,
      "content": "那么我们如何来这个实现各种操作"
    },
    {
      "from": 191.03,
      "to": 197.62,
      "sid": 64,
      "location": 2,
      "content": "然后呢我们要将两种存储结构顺序表和链表呢进行比较诶"
    },
    {
      "from": 197.62,
      "to": 202.39,
      "sid": 65,
      "location": 2,
      "content": "那么最后呢我们要来了解一下线性表有哪些嗯"
    },
    {
      "from": 202.39,
      "to": 203.47,
      "sid": 66,
      "location": 2,
      "content": "重要的应用"
    },
    {
      "from": 203.47,
      "to": 208.38,
      "sid": 67,
      "location": 2,
      "content": "以及咱们这个提到的案例如何实现好的"
    },
    {
      "from": 208.38,
      "to": 215.1,
      "sid": 68,
      "location": 2,
      "content": "那么咱们这节课呢就先从第一节线性表的定义和特点开始"
    },
    {
      "from": 216.839,
      "to": 218.759,
      "sid": 69,
      "location": 2,
      "content": "那么什么是线性表呢"
    },
    {
      "from": 218.759,
      "to": 227.4,
      "sid": 70,
      "location": 2,
      "content": "我们说线性表啊指的是具有相同特性的数据元素的一个有限序列"
    },
    {
      "from": 227.4,
      "to": 230.72,
      "sid": 71,
      "location": 2,
      "content": "那么同学们这里面注意这几个关键字嗯"
    },
    {
      "from": 230.72,
      "to": 233.12,
      "sid": 72,
      "location": 2,
      "content": "首先呢它是一个序列嗯"
    },
    {
      "from": 233.12,
      "to": 235.4,
      "sid": 73,
      "location": 2,
      "content": "就是有若干个数据元素"
    },
    {
      "from": 235.4,
      "to": 240.02,
      "sid": 74,
      "location": 2,
      "content": "第二个呢就是若干个数据元素呢通常是具有相同性质"
    },
    {
      "from": 240.02,
      "to": 242.11,
      "sid": 75,
      "location": 2,
      "content": "相同性质的相同特性的"
    },
    {
      "from": 242.11,
      "to": 243.97,
      "sid": 76,
      "location": 2,
      "content": "第三个呢它是有限的啊"
    },
    {
      "from": 243.97,
      "to": 246.22,
      "sid": 77,
      "location": 2,
      "content": "若干个若干个好"
    },
    {
      "from": 246.22,
      "to": 252.46,
      "sid": 78,
      "location": 2,
      "content": "那我们比如说用这样从a一到a21 直到an嗯"
    },
    {
      "from": 252.46,
      "to": 258.22,
      "sid": 79,
      "location": 2,
      "content": "这n个符号来表示线性表当中的n个数据元素"
    },
    {
      "from": 258.22,
      "to": 259.87,
      "sid": 80,
      "location": 2,
      "content": "那么n个数据元素"
    },
    {
      "from": 259.87,
      "to": 263.08,
      "sid": 81,
      "location": 2,
      "content": "那么其中第一个数据元素啊"
    },
    {
      "from": 263.08,
      "to": 266.77,
      "sid": 82,
      "location": 2,
      "content": "第一个数据元素我们也叫首首元嗯"
    },
    {
      "from": 266.77,
      "to": 271.3,
      "sid": 83,
      "location": 2,
      "content": "这首个首个元素就是线性表的起点"
    },
    {
      "from": 271.3,
      "to": 273.74,
      "sid": 84,
      "location": 2,
      "content": "我们也称作起始节点"
    },
    {
      "from": 273.74,
      "to": 274.87,
      "sid": 85,
      "location": 2,
      "content": "起始节点"
    },
    {
      "from": 274.87,
      "to": 278.29,
      "sid": 86,
      "location": 2,
      "content": "那么这个表当中的最后一个元素呢"
    },
    {
      "from": 278.29,
      "to": 283.02,
      "sid": 87,
      "location": 2,
      "content": "嗯就是这个线性表当中的这个终点"
    },
    {
      "from": 283.02,
      "to": 286.17,
      "sid": 88,
      "location": 2,
      "content": "终点我们也称作终端节点"
    },
    {
      "from": 286.17,
      "to": 287.37,
      "sid": 89,
      "location": 2,
      "content": "终端节点"
    },
    {
      "from": 287.37,
      "to": 290.03,
      "sid": 90,
      "location": 2,
      "content": "那么中间的任意一个元素呢"
    },
    {
      "from": 290.03,
      "to": 294.29,
      "sid": 91,
      "location": 2,
      "content": "嗯我们就称作一个唉普通的一个数据元素"
    },
    {
      "from": 294.29,
      "to": 296.15,
      "sid": 92,
      "location": 2,
      "content": "或者是叫做节点嗯"
    },
    {
      "from": 296.15,
      "to": 297.53,
      "sid": 93,
      "location": 2,
      "content": "或者叫做节点"
    },
    {
      "from": 297.53,
      "to": 305.99,
      "sid": 94,
      "location": 2,
      "content": "那么其中任意一个数据元素ai它的前一个元素我们称作它的直接前驱"
    },
    {
      "from": 305.99,
      "to": 310.52,
      "sid": 95,
      "location": 2,
      "content": "它的后一个元素我们称作它的直接后继嗯"
    },
    {
      "from": 310.52,
      "to": 311.7,
      "sid": 96,
      "location": 2,
      "content": "直接后继"
    },
    {
      "from": 311.719,
      "to": 317.8,
      "sid": 97,
      "location": 2,
      "content": "那么这个元素为了描述它在这个线性表当中的位置"
    },
    {
      "from": 317.8,
      "to": 319.12,
      "sid": 98,
      "location": 2,
      "content": "线性表当中的位置"
    },
    {
      "from": 319.12,
      "to": 322.71,
      "sid": 99,
      "location": 2,
      "content": "每个元素呢我们给它一个下标嗯"
    },
    {
      "from": 322.71,
      "to": 326.22,
      "sid": 100,
      "location": 2,
      "content": "那么这个下标呢就是这个元素的序号嗯"
    },
    {
      "from": 326.22,
      "to": 331.0,
      "sid": 101,
      "location": 2,
      "content": "这个元素的序号来表示这个数据元素在线性表当中的位置"
    },
    {
      "from": 332.199,
      "to": 336.05,
      "sid": 102,
      "location": 2,
      "content": "那么这个序号最后一个的序号啊"
    },
    {
      "from": 336.05,
      "to": 337.43,
      "sid": 103,
      "location": 2,
      "content": "就是这个n嗯"
    },
    {
      "from": 337.43,
      "to": 341.69,
      "sid": 104,
      "location": 2,
      "content": "这个n这个n呢就是我们这个线性表当中"
    },
    {
      "from": 341.69,
      "to": 345.8,
      "sid": 105,
      "location": 2,
      "content": "元素总个数也称作元素的个数"
    },
    {
      "from": 345.8,
      "to": 349.089,
      "sid": 106,
      "location": 2,
      "content": "也称作我们这个线性表的表长嗯"
    },
    {
      "from": 349.089,
      "to": 351.009,
      "sid": 107,
      "location": 2,
      "content": "这个表长度是多少呢"
    },
    {
      "from": 351.009,
      "to": 353.299,
      "sid": 108,
      "location": 2,
      "content": "就看看数据元素有几个"
    },
    {
      "from": 353.299,
      "to": 356.899,
      "sid": 109,
      "location": 2,
      "content": "那么如果这个线性表当中没有元素"
    },
    {
      "from": 356.899,
      "to": 358.73,
      "sid": 110,
      "location": 2,
      "content": "也就是n等于零的时候"
    },
    {
      "from": 358.73,
      "to": 362.66,
      "sid": 111,
      "location": 2,
      "content": "我们就称这个线性表为空表嗯"
    },
    {
      "from": 362.66,
      "to": 363.86,
      "sid": 112,
      "location": 2,
      "content": "为空表好"
    },
    {
      "from": 363.86,
      "to": 366.06,
      "sid": 113,
      "location": 2,
      "content": "那我们简总结一下嗯"
    },
    {
      "from": 366.06,
      "to": 367.32,
      "sid": 114,
      "location": 2,
      "content": "什么是线性表呢"
    },
    {
      "from": 367.32,
      "to": 370.68,
      "sid": 115,
      "location": 2,
      "content": "就是由n个这个n是大于等于零的嗯"
    },
    {
      "from": 370.68,
      "to": 377.35,
      "sid": 116,
      "location": 2,
      "content": "由n个数据元素也称作节点a1 a21 直到an所组成的有限序列"
    },
    {
      "from": 377.35,
      "to": 382.87,
      "sid": 117,
      "location": 2,
      "content": "那么其中这个数据元素的个数n叫做表的长度啊"
    },
    {
      "from": 382.87,
      "to": 384.04,
      "sid": 118,
      "location": 2,
      "content": "当n等于零时"
    },
    {
      "from": 384.04,
      "to": 386.14,
      "sid": 119,
      "location": 2,
      "content": "我们称作空表"
    },
    {
