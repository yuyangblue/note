    },
    {
      "from": 8.299,
      "to": 11.779,
      "sid": 5,
      "location": 2,
      "content": "那么在上一章当中我们学到了嗯"
    },
    {
      "from": 11.779,
      "to": 14.67,
      "sid": 6,
      "location": 2,
      "content": "咱们这门课数据结构是研究什么的"
