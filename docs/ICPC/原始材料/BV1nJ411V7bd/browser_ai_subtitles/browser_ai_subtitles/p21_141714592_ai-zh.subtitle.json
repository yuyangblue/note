      "sid": 73,
      "location": 2,
      "content": "它变化很大"
    },
    {
      "from": 230.98,
      "to": 233.14,
      "sid": 74,
      "location": 2,
      "content": "它可能会表中元素非常多"
    },
    {
      "from": 233.14,
      "to": 237.91,
      "sid": 75,
      "location": 2,
      "content": "那么非常多的元素我们就需要用非常多的空间啊"
    },
    {
      "from": 237.91,
      "to": 242.65,
      "sid": 76,
      "location": 2,
      "content": "那么他有时候又很少嗯很少这个空间的大小是固定不变的"
    },
    {
      "from": 242.65,
      "to": 244.15,
      "sid": 77,
      "location": 2,
      "content": "我们只用了很少一部分"
    },
    {
      "from": 244.15,
      "to": 245.77,
      "sid": 78,
      "location": 2,
      "content": "那就会浪费就太大了"
    },
    {
      "from": 245.77,
      "to": 246.7,
      "sid": 79,
      "location": 2,
      "content": "我们又会浪费"
    },
    {
      "from": 246.7,
      "to": 247.93,
      "sid": 80,
      "location": 2,
      "content": "那太少了呢"
    },
    {
      "from": 247.93,
      "to": 249.01,
      "sid": 81,
      "location": 2,
      "content": "嗯太小了呢"
    },
    {
      "from": 249.01,
      "to": 250.15,
      "sid": 82,
      "location": 2,
      "content": "这个空间太小了呢"
    },
    {
      "from": 250.15,
      "to": 252.04,
      "sid": 83,
      "location": 2,
      "content": "当我们元素个数增加的时候"
    },
    {
      "from": 252.04,
      "to": 252.37,
      "sid": 84,
      "location": 2,
      "content": "嗯"
    },
    {
      "from": 252.37,
      "to": 254.57,
      "sid": 85,
      "location": 2,
      "content": "那又会溢出哎"
    },
    {
      "from": 254.57,
      "to": 256.37,
      "sid": 86,
      "location": 2,
      "content": "所以呢它不灵活啊"
    },
    {
      "from": 256.37,
