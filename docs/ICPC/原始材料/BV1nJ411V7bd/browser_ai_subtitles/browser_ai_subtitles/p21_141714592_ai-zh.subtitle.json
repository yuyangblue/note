      "sid": 1,
      "location": 2,
      "content": "同学们好嗯"
    },
    {
      "from": 4.15,
      "to": 6.31,
      "sid": 2,
      "location": 2,
      "content": "这是这一周的最后一小节"
    },
    {
      "from": 6.31,
      "to": 7.78,
      "sid": 3,
      "location": 2,
      "content": "在这一小节里头呢"
    },
    {
      "from": 7.78,
      "to": 10.78,
      "sid": 4,
      "location": 2,
      "content": "我们把顺序表嗯小结一下"
    },
    {
      "from": 10.78,
      "to": 11.78,
      "sid": 5,
      "location": 2,
      "content": "复习一下"
    },
    {
      "from": 12.999,
      "to": 13.499,
      "sid": 6,
      "location": 2,
      "content": "诶"
    },
    {
      "from": 13.499,
      "to": 19.079,
      "sid": 7,
      "location": 2,
      "content": "我们说顺序表呢它是如何存储线性表当中的元素的呢"
    },
    {
      "from": 19.079,
      "to": 27.34,
      "sid": 8,
      "location": 2,
      "content": "它是利用数据元素的存储位置来表示线性表当中相邻元素的先后关系"
    },
    {
      "from": 27.34,
      "to": 31.54,
      "sid": 9,
      "location": 2,
      "content": "也就是说这个逻辑结构与存储结构是一致的"
    },
    {
      "from": 31.54,
      "to": 34.57,
      "sid": 10,
      "location": 2,
      "content": "逻辑上相邻的元素在存储的时候"
    },
    {
      "from": 34.57,
      "to": 36.81,
      "sid": 11,
      "location": 2,
      "content": "物理位置也是相邻的"
    },
    {
      "from": 36.81,
      "to": 39.6,
      "sid": 12,
      "location": 2,
      "content": "那我们在访问线性表的嗯"
    },
    {
      "from": 39.6,
      "to": 41.379,
      "sid": 13,
      "location": 2,
      "content": "当中的元素的时候呢"
    },
    {
      "from": 41.379,
      "to": 44.049,
      "sid": 14,
      "location": 2,
      "content": "我们知道某一个元素的地址"
    },
    {
      "from": 44.049,
      "to": 49.56,
      "sid": 15,
      "location": 2,
      "content": "就可以通过公式算出来任何一个元素的存储地址"
    },
    {
      "from": 49.56,
      "to": 55.59,
      "sid": 16,
      "location": 2,
      "content": "所以我们粗略地认为访问每个元素所花的时间是相等的"
    },
    {
      "from": 55.59,
      "to": 56.7,
      "sid": 17,
      "location": 2,
      "content": "那是相等的"
    },
    {
      "from": 56.7,
      "to": 61.32,
      "sid": 18,
      "location": 2,
      "content": "那么这种存取方法我们称它做随机存取法嗯"
    },
    {
      "from": 61.32,
      "to": 62.95,
      "sid": 19,
      "location": 2,
      "content": "随机存取法好"
    },
    {
      "from": 62.95,
      "to": 65.74,
      "sid": 20,
      "location": 2,
      "content": "那么它的基本运算呢有这些"
    },
    {
      "from": 65.74,
      "to": 71.89,
      "sid": 21,
      "location": 2,
      "content": "那么其中咱们重点学习的是插入删除和查找嗯"
    },
    {
      "from": 71.89,
      "to": 73.33,
      "sid": 22,
      "location": 2,
      "content": "插入删除和查找"
    },
    {
      "from": 73.33,
      "to": 80.429,
      "sid": 23,
      "location": 2,
      "content": "那么这三个算法他的时间复杂度呢都是大o n嗯"
    },
    {
      "from": 80.429,
      "to": 81.74,
      "sid": 24,
      "location": 2,
      "content": "都是大n"
    },
    {
      "from": 82.02,
      "to": 85.86,
      "sid": 25,
      "location": 2,
      "content": "它的空间复杂度呢都是大o1 "
    },
    {
      "from": 85.9,
      "to": 90.04,
      "sid": 26,
      "location": 2,
      "content": "所谓大v一呢就是我们不需要辅助的空间啊"
    },
    {
      "from": 90.04,
      "to": 93.28,
      "sid": 27,
      "location": 2,
      "content": "在原来的位置上就可以操作就可以操作"
    },
    {
      "from": 93.28,
      "to": 96.38,
      "sid": 28,
      "location": 2,
      "content": "那么这个顺序表的优点嗯"
    },
    {
      "from": 96.38,
      "to": 97.4,
      "sid": 29,
      "location": 2,
      "content": "顺序表的优点"
    },
    {
      "from": 97.4,
      "to": 100.02,
      "sid": 30,
      "location": 2,
      "content": "我们说第一个呢就是存储密度大"
    },
    {
      "from": 100.02,
      "to": 102.3,
      "sid": 31,
      "location": 2,
      "content": "这个存储密度是怎么算的呢"
    },
    {
      "from": 102.3,
      "to": 108.4,
      "sid": 32,
      "location": 2,
      "content": "就是节点本身所占的存储量比上节点结构所占的存储量"
    },
    {
      "from": 108.4,
      "to": 111.28,
      "sid": 33,
      "location": 2,
      "content": "我们说在顺序表当中嗯"
    },
    {
      "from": 111.28,
      "to": 119.21,
      "sid": 34,
      "location": 2,
      "content": "节点本身所占的存储量与它的这个节点结构所占的存储量呢是一样的"
    },
    {
      "from": 119.21,
      "to": 122.27,
      "sid": 35,
      "location": 2,
      "content": "所以这个比值呢是一嗯是一"
    },
    {
      "from": 122.27,
      "to": 124.73,
      "sid": 36,
      "location": 2,
      "content": "这个密度呢是最大的情况了"
    },
    {
      "from": 124.73,
      "to": 125.86,
      "sid": 37,
      "location": 2,
      "content": "嗯最大了"
    },
    {
      "from": 126.6,
      "to": 128.7,
      "sid": 38,
      "location": 2,
      "content": "那么第二个呢就是咱们刚才说的"
    },
    {
      "from": 128.7,
      "to": 132.12,
      "sid": 39,
      "location": 2,
      "content": "我们可每一个元素都可以通过公式计算嗯"
    },
    {
      "from": 132.12,
      "to": 133.62,
      "sid": 40,
      "location": 2,
      "content": "它到底在什么位置"
    },
    {
      "from": 133.62,
      "to": 141.12,
      "sid": 41,
      "location": 2,
      "content": "也就是说我们想取任意一个元素都可以以时间效率嗯是大o一嗯"
    },
    {
      "from": 141.12,
      "to": 142.5,
      "sid": 42,
      "location": 2,
      "content": "就一步运算嗯"
    },
    {
      "from": 142.5,
      "to": 144.45,
      "sid": 43,
      "location": 2,
      "content": "一个操作就可以解决嗯"
    },
    {
      "from": 144.45,
      "to": 147.96,
      "sid": 44,
      "location": 2,
      "content": "所以呢它可以随机任意取任意和一个元素"
    },
    {
      "from": 147.96,
      "to": 150.32,
      "sid": 45,
      "location": 2,
      "content": "这就是顺序表的优点"
    },
    {
      "from": 150.32,
      "to": 153.8,
      "sid": 46,
      "location": 2,
      "content": "但是呢我们介绍完他的操作的时候"
    },
    {
      "from": 153.8,
      "to": 156.29,
      "sid": 47,
      "location": 2,
      "content": "同学们发现它也有缺点啊"
    },
    {
      "from": 156.29,
      "to": 161.07,
      "sid": 48,
      "location": 2,
      "content": "缺点呢第一个就是在做插入和删除运算的时候"
    },
    {
      "from": 161.07,
      "to": 163.92,
      "sid": 49,
      "location": 2,
      "content": "如果我们要插入一个元素或者是删除一个元素呢"
    },
    {
      "from": 163.92,
      "to": 166.02,
      "sid": 50,
      "location": 2,
      "content": "就需要移动大量的元素"
    },
    {
      "from": 166.02,
      "to": 168.51,
      "sid": 51,
      "location": 2,
      "content": "这个时间效率是非常低的"
    },
    {
      "from": 168.51,
      "to": 173.62,
      "sid": 52,
      "location": 2,
      "content": "嗯第二个呢因为咱们存储数据元素需要一个数组"
    },
    {
      "from": 173.62,
      "to": 177.22,
      "sid": 53,
      "location": 2,
      "content": "那么为了能够存储下这个表中的数据元素"
    },
    {
      "from": 177.22,
      "to": 180.04,
      "sid": 54,
      "location": 2,
      "content": "我们这个数组呢通常会定义的比较大"
    },
    {
      "from": 180.04,
      "to": 183.82,
      "sid": 55,
      "location": 2,
      "content": "嗯那么里面呢就会空着很多的空间啊"
    },
    {
      "from": 183.82,
      "to": 185.08,
      "sid": 56,
      "location": 2,
      "content": "空着很多的空间"
    },
    {
      "from": 185.08,
      "to": 188.75,
      "sid": 57,
      "location": 2,
      "content": "所以呢我们说会浪费存储空间"
    },
    {
      "from": 188.75,
      "to": 193.37,
      "sid": 58,
      "location": 2,
      "content": "唉第三个呢就是它因为用数组存储"
    },
    {
      "from": 193.37,
      "to": 196.31,
      "sid": 59,
      "location": 2,
      "content": "所以呢这种静态存储形式啊"
    },
    {
      "from": 196.31,
      "to": 199.79,
      "sid": 60,
      "location": 2,
      "content": "数据元素的个数不能自由扩充"
    },
    {
      "from": 199.79,
      "to": 205.13,
      "sid": 61,
      "location": 2,
      "content": "嗯当我们的数组嗯数组已经满了的时候"
    },
    {
      "from": 205.13,
      "to": 208.07,
      "sid": 62,
      "location": 2,
      "content": "我们就不能再往里头插入元素了啊"
    },
    {
      "from": 208.07,
      "to": 209.69,
      "sid": 63,
      "location": 2,
      "content": "不能再往里头插入元素"
    },
    {
      "from": 209.69,
      "to": 213.159,
      "sid": 64,
      "location": 2,
      "content": "所以呢我们说它的这个大小啊"
    },
    {
      "from": 213.159,
      "to": 215.35,
      "sid": 65,
      "location": 2,
      "content": "这种表的大小最大嗯"
    },
    {
      "from": 215.35,
      "to": 218.29,
      "sid": 66,
      "location": 2,
      "content": "能够放多少个元素已经被固定了嗯"
    },
    {
      "from": 218.29,
      "to": 219.19,
      "sid": 67,
      "location": 2,
      "content": "不够灵活"
    },
    {
      "from": 219.19,
      "to": 220.12,
      "sid": 68,
      "location": 2,
      "content": "不够灵活"
    },
    {
      "from": 220.12,
      "to": 224.959,
      "sid": 69,
      "location": 2,
      "content": "如果我们这个表中元素的个数变化非常大的时候"
    },
    {
      "from": 224.959,
