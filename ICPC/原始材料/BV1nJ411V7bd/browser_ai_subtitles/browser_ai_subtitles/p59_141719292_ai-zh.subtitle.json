    {
      "from": 22.65,
      "to": 23.81,
      "sid": 9,
      "location": 2,
      "content": "不然我们都忘了"
    },
    {
      "from": 23.81,
      "to": 26.87,
      "sid": 10,
      "location": 2,
      "content": "我们说队列呢它其实也是线性表啊"
    },
    {
      "from": 26.87,
      "to": 29.39,
      "sid": 11,
      "location": 2,
      "content": "里面有a一到a an n个元素"
    },
    {
      "from": 29.39,
      "to": 31.79,
      "sid": 12,
      "location": 2,
      "content": "那么跟普通的线性表有什么不一样呢"
    },
    {
      "from": 31.79,
      "to": 33.65,
      "sid": 13,
      "location": 2,
      "content": "就是我们限定了嗯"
    },
    {
      "from": 33.65,
      "to": 36.43,
      "sid": 14,
      "location": 2,
      "content": "他在一端删除"
    },
    {
      "from": 36.43,
      "to": 38.68,
      "sid": 15,
      "location": 2,
      "content": "在另外一端来插入"
    },
    {
      "from": 38.68,
      "to": 38.98,
      "sid": 16,
      "location": 2,
      "content": "嗯"
    },
    {
      "from": 38.98,
      "to": 40.09,
      "sid": 17,
      "location": 2,
      "content": "就像排队似的"
    },
    {
      "from": 40.09,
      "to": 43.159,
