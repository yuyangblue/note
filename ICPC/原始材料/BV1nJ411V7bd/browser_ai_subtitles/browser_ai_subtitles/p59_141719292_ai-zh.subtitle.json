      "location": 2,
      "content": "表尾呢在这个队列里头"
    },
    {
      "from": 56.42,
      "to": 58.57,
      "sid": 24,
      "location": 2,
      "content": "我们就称作对尾嗯对尾"
    },
    {
      "from": 58.57,
      "to": 60.67,
      "sid": 25,
      "location": 2,
      "content": "所以呢我们离开的时候呢"
    },
    {
      "from": 60.67,
      "to": 62.95,
      "sid": 26,
      "location": 2,
      "content": "就是从这个对头离开嗯"
    },
    {
      "from": 62.95,
      "to": 64.21,
      "sid": 27,
      "location": 2,
      "content": "对头离开哎"
    },
    {
      "from": 64.21,
      "to": 67.72,
      "sid": 28,
      "location": 2,
      "content": "这就是咱们说的这个队列队列"
    },
    {
      "from": 67.72,
      "to": 69.16,
      "sid": 29,
      "location": 2,
      "content": "它其实也是线性表"
    },
    {
      "from": 69.16,
      "to": 70.72,
      "sid": 30,
      "location": 2,
      "content": "但是操作受限的呃"
    },
    {
      "from": 70.72,
      "to": 72.97,
      "sid": 31,
      "location": 2,
      "content": "我们规定它只能在对尾"
    },
    {
      "from": 72.97,
      "to": 75.73,
      "sid": 32,
      "location": 2,
      "content": "这个插入一个新元素嗯"
    },
    {
      "from": 75.73,
      "to": 76.87,
      "sid": 33,
      "location": 2,
      "content": "删除的时候呢"
    },
    {
      "from": 76.87,
      "to": 79.759,
      "sid": 34,
      "location": 2,
      "content": "只能在对头来删除元素嗯"
    },
    {
      "from": 79.759,
      "to": 82.56,
      "sid": 35,
      "location": 2,
      "content": "他有这样的一个这个顺序"
    },
    {
      "from": 82.56,
      "to": 84.12,
