    {
      "from": 90.88,
      "to": 94.09,
      "sid": 40,
      "location": 2,
      "content": "只能在表头进行删除的线性表"
    },
    {
      "from": 94.09,
      "to": 96.52,
      "sid": 41,
      "location": 2,
      "content": "它的英文名字呢叫做q嗯"
    },
    {
      "from": 96.52,
      "to": 97.24,
      "sid": 42,
      "location": 2,
      "content": "叫做q"
    },
    {
      "from": 97.24,
      "to": 100.06,
      "sid": 43,
      "location": 2,
      "content": "那么表尾这一端呢也就是a n的这一端呢"
