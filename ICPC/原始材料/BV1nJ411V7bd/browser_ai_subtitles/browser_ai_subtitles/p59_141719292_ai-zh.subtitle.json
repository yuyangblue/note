      "location": 2,
      "content": "我们就叫做对头"
    },
    {
      "from": 106.259,
      "to": 110.309,
      "sid": 48,
      "location": 2,
      "content": "那么它是一种呃first in first out"
    },
    {
      "from": 110.309,
      "to": 112.31,
      "sid": 49,
      "location": 2,
      "content": "先进先出的线性表"
    },
    {
      "from": 112.31,
      "to": 112.67,
      "sid": 50,
      "location": 2,
      "content": "嗯"
    },
    {
      "from": 112.67,
      "to": 113.9,
      "sid": 51,
      "location": 2,
      "content": "先进先出的线性表"
    },
    {
      "from": 113.9,
      "to": 118.71,
      "sid": 52,
      "location": 2,
      "content": "我们通常呢就用这个q q来表示队列"
