  "body": [
    {
      "from": 2.04,
      "to": 2.87,
      "sid": 1,
      "location": 2,
      "content": "同学们好"
    },
    {
      "from": 2.87,
      "to": 5.9,
      "sid": 2,
      "location": 2,
      "content": "这一小节呢咱们来学习第四节当中"
    },
    {
      "from": 5.9,
      "to": 8.98,
      "sid": 3,
      "location": 2,
      "content": "选择排序的另外一种选择排序法"
    },
    {
      "from": 8.98,
      "to": 10.63,
      "sid": 4,
      "location": 2,
      "content": "叫做堆排序"
    },
    {
      "from": 10.63,
      "to": 11.38,
      "sid": 5,
      "location": 2,
      "content": "堆排序"
    },
    {
      "from": 11.38,
      "to": 14.05,
      "sid": 6,
      "location": 2,
      "content": "堆排序是一种非常有用的排序方法"
    },
    {
      "from": 14.05,
      "to": 16.37,
      "sid": 7,
      "location": 2,
      "content": "那么接下来呢咱们来学习一下"
    },
    {
      "from": 16.37,
      "to": 19.73,
      "sid": 8,
      "location": 2,
      "content": "首先呢我们先了解一下什么是堆嗯"
    },
    {
      "from": 19.73,
      "to": 20.49,
      "sid": 9,
      "location": 2,
      "content": "什么是堆"
    },
    {
      "from": 20.49,
      "to": 23.07,
      "sid": 10,
      "location": 2,
      "content": "我们说如果有n个元素组成的"
    },
    {
      "from": 23.07,
      "to": 25.11,
      "sid": 11,
      "location": 2,
      "content": "这样的一个序列嗯"
    },
    {
      "from": 25.11,
      "to": 26.88,
      "sid": 12,
      "location": 2,
      "content": "它满足这样的条件"
    },
    {
      "from": 26.88,
      "to": 27.75,
      "sid": 13,
      "location": 2,
      "content": "什么条件呢"
    },
    {
      "from": 27.75,
      "to": 30.51,
      "sid": 14,
      "location": 2,
      "content": "就是第二个位置上的元素"
    },
    {
      "from": 30.51,
      "to": 32.67,
      "sid": 15,
      "location": 2,
      "content": "第二个位置上的元素啊"
    },
    {
      "from": 32.67,
      "to": 35.85,
      "sid": 16,
      "location": 2,
      "content": "它比第2i个位置上的元素小"
    },
    {
      "from": 35.85,
      "to": 39.78,
      "sid": 17,
      "location": 2,
      "content": "也比第2i加一个呃"
    },
    {
      "from": 39.78,
      "to": 41.7,
      "sid": 18,
      "location": 2,
      "content": "这个位置上的元素小"
    },
    {
      "from": 41.7,
      "to": 43.83,
      "sid": 19,
      "location": 2,
      "content": "哎比如说i等于一的话"
    },
    {
      "from": 43.83,
      "to": 45.0,
      "sid": 20,
      "location": 2,
      "content": "嗯等于一的话"
    },
    {
      "from": 45.0,
      "to": 48.0,
      "sid": 21,
      "location": 2,
      "content": "也就是第一个位置上的元素要小于第二个"
    },
    {
      "from": 48.0,
      "to": 49.38,
      "sid": 22,
      "location": 2,
      "content": "小于第三个"
    },
    {
      "from": 49.38,
      "to": 54.91,
      "sid": 23,
      "location": 2,
      "content": "同理这个二个第二个位置上的元素呢"
    },
    {
      "from": 54.91,
      "to": 57.1,
      "sid": 24,
      "location": 2,
      "content": "就必须要小于二"
    },
    {
      "from": 57.1,
      "to": 57.91,
      "sid": 25,
      "location": 2,
      "content": "二得四"
    },
    {
      "from": 57.91,
      "to": 59.44,
      "sid": 26,
      "location": 2,
      "content": "按二得四"
    },
    {
      "from": 59.44,
      "to": 61.24,
      "sid": 27,
      "location": 2,
      "content": "然后4+1=5"
    },
    {
      "from": 61.24,
      "to": 61.57,
      "sid": 28,
      "location": 2,
      "content": "哎"
    },
    {
      "from": 61.57,
      "to": 64.259,
      "sid": 29,
      "location": 2,
      "content": "就必须要小于第四个位置和第五个位置"
    },
    {
      "from": 64.259,
      "to": 65.129,
      "sid": 30,
      "location": 2,
      "content": "同理呢"
    },
    {
      "from": 65.129,
      "to": 68.639,
      "sid": 31,
      "location": 2,
      "content": "第三个元素就必须要小于第六个位置"
    },
    {
      "from": 68.639,
      "to": 70.92,
      "sid": 32,
      "location": 2,
      "content": "和第七个位置上的元素嗯"
    },
    {
      "from": 70.92,
      "to": 74.37,
      "sid": 33,
      "location": 2,
      "content": "如果满足这样的这个条件"
    },
    {
      "from": 74.37,
      "to": 75.51,
      "sid": 34,
      "location": 2,
      "content": "这样的条件"
    },
    {
      "from": 75.51,
      "to": 78.4,
      "sid": 35,
      "location": 2,
      "content": "那我们说它就叫做小根堆"
    },
    {
      "from": 78.4,
      "to": 79.33,
      "sid": 36,
      "location": 2,
      "content": "小根堆"
    },
    {
      "from": 79.33,
      "to": 80.41,
      "sid": 37,
      "location": 2,
      "content": "那么翻过来"
    },
    {
      "from": 80.41,
      "to": 83.77,
      "sid": 38,
      "location": 2,
      "content": "如果每一个元素呢都比它的嗯"
    },
    {
      "from": 83.77,
      "to": 85.75,
      "sid": 39,
      "location": 2,
      "content": "2i位置和2a加一"
    },
    {
      "from": 85.75,
      "to": 88.03,
      "sid": 40,
      "location": 2,
      "content": "位置上的元素来得大的话"
    },
    {
      "from": 88.03,
      "to": 90.82,
      "sid": 41,
      "location": 2,
      "content": "那么我们就称作大根堆嗯"
    },
    {
      "from": 90.82,
      "to": 92.14,
      "sid": 42,
      "location": 2,
      "content": "就称作大根堆"
    },
    {
      "from": 92.14,
      "to": 94.6,
      "sid": 43,
      "location": 2,
      "content": "那么实际上同学们经过这个定义呢"
    },
    {
      "from": 94.6,
      "to": 98.39,
      "sid": 44,
      "location": 2,
      "content": "就知道嗯这这个堆实际上是一个什么呢"
    },
    {
      "from": 98.39,
      "to": 100.85,
      "sid": 45,
      "location": 2,
      "content": "是一个完全二叉树"
    },
    {
      "from": 100.85,
      "to": 102.32,
      "sid": 46,
      "location": 2,
      "content": "完全二叉树"
    },
    {
      "from": 102.32,
      "to": 103.25,
      "sid": 47,
      "location": 2,
      "content": "完全二叉树"
    },
    {
      "from": 103.25,
      "to": 104.99,
      "sid": 48,
      "location": 2,
      "content": "而且这个完全二叉树"
    },
    {
      "from": 104.99,
      "to": 107.6,
      "sid": 49,
      "location": 2,
      "content": "咱们根据二叉树的性质五"
    },
    {
      "from": 107.6,
      "to": 109.59,
      "sid": 50,
      "location": 2,
      "content": "就在说完全二叉树是不是啊"
    },
    {
      "from": 109.59,
      "to": 111.87,
      "sid": 51,
      "location": 2,
      "content": "二叉树的性质我说什么嗯"
    },
    {
      "from": 111.87,
      "to": 115.18,
      "sid": 52,
      "location": 2,
      "content": "说如果有一个元素它的下标嗯"
    },
    {
      "from": 115.18,
      "to": 117.84,
      "sid": 53,
      "location": 2,
      "content": "这个它的序号是i的话"
    },
    {
      "from": 117.88,
      "to": 120.94,
      "sid": 54,
      "location": 2,
      "content": "a那么它的左孩子呢就是2i"
    },
    {
      "from": 120.94,
      "to": 123.37,
      "sid": 55,
      "location": 2,
      "content": "它的右孩子就是2i加一"
    },
    {
      "from": 123.37,
      "to": 127.93,
      "sid": 56,
      "location": 2,
      "content": "是不是这个是怎么来编号的来着"
    },
    {
      "from": 127.93,
      "to": 130.85,
      "sid": 57,
      "location": 2,
      "content": "嗯对于一棵二叉树啊"
    },
    {
      "from": 130.85,
      "to": 131.87,
      "sid": 58,
      "location": 2,
      "content": "二叉树怎么叠好"
    },
    {
      "from": 131.87,
      "to": 133.53,
      "sid": 59,
      "location": 2,
      "content": "我们是从上到下"
    },
    {
      "from": 133.53,
      "to": 134.43,
      "sid": 60,
      "location": 2,
      "content": "从左到右"
    },
    {
      "from": 134.43,
      "to": 136.56,
      "sid": 61,
      "location": 2,
      "content": "是不是根节点编号为一"
    },
    {
      "from": 136.56,
      "to": 140.209,
      "sid": 62,
      "location": 2,
      "content": "那么他的两个孩子呢就是2号和3号"
    },
    {
      "from": 140.209,
      "to": 144.35,
      "sid": 63,
      "location": 2,
      "content": "2号的孩子呢就是4号和5号嗯"
    },
    {
      "from": 144.35,
      "to": 148.62,
      "sid": 64,
      "location": 2,
      "content": "然后3号呢就是这个6号和7号嗯"
    },
    {
      "from": 148.62,
      "to": 150.12,
      "sid": 65,
      "location": 2,
      "content": "6号和7号诶"
    },
    {
      "from": 150.12,
      "to": 151.19,
      "sid": 66,
      "location": 2,
      "content": "就是这么来编"
    },
    {
      "from": 151.19,
      "to": 154.07,
      "sid": 67,
      "location": 2,
      "content": "跟这个从上到下一层一层的"
    },
    {
      "from": 154.07,
      "to": 157.07,
      "sid": 68,
      "location": 2,
      "content": "每一层呢是从左到右这样来编嗯"
    },
    {
      "from": 157.07,
      "to": 158.12,
      "sid": 69,
      "location": 2,
      "content": "这样来编号"
    },
    {
      "from": 158.12,
      "to": 161.14,
      "sid": 70,
      "location": 2,
      "content": "那么这个i第i个元素"
    },
    {
      "from": 161.14,
      "to": 165.41,
      "sid": 71,
      "location": 2,
      "content": "它的左孩子就是2i右孩子就是2a加一"
    },
    {
      "from": 165.41,
      "to": 169.25,
      "sid": 72,
      "location": 2,
      "content": "所以我们说这个小根堆就是什么呢"
    },
    {
      "from": 169.25,
      "to": 173.89,
      "sid": 73,
      "location": 2,
      "content": "每一个根节点都比他的左右孩子来的小的"
    },
    {
      "from": 173.89,
      "to": 174.13,
      "sid": 74,
      "location": 2,
      "content": "嗯"
    },
    {
      "from": 174.13,
      "to": 176.5,
      "sid": 75,
      "location": 2,
      "content": "比他的左右孩子来的小嗯"
    },
    {
      "from": 176.5,
      "to": 178.32,
      "sid": 76,
      "location": 2,
      "content": "他比较小诶"
    },
    {
      "from": 178.5,
      "to": 180.06,
      "sid": 77,
      "location": 2,
      "content": "左右孩子都大于他"
    },
    {
      "from": 180.06,
      "to": 182.04,
      "sid": 78,
      "location": 2,
      "content": "那这就是小根堆嗯"
    },
    {
      "from": 182.04,
      "to": 187.29,
      "sid": 79,
      "location": 2,
      "content": "如果呢左右孩子这个这个都是小于"
    },
    {
      "from": 187.29,
      "to": 189.03,
      "sid": 80,
      "location": 2,
      "content": "它的根比较大嗯"
    },
    {
      "from": 189.03,
      "to": 189.9,
      "sid": 81,
      "location": 2,
      "content": "根比较大"
    },
    {
      "from": 189.9,
      "to": 192.18,
      "sid": 82,
      "location": 2,
      "content": "左右孩子呢是比较小的"
    },
    {
      "from": 192.18,
      "to": 195.38,
      "sid": 83,
      "location": 2,
      "content": "那么这种呢咱们就叫做大根堆"
    },
    {
      "from": 195.38,
      "to": 195.8,
      "sid": 84,
      "location": 2,
      "content": "嗯"
    },
    {
      "from": 195.8,
      "to": 197.54,
      "sid": 85,
      "location": 2,
      "content": "大根堆根比较大嘛"
    },
    {
      "from": 197.54,
      "to": 199.52,
      "sid": 86,
      "location": 2,
      "content": "哎所以我们说实际上"
    },
    {
      "from": 199.52,
      "to": 202.14,
      "sid": 87,
      "location": 2,
      "content": "不管是小根堆还是大根堆"
    },
    {
      "from": 202.14,
      "to": 204.99,
      "sid": 88,
      "location": 2,
      "content": "那么它都是一棵完全二叉树"
    },
    {
      "from": 204.99,
      "to": 208.32,
      "sid": 89,
      "location": 2,
      "content": "而且满足于任意一个非叶子节点"
    },
    {
      "from": 208.32,
      "to": 210.079,
      "sid": 90,
      "location": 2,
      "content": "也就是说他有孩子的话"
    },
    {
      "from": 210.079,
      "to": 214.399,
      "sid": 91,
      "location": 2,
      "content": "他的孩子节点的值必须要小于根节点嗯"
    },
    {
      "from": 214.399,
      "to": 215.8,
      "sid": 92,
      "location": 2,
      "content": "必须小于根节点"
    },
    {
      "from": 216.499,
      "to": 219.759,
      "sid": 93,
      "location": 2,
      "content": "那么接下来呢请同学们判断一下嗯"
    },
    {
      "from": 219.759,
      "to": 225.33,
      "sid": 94,
      "location": 2,
      "content": "这样的两组数是不是嗯对是不是对好"
    },
    {
      "from": 225.33,
      "to": 227.48,
      "sid": 95,
      "location": 2,
      "content": "那么怎么判断是不是对呀"
    },
    {
      "from": 227.48,
      "to": 229.28,
      "sid": 96,
      "location": 2,
      "content": "唉我们说第一个元素呢"
    },
    {
      "from": 229.28,
      "to": 230.87,
      "sid": 97,
      "location": 2,
      "content": "咱们就编号是一"
    },
    {
      "from": 230.87,
      "to": 231.65,
      "sid": 98,
      "location": 2,
      "content": "是不是啊"
    },
    {
      "from": 231.65,
      "to": 233.89,
      "sid": 99,
      "location": 2,
      "content": "是一那第二个元素"
    },
    {
      "from": 233.89,
      "to": 235.12,
      "sid": 100,
      "location": 2,
      "content": "第三个元素"
    },
    {
      "from": 235.12,
      "to": 236.26,
      "sid": 101,
      "location": 2,
      "content": "第四个元素"
    },
    {
      "from": 236.26,
      "to": 239.019,
      "sid": 102,
      "location": 2,
      "content": "第五个元素我们按照定义的话"
    },
    {
      "from": 239.019,
      "to": 239.409,
      "sid": 103,
      "location": 2,
      "content": "嗯"
    },
    {
      "from": 239.409,
      "to": 241.36,
      "sid": 104,
      "location": 2,
      "content": "那我们给它编好号"
    },
    {
      "from": 241.36,
      "to": 242.95,
      "sid": 105,
      "location": 2,
      "content": "然后我们来看一下"
    },
    {
      "from": 242.95,
      "to": 245.47,
      "sid": 106,
      "location": 2,
      "content": "第一个呢比二三都来得大"
    },
    {
      "from": 245.47,
      "to": 246.18,
      "sid": 107,
      "location": 2,
      "content": "是不是啊"
    },
    {
      "from": 246.18,
      "to": 249.24,
      "sid": 108,
      "location": 2,
      "content": "好第二个呢比四五都来得大"
    },
    {
      "from": 249.24,
      "to": 250.26,
      "sid": 109,
      "location": 2,
      "content": "一个是二"
    },
    {
      "from": 250.26,
      "to": 252.54,
      "sid": 110,
      "location": 2,
      "content": "一个是2a加一嗯"
    },
    {
      "from": 252.54,
      "to": 255.78,
      "sid": 111,
      "location": 2,
      "content": "第三个呢比六七这个都来得大"
    },
    {
      "from": 255.78,
      "to": 257.64,
      "sid": 112,
      "location": 2,
      "content": "然后呢这个第四个呢"
    },
    {
      "from": 257.64,
      "to": 259.62,
      "sid": 113,
      "location": 2,
      "content": "第四个是八和九"
    },
    {
      "from": 259.62,
      "to": 261.679,
      "sid": 114,
      "location": 2,
      "content": "是不是诶这个来自大"
    },
    {
      "from": 261.679,
      "to": 264.889,
      "sid": 115,
      "location": 2,
      "content": "那么如果我们把这些数据元素"
    },
    {
      "from": 264.889,
      "to": 268.22,
      "sid": 116,
      "location": 2,
      "content": "排在一棵二叉树上"
    },
    {
      "from": 268.22,
      "to": 268.61,
      "sid": 117,
      "location": 2,
      "content": "嗯"
    },
    {
      "from": 268.61,
      "to": 269.6,
      "sid": 118,
      "location": 2,
      "content": "一一和二叉树"
    },
    {
      "from": 269.6,
      "to": 272.21,
      "sid": 119,
      "location": 2,
      "content": "我们就按照这个他是一他是2号"
    },
    {
      "from": 272.21,
      "to": 273.14,
      "sid": 120,
      "location": 2,
      "content": "他是3号"
    },
    {
      "from": 273.14,
      "to": 274.21,
      "sid": 121,
      "location": 2,
      "content": "从上到下"
    },
    {
      "from": 274.21,
      "to": 275.29,
      "sid": 122,
      "location": 2,
      "content": "从左到右"
    },
    {
      "from": 275.29,
      "to": 279.28,
      "sid": 123,
      "location": 2,
      "content": "我们把这些节点呢依次放在这个事物当中"
    },
    {
      "from": 279.28,
      "to": 279.78,
      "sid": 124,
      "location": 2,
      "content": "嗯"
    },
    {
      "from": 279.78,
      "to": 281.25,
      "sid": 125,
      "location": 2,
      "content": "一次放在树当中"
    },
    {
      "from": 281.25,
      "to": 283.83,
      "sid": 126,
      "location": 2,
      "content": "这就是一棵完全二叉树"
    },
    {
      "from": 283.83,
      "to": 284.22,
      "sid": 127,
      "location": 2,
      "content": "嗯"
