  "body": [
    {
      "from": 1.34,
      "to": 2.12,
      "sid": 1,
      "location": 2,
      "content": "同学们好"
    },
    {
      "from": 2.12,
      "to": 5.79,
      "sid": 2,
      "location": 2,
      "content": "这一小节呢咱们接着来学习对排序嗯"
    },
    {
      "from": 5.79,
      "to": 6.87,
      "sid": 3,
      "location": 2,
      "content": "那么上一小节呢"
    },
    {
      "from": 6.87,
      "to": 9.25,
      "sid": 4,
      "location": 2,
      "content": "咱们介绍这个堆排序是干什么呢"
    },
    {
      "from": 9.25,
      "to": 10.72,
      "sid": 5,
      "location": 2,
      "content": "哎是从堆顶呢"
    },
    {
      "from": 10.72,
      "to": 12.85,
      "sid": 6,
      "location": 2,
      "content": "哎大根堆的堆顶就是最大值"
    },
    {
      "from": 12.85,
      "to": 14.5,
      "sid": 7,
      "location": 2,
      "content": "小根堆的堆顶就是最小值"
    },
    {
      "from": 14.5,
      "to": 15.91,
      "sid": 8,
      "location": 2,
      "content": "把对应元素输出"
    },
    {
      "from": 15.91,
      "to": 19.03,
      "sid": 9,
      "location": 2,
      "content": "然后呢把剩下的元素再调整成堆"
    },
    {
      "from": 19.03,
      "to": 20.23,
      "sid": 10,
      "location": 2,
      "content": "再输出堆顶"
    },
    {
      "from": 20.23,
      "to": 21.28,
      "sid": 11,
      "location": 2,
      "content": "那么这样反复"
    },
    {
      "from": 21.28,
      "to": 23.65,
      "sid": 12,
      "location": 2,
      "content": "我们就可以得到一个有序的序列"
    },
    {
      "from": 23.65,
      "to": 26.509,
      "sid": 13,
      "location": 2,
      "content": "这种排序方式就叫做堆排序"
    },
    {
      "from": 26.509,
      "to": 28.699,
      "sid": 14,
      "location": 2,
      "content": "对排序呢它要解决两个问题"
    },
    {
      "from": 28.699,
      "to": 29.749,
      "sid": 15,
      "location": 2,
      "content": "第一个问题呢"
    },
    {
      "from": 29.749,
      "to": 31.789,
      "sid": 16,
      "location": 2,
      "content": "就是怎么一开始的时候"
    },
    {
      "from": 31.789,
      "to": 34.64,
      "sid": 17,
      "location": 2,
      "content": "把这些无序序列变成一个堆啊"
    },
    {
      "from": 34.64,
      "to": 37.43,
      "sid": 18,
      "location": 2,
      "content": "第二个问题呢就是输出堆顶元素以后"
    },
    {
      "from": 37.43,
      "to": 39.92,
      "sid": 19,
      "location": 2,
      "content": "我们怎么把剩下的元素啊"
    },
    {
      "from": 39.92,
      "to": 41.66,
      "sid": 20,
      "location": 2,
      "content": "调整成一个新的堆"
    },
    {
      "from": 41.66,
      "to": 42.87,
      "sid": 21,
      "location": 2,
      "content": "这样两个问题"
    },
    {
      "from": 42.87,
      "to": 45.71,
      "sid": 22,
      "location": 2,
      "content": "那么首先呢咱们先来解决第二个问题"
    },
    {
      "from": 45.71,
      "to": 47.48,
      "sid": 23,
      "location": 2,
      "content": "因为第二个问题解决了"
    },
    {
      "from": 47.48,
      "to": 49.37,
      "sid": 24,
      "location": 2,
      "content": "第一个问题就很好解决了"
    },
    {
      "from": 49.37,
      "to": 49.73,
      "sid": 25,
      "location": 2,
      "content": "嗯"
    },
    {
      "from": 49.73,
      "to": 52.5,
      "sid": 26,
      "location": 2,
      "content": "我们只需要把无序的调整成堆"
    },
    {
      "from": 52.5,
      "to": 54.3,
      "sid": 27,
      "location": 2,
      "content": "所以我们如果会调整的话"
    },
    {
      "from": 54.3,
      "to": 56.25,
      "sid": 28,
      "location": 2,
      "content": "怎么建队也就会了"
    },
    {
      "from": 56.25,
      "to": 59.25,
      "sid": 29,
      "location": 2,
      "content": "所以接下来呢咱们这一小节就来学习一下"
    },
    {
      "from": 59.25,
      "to": 59.67,
      "sid": 30,
      "location": 2,
      "content": "嗯"
    },
    {
      "from": 59.67,
      "to": 60.81,
      "sid": 31,
      "location": 2,
      "content": "怎么样嗯"
    },
    {
      "from": 60.81,
      "to": 62.739,
      "sid": 32,
      "location": 2,
      "content": "在输出堆顶元素以后"
    },
    {
      "from": 62.739,
      "to": 63.189,
      "sid": 33,
      "location": 2,
      "content": "嗯"
    },
    {
      "from": 63.189,
      "to": 64.959,
      "sid": 34,
      "location": 2,
      "content": "调整剩余的元素"
    },
    {
      "from": 64.959,
      "to": 67.299,
      "sid": 35,
      "location": 2,
      "content": "让它呢重新成为一个堆"
    },
    {
      "from": 67.299,
      "to": 68.71,
      "sid": 36,
      "location": 2,
      "content": "嗯重新成为一个堆"
    },
    {
      "from": 68.71,
      "to": 71.41,
      "sid": 37,
      "location": 2,
      "content": "那么在这儿呢咱们以小根堆为例啊"
    },
    {
      "from": 71.41,
      "to": 73.1,
      "sid": 38,
      "location": 2,
      "content": "以小根堆为例好"
    },
    {
      "from": 73.1,
      "to": 76.98,
      "sid": 39,
      "location": 2,
      "content": "那么首先呢咱们说第一步输出堆顶元素嗯"
    },
    {
      "from": 76.98,
      "to": 78.24,
      "sid": 40,
      "location": 2,
      "content": "对顶元素输出了"
    },
    {
      "from": 78.24,
      "to": 80.64,
      "sid": 41,
      "location": 2,
      "content": "现在呢就没有根了啊"
    },
    {
      "from": 80.64,
      "to": 81.36,
      "sid": 42,
      "location": 2,
      "content": "没有根了"
    },
    {
      "from": 81.36,
      "to": 85.62,
      "sid": 43,
      "location": 2,
      "content": "那我们从堆中呢找最后一个元素来代替它"
    },
    {
      "from": 85.62,
      "to": 87.31,
      "sid": 44,
      "location": 2,
      "content": "那最后一个元素代替它"
    },
    {
      "from": 87.31,
      "to": 89.09,
      "sid": 45,
      "location": 2,
      "content": "最后一个元素是哪一个啊"
    },
    {
      "from": 89.09,
      "to": 92.48,
      "sid": 46,
      "location": 2,
      "content": "编号最大的那个咱们还是从上到下"
    },
    {
      "from": 92.48,
      "to": 94.11,
      "sid": 47,
      "location": 2,
      "content": "从左到右嗯"
    },
    {
      "from": 94.11,
      "to": 96.87,
      "sid": 48,
      "location": 2,
      "content": "一的两个孩子呢是二和三"
    },
    {
      "from": 96.87,
      "to": 99.02,
      "sid": 49,
      "location": 2,
      "content": "二的孩子呢是四五"
    },
    {
      "from": 99.02,
      "to": 101.6,
      "sid": 50,
      "location": 2,
      "content": "三的孩子呢是六七诶"
    },
    {
      "from": 101.6,
      "to": 103.85,
      "sid": 51,
      "location": 2,
      "content": "这样从上到下从左到右哎"
    },
    {
      "from": 103.85,
      "to": 105.2,
      "sid": 52,
      "location": 2,
      "content": "一个一个来编号"
    },
    {
      "from": 105.2,
      "to": 107.17,
      "sid": 53,
      "location": 2,
      "content": "编号最大的那个就是最后一个"
    },
    {
      "from": 107.17,
      "to": 108.75,
      "sid": 54,
      "location": 2,
      "content": "那最后一个代替它"
    },
    {
      "from": 108.75,
      "to": 110.1,
      "sid": 55,
      "location": 2,
      "content": "那么接下来呢"
    },
    {
      "from": 110.1,
      "to": 112.11,
      "sid": 56,
      "location": 2,
      "content": "嗯这个最后一个元素到哪去了"
    },
    {
      "from": 112.11,
      "to": 115.44,
      "sid": 57,
      "location": 2,
      "content": "到咱们这个二传竖的跟上了n"
    },
    {
      "from": 115.44,
      "to": 117.48,
      "sid": 58,
      "location": 2,
      "content": "我们用这个根节点的值"
    },
    {
      "from": 117.48,
      "to": 121.71,
      "sid": 59,
      "location": 2,
      "content": "和它的左右子数的值进行比较嗯进行比较"
    },
    {
      "from": 121.71,
      "to": 125.31,
      "sid": 60,
      "location": 2,
      "content": "然后看一看来看一看谁更小"
    },
    {
      "from": 125.31,
      "to": 128.79,
      "sid": 61,
      "location": 2,
      "content": "我们就和里头这个比较小的进行交换"
    },
    {
      "from": 128.79,
      "to": 131.14,
      "sid": 62,
      "location": 2,
      "content": "为什么和比较小的进行交换啊"
    },
    {
      "from": 131.14,
      "to": 132.76,
      "sid": 63,
      "location": 2,
      "content": "咱们说了小根堆呢"
    },
    {
      "from": 132.76,
      "to": 134.2,
      "sid": 64,
      "location": 2,
      "content": "它要求根比较小"
    },
    {
      "from": 134.2,
      "to": 134.95,
      "sid": 65,
      "location": 2,
      "content": "是不是啊"
    },
    {
      "from": 134.95,
      "to": 137.29,
      "sid": 66,
      "location": 2,
      "content": "哎所以要跟这个比较小的交换"
    },
    {
      "from": 137.29,
      "to": 138.82,
      "sid": 67,
      "location": 2,
      "content": "小的上上面来嗯"
    },
    {
      "from": 138.82,
      "to": 140.33,
      "sid": 68,
      "location": 2,
      "content": "是上面好"
    },
    {
      "from": 140.33,
      "to": 143.78,
      "sid": 69,
      "location": 2,
      "content": "那么接下来我们说一直要反复这个过程啊"
    },
    {
      "from": 143.78,
      "to": 144.71,
      "sid": 70,
      "location": 2,
      "content": "它交换了以后"
    },
    {
      "from": 144.71,
      "to": 145.88,
      "sid": 71,
      "location": 2,
      "content": "他不就下来了吗"
    },
    {
      "from": 145.88,
      "to": 146.78,
      "sid": 72,
      "location": 2,
      "content": "下来之后呢"
    },
    {
      "from": 146.78,
      "to": 150.91,
      "sid": 73,
      "location": 2,
      "content": "我们再让他跟他的左右孩子进行比较嗯"
    },
    {
      "from": 150.91,
      "to": 152.77,
      "sid": 74,
      "location": 2,
      "content": "再挑小的上来嗯"
    },
    {
      "from": 152.77,
      "to": 154.48,
      "sid": 75,
      "location": 2,
      "content": "再下去了之后再找"
    },
    {
      "from": 154.48,
      "to": 155.59,
      "sid": 76,
      "location": 2,
      "content": "直到它什么呢"
    },
    {
      "from": 155.59,
      "to": 157.56,
      "sid": 77,
      "location": 2,
      "content": "下到它成为叶子了"
    },
    {
      "from": 157.56,
      "to": 159.3,
      "sid": 78,
      "location": 2,
      "content": "他在没有左右孩子了"
    },
    {
      "from": 159.3,
      "to": 161.1,
      "sid": 79,
      "location": 2,
      "content": "那这个时候就不用再找了"
    },
    {
      "from": 161.1,
      "to": 165.399,
      "sid": 80,
      "location": 2,
      "content": "这个时候呢咱们嗯得到的这一个二叉树呢"
    },
    {
      "from": 165.399,
      "to": 167.379,
      "sid": 81,
      "location": 2,
      "content": "已经是一个新的堆了"
    },
    {
      "from": 167.379,
      "to": 169.379,
      "sid": 82,
      "location": 2,
      "content": "嗯已经是一个新的对"
    },
    {
      "from": 169.379,
      "to": 171.239,
      "sid": 83,
      "location": 2,
      "content": "这就是咱们的调整过程"
    },
    {
      "from": 171.239,
      "to": 172.709,
      "sid": 84,
      "location": 2,
      "content": "那么这个调整过程呢"
    },
    {
      "from": 172.709,
      "to": 176.03,
      "sid": 85,
      "location": 2,
      "content": "我们通常称作筛选过程啊"
    },
    {
      "from": 176.03,
      "to": 176.87,
      "sid": 86,
      "location": 2,
      "content": "筛选过程"
    },
    {
      "from": 176.87,
      "to": 180.53,
      "sid": 87,
      "location": 2,
      "content": "我们呢要从嗯这些剩余的元素当中"
    },
    {
      "from": 180.53,
      "to": 183.1,
      "sid": 88,
      "location": 2,
      "content": "筛选出来一个嗯筛选出来的"
    },
    {
      "from": 183.299,
      "to": 185.699,
      "sid": 89,
      "location": 2,
      "content": "这是呢输出堆顶"
    },
    {
      "from": 185.699,
      "to": 188.769,
      "sid": 90,
      "location": 2,
      "content": "元素调整成一个新的小根堆"
    },
    {
      "from": 188.769,
      "to": 191.679,
      "sid": 91,
      "location": 2,
      "content": "那么如果我们是大根堆呢"
    },
    {
      "from": 191.679,
      "to": 193.029,
      "sid": 92,
      "location": 2,
      "content": "嗯输出最大的"
    },
    {
      "from": 193.029,
      "to": 195.36,
      "sid": 93,
      "location": 2,
      "content": "那剩余元素调整成一个大根堆"
    },
    {
      "from": 195.36,
      "to": 196.74,
      "sid": 94,
      "location": 2,
      "content": "那怎么调整啊"
    },
    {
      "from": 196.74,
      "to": 198.36,
      "sid": 95,
      "location": 2,
      "content": "我们说思路是一样的"
    },
    {
      "from": 198.36,
      "to": 201.79,
      "sid": 96,
      "location": 2,
      "content": "输出堆顶之后用最后一个元素代替它"
    },
    {
      "from": 201.79,
      "to": 204.13,
      "sid": 97,
      "location": 2,
      "content": "然后接下来用这个元素和它的左"
    },
    {
      "from": 204.13,
      "to": 205.75,
      "sid": 98,
      "location": 2,
      "content": "右子树的根"
    },
    {
      "from": 205.75,
      "to": 208.69,
      "sid": 99,
      "location": 2,
      "content": "左右子树的根实际上就是它的左右孩子嗯"
    },
    {
      "from": 208.69,
      "to": 211.33,
      "sid": 100,
      "location": 2,
      "content": "哎其中呢找一个大的大根"
    },
    {
      "from": 211.33,
      "to": 211.87,
      "sid": 101,
      "location": 2,
      "content": "大根嘛"
    },
    {
      "from": 211.87,
      "to": 213.43,
      "sid": 102,
      "location": 2,
      "content": "根得大是不是呃"
    },
    {
      "from": 213.43,
      "to": 216.17,
      "sid": 103,
      "location": 2,
      "content": "所以呢要找一个大的和它进行交换"
    },
    {
      "from": 216.17,
      "to": 217.25,
      "sid": 104,
      "location": 2,
      "content": "然后一次一次"
    },
    {
      "from": 217.25,
      "to": 217.85,
      "sid": 105,
      "location": 2,
      "content": "一直呢"
    },
    {
      "from": 217.85,
      "to": 221.33,
      "sid": 106,
      "location": 2,
      "content": "到这个元素也是被调整到叶子就结束了"
    },
    {
      "from": 221.33,
      "to": 225.0,
      "sid": 107,
      "location": 2,
      "content": "嗯好接下来呢同学们来看一个例子"
    },
    {
      "from": 225.0,
      "to": 225.55,
      "sid": 108,
      "location": 2,
      "content": "嗯"
    },
    {
      "from": 225.55,
      "to": 229.57,
      "sid": 109,
      "location": 2,
      "content": "这个现在同学们看到的这一棵完全二叉"
    },
    {
      "from": 229.57,
      "to": 232.27,
      "sid": 110,
      "location": 2,
      "content": "树呢就已经是一个小根堆了"
    },
    {
      "from": 232.27,
      "to": 232.84,
      "sid": 111,
      "location": 2,
      "content": "嗯"
    },
    {
      "from": 232.84,
      "to": 233.32,
      "sid": 112,
      "location": 2,
      "content": "好"
    },
    {
      "from": 233.32,
      "to": 236.65,
      "sid": 113,
      "location": 2,
      "content": "接下来呢我们说我们在排序的过程当中呢"
    },
    {
      "from": 236.65,
      "to": 239.6,
      "sid": 114,
      "location": 2,
      "content": "需要先输出堆顶元素啊"
    },
    {
      "from": 239.6,
      "to": 241.07,
      "sid": 115,
      "location": 2,
      "content": "是输出堆顶元素"
    },
    {
      "from": 241.07,
      "to": 244.69,
      "sid": 116,
      "location": 2,
      "content": "我们把这个13输出输出了之后呢"
    },
    {
      "from": 244.69,
      "to": 246.28,
      "sid": 117,
      "location": 2,
      "content": "我们说没有这个堆顶了"
    },
    {
      "from": 246.28,
      "to": 247.84,
      "sid": 118,
      "location": 2,
      "content": "接下来要干什么呢"
    },
    {
      "from": 247.84,
      "to": 251.22,
      "sid": 119,
      "location": 2,
      "content": "哎接下来用最后一个元素来代替它"
    },
    {
      "from": 251.22,
      "to": 253.68,
      "sid": 120,
      "location": 2,
      "content": "那最后一个元素是打到咱们刚才说了"
    },
    {
      "from": 253.68,
      "to": 254.4,
      "sid": 121,
      "location": 2,
      "content": "从上到下"
    },
    {
      "from": 254.4,
      "to": 255.93,
      "sid": 122,
      "location": 2,
      "content": "从左到右进行编号"
    },
    {
      "from": 255.93,
      "to": 257.4,
      "sid": 123,
      "location": 2,
      "content": "编号最大的那个嗯"
    },
    {
      "from": 257.4,
      "to": 259.95,
      "sid": 124,
      "location": 2,
      "content": "他就是一层一层的来一层一层来"
    },
    {
      "from": 259.95,
      "to": 261.42,
      "sid": 125,
      "location": 2,
      "content": "他是最后一个"
