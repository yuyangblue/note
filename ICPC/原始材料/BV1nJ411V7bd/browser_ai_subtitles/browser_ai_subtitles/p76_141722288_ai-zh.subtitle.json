    {
      "from": 39.97,
      "to": 43.48,
      "sid": 15,
      "location": 2,
      "content": "以及呢线性结构的推广字符串数组"
    },
    {
      "from": 43.48,
      "to": 44.74,
      "sid": 16,
      "location": 2,
      "content": "还有广义表"
    },
    {
      "from": 44.74,
      "to": 47.62,
      "sid": 17,
      "location": 2,
      "content": "那么线性结构它的特点是什么呢"
    },
    {
      "from": 47.62,
      "to": 49.12,
      "sid": 18,
      "location": 2,
      "content": "诶它的特点是"
    },
    {
      "from": 49.12,
      "to": 52.169,
      "sid": 19,
      "location": 2,
      "content": "这个线性结构当中存储的数据"
    },
    {
      "from": 52.169,
      "to": 55.379,
      "sid": 20,
      "location": 2,
      "content": "元素的逻辑结构是一对一的"
    },
    {
      "from": 55.379,
      "to": 56.9,
      "sid": 21,
      "location": 2,
      "content": "什么叫一对一来着"
    },
    {
      "from": 56.9,
      "to": 57.38,
      "sid": 22,
      "location": 2,
      "content": "嗯"
    },
    {
      "from": 57.38,
      "to": 61.1,
      "sid": 23,
      "location": 2,
      "content": "是说这个元素的前驱和后继的个数"
    },
    {
      "from": 61.1,
      "to": 62.29,
      "sid": 24,
      "location": 2,
      "content": "都是唯一的"
    },
    {
      "from": 62.29,
      "to": 64.81,
      "sid": 25,
      "location": 2,
      "content": "那么对于非线性结构啊"
    },
    {
      "from": 64.81,
      "to": 69.159,
      "sid": 26,
      "location": 2,
      "content": "这个元素的前驱和后继的个数就不唯一了"
    },
    {
      "from": 72.729,
      "to": 76.2,
      "sid": 27,
      "location": 2,
      "content": "它的前驱的个数仍然是唯一的"
    },
    {
      "from": 76.2,
      "to": 78.42,
      "sid": 28,
      "location": 2,
      "content": "但是呢后期的个数为一"
    },
    {
      "from": 78.42,
      "to": 79.96,
      "sid": 29,
      "location": 2,
      "content": "可以有多个后继"
    },
    {
      "from": 79.96,
      "to": 82.36,
      "sid": 30,
      "location": 2,
      "content": "所以呢我们说它是一对n的"
    },
    {
      "from": 82.36,
      "to": 85.66,
      "sid": 31,
      "location": 2,
      "content": "按元素之间的关系是一对n的一个元素"
    },
    {
      "from": 85.66,
      "to": 88.08,
      "sid": 32,
      "location": 2,
      "content": "后面可以有多个后继"
    },
    {
      "from": 88.08,
      "to": 91.36,
      "sid": 33,
      "location": 2,
      "content": "但是呢一个元素前面只能有一个前区"
    },
    {
      "from": 91.36,
      "to": 94.36,
      "sid": 34,
      "location": 2,
      "content": "那么图形结构呢就是多对多的"
    },
    {
      "from": 94.36,
      "to": 97.3,
      "sid": 35,
      "location": 2,
      "content": "每个元素后面都可以有多个后记"
    },
    {
      "from": 97.3,
      "to": 100.35,
      "sid": 36,
      "location": 2,
      "content": "每个元素前面也可以有多个前驱"
    },
    {
      "from": 100.35,
      "to": 101.16,
      "sid": 37,
      "location": 2,
      "content": "嗯"
    },
    {
      "from": 101.16,
      "to": 102.0,
      "sid": 38,
      "location": 2,
      "content": "好"
    },
    {
      "from": 102.0,
      "to": 106.18,
      "sid": 39,
      "location": 2,
      "content": "那咱们首先来研究第五章的第一节"
    },
    {
      "from": 106.18,
      "to": 107.71,
      "sid": 40,
      "location": 2,
      "content": "这个树形结构"
    },
    {
      "from": 107.71,
      "to": 112.12,
      "sid": 41,
      "location": 2,
      "content": "树形结构也就咱们说它的解数据元素啊"
    },
    {
      "from": 112.12,
      "to": 113.8,
      "sid": 42,
      "location": 2,
      "content": "也就是这个节点"
    },
    {
      "from": 113.8,
      "to": 115.68,
      "sid": 43,
      "location": 2,
      "content": "咱们称呼做节点嗯"
    },
    {
      "from": 115.68,
      "to": 118.08,
      "sid": 44,
      "location": 2,
      "content": "这个节点之间呢是有分支的"
    },
    {
      "from": 120.74,
      "to": 122.0,
      "sid": 45,
      "location": 2,
      "content": "那么这多个元素呢"
    },
    {
      "from": 122.0,
      "to": 125.8,
      "sid": 46,
      "location": 2,
      "content": "我们说唉是在同一个层次上"
    },
    {
      "from": 125.8,
      "to": 128.89,
      "sid": 47,
      "location": 2,
      "content": "所以我们通常用树形结构来描述"
    },
    {
      "from": 128.89,
      "to": 131.96,
      "sid": 48,
      "location": 2,
      "content": "具有层次关系的数据结构嗯"
    },
    {
      "from": 131.96,
      "to": 134.029,
      "sid": 49,
      "location": 2,
      "content": "所以它的应用非常广泛"
    },
    {
      "from": 134.029,
      "to": 136.849,
      "sid": 50,
      "location": 2,
      "content": "咱们现实世界当中嗯"
    },
    {
      "from": 136.849,
      "to": 138.259,
      "sid": 51,
      "location": 2,
      "content": "这个自然界的树"
    },
    {
      "from": 138.259,
      "to": 141.0,
      "sid": 52,
      "location": 2,
      "content": "人类社会当中的家谱啊"
    },
    {
      "from": 141.0,
      "to": 142.53,
      "sid": 53,
      "location": 2,
      "content": "还有组织机构啊"
    },
    {
      "from": 142.53,
      "to": 144.75,
      "sid": 54,
      "location": 2,
      "content": "唉都是这种层次关系嗯"
    },
    {
      "from": 144.75,
      "to": 145.579,
      "sid": 55,
      "location": 2,
      "content": "层次关系"
    },
    {
      "from": 145.579,
      "to": 147.439,
      "sid": 56,
      "location": 2,
      "content": "那在咱们计算机领域当中"
    },
    {
      "from": 147.439,
      "to": 149.149,
      "sid": 57,
      "location": 2,
      "content": "的应用就更广泛了"
    },
    {
      "from": 149.149,
      "to": 151.099,
      "sid": 58,
      "location": 2,
      "content": "嗯比如说在编译的时候"
    },
    {
      "from": 151.099,
      "to": 154.98,
      "sid": 59,
      "location": 2,
      "content": "我们用数来表示原程序的语法结构"
    },
    {
      "from": 154.98,
      "to": 156.78,
      "sid": 60,
      "location": 2,
      "content": "在数据库系统当中"
    },
    {
      "from": 156.78,
      "to": 159.66,
      "sid": 61,
      "location": 2,
      "content": "我们可以用数来组织信息"
    },
    {
      "from": 159.66,
      "to": 161.7,
      "sid": 62,
      "location": 2,
      "content": "嗯在算法分析的时候呢"
    },
    {
      "from": 161.7,
      "to": 164.959,
      "sid": 63,
      "location": 2,
      "content": "我们可以用数来描述这个执行过程"
    },
    {
      "from": 164.959,
      "to": 167.39,
      "sid": 64,
      "location": 2,
      "content": "那么后面呢咱们学到嗯"
    },
    {
      "from": 167.39,
      "to": 169.01,
      "sid": 65,
      "location": 2,
      "content": "数的这个应用的时候"
    },
    {
      "from": 169.01,
      "to": 170.69,
      "sid": 66,
      "location": 2,
      "content": "同学们就可以发现哎"
    },
    {
      "from": 170.69,
      "to": 173.42,
      "sid": 67,
      "location": 2,
      "content": "这个数的应用呢非常非常的多"
    },
    {
      "from": 173.42,
      "to": 174.99,
      "sid": 68,
      "location": 2,
      "content": "非常非常的广泛"
    },
    {
      "from": 174.99,
      "to": 175.89,
      "sid": 69,
      "location": 2,
      "content": "好的"
    },
    {
      "from": 175.89,
      "to": 178.94,
      "sid": 70,
      "location": 2,
      "content": "那么接下来咱们就先来看看这个数的定义"
    },
    {
      "from": 178.94,
      "to": 180.21,
      "sid": 71,
      "location": 2,
      "content": "那什么是树啊"
    },
    {
      "from": 183.39,
      "to": 184.59,
      "sid": 72,
      "location": 2,
      "content": "一个有限集合"
    },
    {
      "from": 184.59,
      "to": 187.35,
      "sid": 73,
      "location": 2,
      "content": "n n还是大于等于零的嗯"
    },
    {
      "from": 187.35,
      "to": 188.61,
      "sid": 74,
      "location": 2,
      "content": "n还是大于等于零"
    },
    {
      "from": 188.61,
      "to": 190.23,
      "sid": 75,
      "location": 2,
      "content": "那么这个等于零"
    },
    {
      "from": 190.23,
      "to": 193.5,
      "sid": 76,
      "location": 2,
      "content": "没有元素的数我们就称作空数嗯"
    },
    {
      "from": 193.5,
      "to": 194.76,
      "sid": 77,
      "location": 2,
      "content": "称作空数"
    },
    {
      "from": 194.76,
      "to": 196.26,
      "sid": 78,
      "location": 2,
      "content": "那么如果有元素"
    },
    {
      "from": 196.26,
      "to": 199.98,
      "sid": 79,
      "location": 2,
      "content": "这些元素呢我们说又可以分成两个部分啊"
    },
    {
      "from": 199.98,
      "to": 201.01,
      "sid": 80,
      "location": 2,
      "content": "分成两个部分"
    },
    {
      "from": 201.01,
      "to": 204.49,
      "sid": 81,
      "location": 2,
      "content": "其中有一个元素呢有且仅有一个嗯"
    },
    {
      "from": 204.49,
      "to": 205.65,
      "sid": 82,
      "location": 2,
      "content": "有一个元素呢"
    },
    {
      "from": 205.65,
      "to": 209.07,
      "sid": 83,
      "location": 2,
      "content": "唉这个特定的元素我们称作这个根啊"
    },
    {
      "from": 209.07,
      "to": 209.93,
      "sid": 84,
      "location": 2,
      "content": "称作根"
    },
    {
      "from": 209.93,
      "to": 211.31,
      "sid": 85,
      "location": 2,
      "content": "那么其余的元素"
    },
    {
      "from": 211.31,
      "to": 213.53,
      "sid": 86,
      "location": 2,
      "content": "我们又可以把它分成若干个"
    },
    {
      "from": 213.53,
      "to": 214.85,
      "sid": 87,
      "location": 2,
      "content": "我们用m来表示"
    },
    {
      "from": 214.85,
      "to": 218.43,
      "sid": 88,
      "location": 2,
      "content": "n分成m个不相交的集合嗯"
    },
    {
      "from": 218.43,
      "to": 220.23,
      "sid": 89,
      "location": 2,
      "content": "不相交的集合哎"
    },
    {
      "from": 220.23,
      "to": 223.98,
      "sid": 90,
      "location": 2,
      "content": "每一个集合呢它又是一个有限集嗯"
    },
    {
      "from": 223.98,
      "to": 228.31,
      "sid": 91,
      "location": 2,
      "content": "这m个不相交的集合我们称作什么呢"
    },
    {
      "from": 228.31,
      "to": 231.6,
      "sid": 92,
      "location": 2,
      "content": "称作这个根的子树嗯"
    },
    {
      "from": 231.6,
      "to": 233.82,
      "sid": 93,
      "location": 2,
      "content": "也就是说这m个不相交的集合"
    },
    {
      "from": 233.82,
      "to": 235.53,
      "sid": 94,
      "location": 2,
      "content": "本身又是一棵树"
    },
    {
      "from": 235.53,
      "to": 235.92,
      "sid": 95,
      "location": 2,
      "content": "嗯"
    },
    {
      "from": 235.92,
      "to": 236.79,
      "sid": 96,
      "location": 2,
      "content": "怎么理解呢"
    },
    {
      "from": 236.79,
      "to": 238.61,
      "sid": 97,
      "location": 2,
      "content": "比如说我们有一个树嗯"
    },
    {
      "from": 238.61,
      "to": 241.6,
      "sid": 98,
      "location": 2,
      "content": "这个数当中有n个元素嗯"
    },
    {
      "from": 241.6,
      "to": 246.29,
      "sid": 99,
      "location": 2,
      "content": "其中有一个元素呢我们看成是这个根"
    },
    {
      "from": 246.29,
      "to": 249.93,
      "sid": 100,
      "location": 2,
      "content": "其余的元素呢把它分成几个集合"
    },
    {
      "from": 249.93,
      "to": 254.13,
      "sid": 101,
      "location": 2,
      "content": "这几个集合呢就叫做这个根的子树嗯"
    },
    {
      "from": 254.13,
      "to": 256.41,
      "sid": 102,
      "location": 2,
      "content": "这几个集合仍然是有限集合"
    },
    {
      "from": 256.41,
      "to": 259.069,
      "sid": 103,
      "location": 2,
      "content": "n叫做这个根的子数诶"
    },
    {
      "from": 259.069,
      "to": 261.349,
      "sid": 104,
      "location": 2,
      "content": "那么这个子数是怎么组成的呢"
    },
    {
      "from": 261.349,
      "to": 263.89,
      "sid": 105,
      "location": 2,
      "content": "诶子数我们说仍然是数嗯"
    },
    {
      "from": 263.89,
      "to": 264.85,
      "sid": 106,
      "location": 2,
      "content": "这个指数呢"
    },
    {
      "from": 264.85,
      "to": 268.81,
      "sid": 107,
      "location": 2,
      "content": "我们又可以看成是有一个根元素"
    },
    {
      "from": 268.81,
      "to": 272.7,
      "sid": 108,
      "location": 2,
      "content": "然后呢其他的元素分成几个集合嗯"
    },
    {
      "from": 272.7,
      "to": 277.52,
      "sid": 109,
      "location": 2,
      "content": "叫做这个唉这棵树这棵子树的字数哎"
    },
    {
      "from": 277.52,
      "to": 278.45,
      "sid": 110,
      "location": 2,
      "content": "就这样分的"
    },
    {
      "from": 278.45,
      "to": 281.66,
      "sid": 111,
      "location": 2,
      "content": "那么同学们看出来了这个数的定义啊"
    },
    {
      "from": 281.66,
      "to": 283.81,
      "sid": 112,
      "location": 2,
      "content": "它是一个递归的定义"
    },
    {
      "from": 283.81,
      "to": 285.28,
      "sid": 113,
      "location": 2,
      "content": "树是怎么组成的呢"
    },
    {
      "from": 285.28,
      "to": 287.17,
      "sid": 114,
      "location": 2,
      "content": "由根和子数组成的"
    },
    {
      "from": 287.17,
      "to": 288.4,
      "sid": 115,
      "location": 2,
      "content": "那子数是什么呢"
    },
    {
      "from": 288.4,
      "to": 288.73,
      "sid": 116,
      "location": 2,
      "content": "啊"
    },
    {
      "from": 288.73,
      "to": 292.91,
      "sid": 117,
      "location": 2,
      "content": "又是由这个子树的根和子数的指数构成的"
    },
    {
      "from": 292.91,
      "to": 293.24,
      "sid": 118,
      "location": 2,
      "content": "嗯"
    },
    {
      "from": 293.24,
      "to": 297.26,
      "sid": 119,
      "location": 2,
      "content": "它是这样的一个嗯递归的嵌套的定义"
    },
    {
      "from": 297.26,
      "to": 299.66,
      "sid": 120,
      "location": 2,
      "content": "嗯递归的嵌套的定义诶"
    },
    {
      "from": 299.66,
      "to": 302.04,
      "sid": 121,
      "location": 2,
      "content": "那么我们发现了这个数啊"
    },
    {
      "from": 302.04,
      "to": 305.21,
      "sid": 122,
      "location": 2,
      "content": "它的结构就是这样递归的结构"
    },
    {
      "from": 305.21,
      "to": 309.159,
      "sid": 123,
      "location": 2,
      "content": "所以呢咱们在后面对事物进行操作的时候"
    },
    {
      "from": 309.159,
      "to": 313.269,
      "sid": 124,
      "location": 2,
      "content": "我们通常会用到递归的算法来操作嗯"
    },
    {
      "from": 313.269,
      "to": 314.649,
      "sid": 125,
      "location": 2,
      "content": "来操作好的"
    },
    {
      "from": 314.649,
      "to": 317.24,
