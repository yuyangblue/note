  "body": [
    {
      "from": 1.56,
      "to": 2.46,
      "sid": 1,
      "location": 2,
      "content": "同学们好"
    },
    {
      "from": 6.18,
      "to": 9.04,
      "sid": 2,
      "location": 2,
      "content": "线性表的顺序表示和实现"
    },
    {
      "from": 13.03,
      "to": 15.92,
      "sid": 3,
      "location": 2,
      "content": "那么这些操作如何来实现呢"
    },
    {
      "from": 16.079,
      "to": 20.8,
      "sid": 4,
      "location": 2,
      "content": "那我们说这要取决于这个线性表如何存储"
    },
    {
      "from": 24.94,
      "to": 29.439,
      "sid": 5,
      "location": 2,
      "content": "那么线性表呢嗯采用两种基本的"
    },
    {
      "from": 29.439,
      "to": 31.449,
      "sid": 6,
      "location": 2,
      "content": "一种是顺序存储结构"
    },
    {
      "from": 31.449,
      "to": 33.76,
      "sid": 7,
      "location": 2,
      "content": "另一种呢是链式存储结构"
    },
    {
      "from": 37.15,
      "to": 39.1,
      "sid": 8,
      "location": 2,
      "content": "然后看看在这两种结构上"
    },
    {
      "from": 39.1,
      "to": 42.839,
      "sid": 9,
      "location": 2,
      "content": "我们该如何实现这个线性表的重要操作"
    },
    {
      "from": 44.04,
      "to": 49.5,
      "sid": 10,
      "location": 2,
      "content": "那么第四节呢嗯第二章的第四节呢就介绍线性表嗯"
    },
    {
      "from": 49.5,
      "to": 51.78,
      "sid": 11,
      "location": 2,
      "content": "用顺序存储结构来存储"
    },
    {
      "from": 51.78,
      "to": 53.73,
      "sid": 12,
      "location": 2,
      "content": "那么它是怎么表示的"
    },
    {
      "from": 53.73,
      "to": 56.86,
      "sid": 13,
      "location": 2,
      "content": "以及如何来实现基本操作"
    },
    {
      "from": 56.86,
      "to": 60.31,
      "sid": 14,
      "location": 2,
      "content": "那么第二章第五节呢就是接上这个线性表"
    },
    {
      "from": 60.31,
      "to": 62.74,
      "sid": 15,
      "location": 2,
      "content": "用链式存储结构来存储诶"
    },
    {
      "from": 62.74,
      "to": 65.08,
      "sid": 16,
      "location": 2,
      "content": "如何表示如何实现基本操作"
    },
    {
      "from": 70.08,
      "to": 74.43,
      "sid": 17,
      "location": 2,
      "content": "给大家介绍顺序表上的一些重要的算法诶"
    },
    {
      "from": 79.38,
      "to": 83.95,
      "sid": 18,
      "location": 2,
      "content": "那么首先呢咱们来看一下线性表的顺序存储结构"
    },
    {
      "from": 83.95,
      "to": 86.89,
      "sid": 19,
      "location": 2,
      "content": "我们说线性表的顺序表示嗯"
    },
    {
      "from": 86.89,
      "to": 89.53,
      "sid": 20,
      "location": 2,
      "content": "顺序表示又称为顺序存储结构"
    },
    {
      "from": 89.53,
      "to": 91.53,
      "sid": 21,
      "location": 2,
      "content": "或者叫做顺序映像"
    },
    {
      "from": 91.53,
      "to": 92.85,
      "sid": 22,
      "location": 2,
      "content": "那么什么意思呢"
    },
    {
      "from": 92.85,
      "to": 100.03,
      "sid": 23,
      "location": 2,
      "content": "就是说我们把逻辑上相邻的数据元素存储在物理位置上"
    },
    {
      "from": 100.03,
      "to": 102.22,
      "sid": 24,
      "location": 2,
      "content": "也相邻的存储单元里头"
    },
    {
      "from": 102.22,
      "to": 102.74,
      "sid": 25,
      "location": 2,
      "content": "嗯"
    },
    {
      "from": 102.74,
      "to": 104.78,
      "sid": 26,
      "location": 2,
      "content": "比如说线性表a1 a2 "
    },
    {
      "from": 104.78,
      "to": 106.76,
      "sid": 27,
      "location": 2,
      "content": "意识到a n这n个元素"
    },
    {
      "from": 106.76,
      "to": 109.5,
      "sid": 28,
      "location": 2,
      "content": "它们逻辑上存在着相邻的关系"
    },
    {
      "from": 109.5,
      "to": 109.86,
      "sid": 29,
      "location": 2,
      "content": "诶"
    },
    {
      "from": 109.86,
      "to": 111.18,
      "sid": 30,
      "location": 2,
      "content": "这是咱们说的线性表"
    },
    {
      "from": 111.18,
      "to": 114.28,
      "sid": 31,
      "location": 2,
      "content": "它的逻辑结构呢是一个线性结构呃"
    },
    {
      "from": 114.28,
      "to": 115.45,
      "sid": 32,
      "location": 2,
      "content": "任意一个元素"
    },
    {
      "from": 115.45,
      "to": 116.729,
      "sid": 33,
      "location": 2,
      "content": "任意一个元素"
    },
    {
      "from": 116.729,
      "to": 118.949,
      "sid": 34,
      "location": 2,
      "content": "除了第一个和最后一个"
    },
    {
      "from": 118.949,
      "to": 120.329,
      "sid": 35,
      "location": 2,
      "content": "第一个没有前驱"
    },
    {
      "from": 120.329,
      "to": 123.63,
      "sid": 36,
      "location": 2,
      "content": "最后一个呢没有后继诶"
    },
    {
      "from": 123.63,
      "to": 125.01,
      "sid": 37,
      "location": 2,
      "content": "除了这两个元素之外"
    },
    {
      "from": 125.01,
      "to": 128.25,
      "sid": 38,
      "location": 2,
      "content": "任意一个元素都有且只有一个前期"
    },
    {
      "from": 128.25,
      "to": 129.6,
      "sid": 39,
      "location": 2,
      "content": "有且只有一个后继"
    },
    {
      "from": 129.6,
      "to": 132.0,
      "sid": 40,
      "location": 2,
      "content": "这就是它内在的逻辑关系嗯"
    },
    {
      "from": 132.0,
      "to": 133.99,
      "sid": 41,
      "location": 2,
      "content": "也称作逻辑结构"
    },
    {
      "from": 133.99,
      "to": 138.61,
      "sid": 42,
      "location": 2,
      "content": "那么我们在存储这些数据元素的时候"
    },
    {
      "from": 138.61,
      "to": 143.67,
      "sid": 43,
      "location": 2,
      "content": "如何把这些数据元素本身存储上以外"
    },
    {
      "from": 143.67,
      "to": 146.97,
      "sid": 44,
      "location": 2,
      "content": "还把数据元素之间的这个逻辑结构"
    },
    {
      "from": 146.97,
      "to": 149.4,
      "sid": 45,
      "location": 2,
      "content": "逻辑关系也存储上呢"
    },
    {
      "from": 149.4,
      "to": 151.35,
      "sid": 46,
      "location": 2,
      "content": "哎顺序结构嗯"
    },
    {
      "from": 151.35,
      "to": 155.58,
      "sid": 47,
      "location": 2,
      "content": "这个嗯顺序存储结构它是这样做的"
    },
    {
      "from": 155.66,
      "to": 157.16,
      "sid": 48,
      "location": 2,
      "content": "他是这样做的"
    },
    {
      "from": 157.16,
      "to": 158.45,
      "sid": 49,
      "location": 2,
      "content": "我们来看一下嗯"
    },
    {
      "from": 158.45,
      "to": 165.11,
      "sid": 50,
      "location": 2,
      "content": "我们说他把这个嗯逻辑上逻辑上相邻的元素在存储的时候呢"
    },
    {
      "from": 165.11,
      "to": 167.73,
      "sid": 51,
      "location": 2,
      "content": "这个物理位置仍然相邻嗯"
    },
    {
      "from": 167.73,
      "to": 170.58,
      "sid": 52,
      "location": 2,
      "content": "诶我们先把第一个元素存上"
    },
    {
      "from": 170.58,
      "to": 172.92,
      "sid": 53,
      "location": 2,
      "content": "然后呢就在第一个元素的后面"
    },
    {
      "from": 172.92,
      "to": 175.02,
      "sid": 54,
      "location": 2,
      "content": "这个把第二个元素存上"
    },
    {
      "from": 175.02,
      "to": 179.55,
      "sid": 55,
      "location": 2,
      "content": "那么在线性表当中相邻的两个元素嗯"
    },
    {
      "from": 179.55,
      "to": 182.54,
      "sid": 56,
      "location": 2,
      "content": "a一是a2 的前驱嗯"
    },
    {
      "from": 182.54,
      "to": 186.0,
      "sid": 57,
      "location": 2,
      "content": "前驱a2 呢是a一的后继嗯"
    },
    {
      "from": 186.0,
      "to": 188.1,
      "sid": 58,
      "location": 2,
      "content": "有这样的先后关系哎"
    },
    {
      "from": 188.1,
      "to": 189.66,
      "sid": 59,
      "location": 2,
      "content": "我们在存储的时候呢"
    },
    {
      "from": 189.66,
      "to": 191.64,
      "sid": 60,
      "location": 2,
      "content": "也让他们两个相邻嗯"
    },
    {
      "from": 191.64,
      "to": 194.4,
      "sid": 61,
      "location": 2,
      "content": "而且把这个相互之间的先后关系"
    },
    {
      "from": 194.4,
      "to": 196.2,
      "sid": 62,
      "location": 2,
      "content": "谁是谁的前驱"
    },
    {
      "from": 196.2,
      "to": 197.64,
      "sid": 63,
      "location": 2,
      "content": "谁是谁的后继哎"
    },
    {
      "from": 197.64,
      "to": 199.14,
      "sid": 64,
      "location": 2,
      "content": "把它表示清楚嗯"
    },
    {
      "from": 199.14,
      "to": 200.34,
      "sid": 65,
      "location": 2,
      "content": "把它表示清楚诶"
    },
    {
      "from": 200.34,
      "to": 203.49,
      "sid": 66,
      "location": 2,
      "content": "这样呢我们就可以把他们的逻辑关系表示出来了"
    },
    {
      "from": 203.49,
      "to": 205.94,
      "sid": 67,
      "location": 2,
      "content": "嗯那么所有的数据元素呢"
    },
    {
      "from": 205.94,
      "to": 208.07,
      "sid": 68,
      "location": 2,
      "content": "我们都这样一一去存储"
    },
    {
      "from": 208.07,
      "to": 210.73,
      "sid": 69,
      "location": 2,
      "content": "这就是咱们说的逻辑结构嗯"
    },
    {
      "from": 210.73,
      "to": 215.26,
      "sid": 70,
      "location": 2,
      "content": "在这个这个存储器上的映射"
    },
    {
      "from": 215.26,
      "to": 217.95,
      "sid": 71,
      "location": 2,
      "content": "这个是映射或者是叫做映像"
    },
    {
      "from": 217.95,
      "to": 219.99,
      "sid": 72,
      "location": 2,
      "content": "也称作物理结构诶"
    },
    {
      "from": 219.99,
      "to": 223.04,
      "sid": 73,
      "location": 2,
      "content": "这就是咱们说的物理结构或者是存储结构"
    },
    {
      "from": 223.04,
      "to": 225.05,
      "sid": 74,
      "location": 2,
      "content": "它是这些元素的一印象"
    },
    {
      "from": 225.05,
      "to": 227.81,
      "sid": 75,
      "location": 2,
      "content": "它不仅把这些元素本身存出来了"
    },
    {
      "from": 227.81,
      "to": 229.01,
      "sid": 76,
      "location": 2,
      "content": "存储起来了"
    },
    {
      "from": 229.01,
      "to": 234.76,
      "sid": 77,
      "location": 2,
      "content": "而且呢把这些元素之间的关系利用这个嗯存储单元的先后位置"
    },
    {
      "from": 234.76,
      "to": 235.66,
      "sid": 78,
      "location": 2,
      "content": "把存储"
    },
    {
      "from": 235.66,
      "to": 239.35,
      "sid": 79,
      "location": 2,
      "content": "把这个数据元素之间的关系也存储起来了"
    },
    {
      "from": 239.35,
      "to": 240.79,
      "sid": 80,
      "location": 2,
      "content": "那么我们简单的说呢"
    },
    {
      "from": 240.79,
      "to": 245.65,
      "sid": 81,
      "location": 2,
      "content": "就是逻辑上相邻的元素呢在物理位置上也是相邻的"
    },
    {
      "from": 245.65,
      "to": 251.04,
      "sid": 82,
      "location": 2,
      "content": "嗯好那我们这里面存储第一个元素的这个地址嗯"
    },
    {
      "from": 251.04,
      "to": 253.81,
      "sid": 83,
      "location": 2,
      "content": "也称作这个基地址啊"
    },
    {
      "from": 253.81,
      "to": 256.03,
      "sid": 84,
      "location": 2,
      "content": "或者是这个首地址嗯"
    },
    {
      "from": 256.03,
      "to": 257.46,
      "sid": 85,
      "location": 2,
      "content": "或者是首地址"
    },
    {
      "from": 258.039,
      "to": 262.54,
      "sid": 86,
      "location": 2,
      "content": "那我们说嗯这块呢需要同学们注意的嗯"
    },
    {
      "from": 262.78,
      "to": 264.85,
      "sid": 87,
      "location": 2,
      "content": "需要同学们注意注意什么呢"
    },
    {
      "from": 264.85,
      "to": 270.95,
      "sid": 88,
      "location": 2,
      "content": "就是呃不仅我们在存储的时候要仍然保持它们的先后顺序"
    },
    {
      "from": 270.95,
      "to": 276.44,
      "sid": 89,
      "location": 2,
      "content": "而且呢要注意存储的时候必须占用一片连续的空间"
    },
    {
      "from": 276.44,
      "to": 279.75,
      "sid": 90,
      "location": 2,
      "content": "比如说咱们这个有六个元素的一个线性表"
    },
    {
      "from": 279.75,
      "to": 285.12,
      "sid": 91,
      "location": 2,
      "content": "那么这六个元素呢不仅要按照他们先后的顺序一一对应的存储"
    },
    {
      "from": 285.12,
      "to": 290.3,
      "sid": 92,
      "location": 2,
      "content": "而且呢不得中间有这个空的存储单元嗯"
    },
    {
      "from": 290.3,
      "to": 292.28,
      "sid": 93,
      "location": 2,
      "content": "那么这样依次存储地址"
    },
    {
      "from": 292.28,
      "to": 295.03,
      "sid": 94,
      "location": 2,
      "content": "连续中间没有空出的存储单元呢"
    },
    {
      "from": 295.03,
      "to": 298.24,
      "sid": 95,
      "location": 2,
      "content": "就是一个典型的线性表的顺序存储结构"
    },
    {
      "from": 298.24,
      "to": 300.13,
      "sid": 96,
      "location": 2,
      "content": "那么如果我们在存储的时候"
    },
    {
      "from": 300.13,
      "to": 302.98,
      "sid": 97,
      "location": 2,
      "content": "中间出现了空着的存储单元"
    },
    {
      "from": 302.98,
      "to": 305.56,
      "sid": 98,
      "location": 2,
      "content": "我们说这就不是嗯"
    },
    {
      "from": 305.56,
      "to": 306.94,
      "sid": 99,
      "location": 2,
      "content": "这个地址就不连续了"
    },
    {
      "from": 306.94,
      "to": 307.84,
      "sid": 100,
      "location": 2,
      "content": "不连续"
    },
    {
      "from": 307.84,
      "to": 310.62,
      "sid": 101,
      "location": 2,
      "content": "本来二的后记应该是三嗯"
    },
    {
      "from": 310.62,
      "to": 312.33,
      "sid": 102,
      "location": 2,
      "content": "下面一个位置应该是三"
    },
    {
      "from": 312.33,
      "to": 313.62,
      "sid": 103,
      "location": 2,
      "content": "现在不是了嗯"
    },
    {
      "from": 313.62,
      "to": 315.21,
      "sid": 104,
      "location": 2,
      "content": "二的后继是一个空了"
    },
    {
      "from": 315.21,
      "to": 318.47,
      "sid": 105,
      "location": 2,
      "content": "他就不能表示这种前驱后继之间的这个关系"
    },
    {
      "from": 318.47,
      "to": 322.08,
      "sid": 106,
      "location": 2,
      "content": "所以我们说这就不是一个线性表的顺序存储结构"
    },
    {
      "from": 322.08,
      "to": 326.819,
      "sid": 107,
      "location": 2,
      "content": "也就是说顺序存储结构的必须要占用一片连续的存储空间"
    },
    {
      "from": 326.819,
      "to": 327.209,
      "sid": 108,
      "location": 2,
      "content": "嗯"
    },
    {
      "from": 327.209,
      "to": 328.97,
      "sid": 109,
      "location": 2,
      "content": "连续的存储空间好"
    },
    {
      "from": 328.97,
      "to": 331.01,
      "sid": 110,
      "location": 2,
      "content": "那我们说再用一片连续的存储空间"
    },
    {
      "from": 331.01,
      "to": 333.68,
      "sid": 111,
      "location": 2,
      "content": "还有一个非常大的好处"
    },
    {
      "from": 333.68,
      "to": 337.98,
      "sid": 112,
      "location": 2,
      "content": "就是如果我们知道某一个元素它的存储位置"
    },
    {
      "from": 337.98,
      "to": 341.19,
      "sid": 113,
      "location": 2,
      "content": "那么其他的元素存储位置我们也就知道了"
    },
    {
      "from": 341.19,
      "to": 346.36,
      "sid": 114,
      "location": 2,
      "content": "或者说我们只要知道这个第一个元素存储在什么位置"
    },
    {
      "from": 346.36,
      "to": 351.969,
      "sid": 115,
      "location": 2,
      "content": "那么其他元素我们都可以通过计算就可以得到它的存储位置好"
    },
    {
      "from": 351.969,
      "to": 353.659,
      "sid": 116,
      "location": 2,
      "content": "那我们来看一下嗯"
    },
    {
      "from": 353.659,
      "to": 358.099,
      "sid": 117,
      "location": 2,
      "content": "唉比如说我从a一到a n这样存储了n个元素"
    },
    {
      "from": 358.099,
      "to": 361.84,
      "sid": 118,
      "location": 2,
      "content": "假如说每个元素都需要占用八个存储单元"
    },
    {
      "from": 361.84,
      "to": 368.12,
      "sid": 119,
      "location": 2,
      "content": "那么其中某一个元素如果是在嗯这个2000号单元"
    },
    {
      "from": 368.12,
      "to": 370.64,
