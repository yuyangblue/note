      "from": 297.04,
      "to": 298.28,
      "sid": 107,
      "location": 2,
      "content": "就叫做顺序表"
    },
    {
      "from": 298.28,
      "to": 301.52,
      "sid": 108,
      "location": 2,
      "content": "线性表呢用链式存储结构呢来存储"
    },
    {
      "from": 301.52,
      "to": 302.36,
      "sid": 109,
      "location": 2,
      "content": "就叫做链表"
    },
    {
      "from": 302.36,
      "to": 306.05,
      "sid": 110,
      "location": 2,
      "content": "我们把它们两个放在一起来比较一下嗯"
    },
    {
      "from": 306.05,
      "to": 309.47,
      "sid": 111,
      "location": 2,
      "content": "首先我们比较一下他们的空间效率嗯"
    },
    {
      "from": 309.47,
      "to": 310.62,
      "sid": 112,
      "location": 2,
      "content": "他们的空间效率"
    },
    {
      "from": 310.62,
      "to": 312.36,
      "sid": 113,
      "location": 2,
      "content": "那么说是在顺序表呢"
    },
    {
      "from": 312.36,
      "to": 316.2,
      "sid": 114,
      "location": 2,
      "content": "我们是事先直接分配好一个数组嗯"
    },
    {
      "from": 316.2,
      "to": 320.02,
      "sid": 115,
      "location": 2,
      "content": "来存储这些数据元素是预先已经分配好的"
    },
    {
      "from": 320.02,
      "to": 322.57,
      "sid": 116,
      "location": 2,
      "content": "那么预先分配好的这一块空间呢"
    },
    {
      "from": 322.57,
      "to": 324.61,
      "sid": 117,
      "location": 2,
      "content": "有可能数组元素比较少"
    },
    {
      "from": 324.61,
      "to": 326.56,
      "sid": 118,
      "location": 2,
      "content": "那么空间呢就会浪费嗯"
    },
    {
      "from": 326.56,
      "to": 329.07,
      "sid": 119,
      "location": 2,
      "content": "有有很多闲置的空间嗯"
    },
    {
      "from": 329.07,
      "to": 332.049,
