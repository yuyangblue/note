  "body": [
    {
      "from": 1.56,
      "to": 2.28,
      "sid": 1,
      "location": 2,
      "content": "同学们好"
    },
    {
      "from": 2.28,
      "to": 4.29,
      "sid": 2,
      "location": 2,
      "content": "那么截止到目前为止呢"
    },
    {
      "from": 4.29,
      "to": 10.31,
      "sid": 3,
      "location": 2,
      "content": "咱们就把线性表的顺序存储结构以及线性表的链式存储结构"
    },
    {
      "from": 10.31,
      "to": 14.27,
      "sid": 4,
      "location": 2,
      "content": "唉这两种存储结构呢都给同学们介绍完了嗯"
    },
    {
      "from": 14.27,
      "to": 15.48,
      "sid": 5,
      "location": 2,
      "content": "介绍完了好"
    },
    {
      "from": 15.48,
      "to": 19.32,
      "sid": 6,
      "location": 2,
      "content": "那我们说这两种存储结构到底哪一种好呢"
    },
    {
      "from": 19.32,
      "to": 22.509,
      "sid": 7,
      "location": 2,
      "content": "嗯我们在有实际问题需要处理的时候"
    },
    {
      "from": 22.509,
      "to": 26.119,
      "sid": 8,
      "location": 2,
      "content": "我们是该选择顺序存储结构来存储线性表"
    },
    {
      "from": 26.119,
      "to": 30.289,
      "sid": 9,
      "location": 2,
      "content": "还是选择链式存储结构来存储线性表呢"
    },
    {
      "from": 30.289,
      "to": 35.23,
      "sid": 10,
      "location": 2,
      "content": "所以接下来呀咱们就把这两种存储结构嗯进行一个比较"
    },
    {
      "from": 35.23,
      "to": 37.14,
      "sid": 11,
      "location": 2,
      "content": "进行一个比较好"
    },
    {
      "from": 37.14,
      "to": 39.12,
      "sid": 12,
      "location": 2,
      "content": "那么在比较他们两个之前呢"
    },
    {
      "from": 39.12,
      "to": 44.85,
      "sid": 13,
      "location": 2,
      "content": "咱们来把这个链式存储结构的优点和缺点来总结一下"
    },
    {
      "from": 44.85,
      "to": 45.42,
      "sid": 14,
      "location": 2,
      "content": "嗯"
    },
    {
      "from": 45.42,
      "to": 47.62,
      "sid": 15,
      "location": 2,
      "content": "我们说什么是链式存储结构啊"
    },
    {
      "from": 47.62,
      "to": 51.94,
      "sid": 16,
      "location": 2,
      "content": "就是存储数据元素的时候不一定占有一片连续的空间"
    },
    {
      "from": 51.94,
      "to": 54.37,
      "sid": 17,
      "location": 2,
      "content": "嗯那不占有连续的空间"
    },
    {
      "from": 54.37,
      "to": 58.12,
      "sid": 18,
      "location": 2,
      "content": "我们怎么表示数据元素之间的逻辑关系呢"
    },
    {
      "from": 58.12,
      "to": 59.7,
      "sid": 19,
      "location": 2,
      "content": "啊谁是谁的前驱"
    },
    {
      "from": 59.7,
      "to": 61.44,
      "sid": 20,
      "location": 2,
      "content": "谁又是谁的后继呢"
    },
    {
      "from": 61.44,
      "to": 66.039,
      "sid": 21,
      "location": 2,
      "content": "我们说我们想出来的办法是存储每一个节点的时候呢"
    },
    {
      "from": 66.039,
      "to": 69.579,
      "sid": 22,
      "location": 2,
      "content": "嗯再给它多嗯多存一点东西"
    },
    {
      "from": 69.579,
      "to": 70.329,
      "sid": 23,
      "location": 2,
      "content": "存什么呢"
    },
    {
      "from": 70.329,
      "to": 72.67,
      "sid": 24,
      "location": 2,
      "content": "存下一个节点的嗯"
    },
    {
      "from": 72.67,
      "to": 74.02,
      "sid": 25,
      "location": 2,
      "content": "这个地址啊"
    },
    {
      "from": 74.02,
      "to": 76.27,
      "sid": 26,
      "location": 2,
      "content": "下一个节点地址在双向链表当中"
    },
    {
      "from": 76.27,
      "to": 78.46,
      "sid": 27,
      "location": 2,
      "content": "我们再增加一个呃"
    },
    {
      "from": 78.46,
      "to": 80.809,
      "sid": 28,
      "location": 2,
      "content": "成员在增加什么呢"
    },
    {
      "from": 80.809,
      "to": 84.049,
      "sid": 29,
      "location": 2,
      "content": "上一个节点的前驱节点的地址嗯"
    },
    {
      "from": 84.049,
      "to": 85.429,
      "sid": 30,
      "location": 2,
      "content": "是这样来存储的"
    },
    {
      "from": 85.429,
      "to": 88.76,
      "sid": 31,
      "location": 2,
      "content": "这样呢通过这个地址就可以描述出来嗯"
    },
    {
      "from": 88.76,
      "to": 91.79,
      "sid": 32,
      "location": 2,
      "content": "数据元素之间的内在的逻辑关系"
    },
    {
      "from": 91.79,
      "to": 95.22,
      "sid": 33,
      "location": 2,
      "content": "这是咱们说的这个链式存储结构"
    },
    {
      "from": 95.22,
      "to": 96.75,
      "sid": 34,
      "location": 2,
      "content": "那么它有什么优点呢"
    },
    {
      "from": 96.75,
      "to": 98.02,
      "sid": 35,
      "location": 2,
      "content": "说链式存储结构"
    },
    {
      "from": 98.02,
      "to": 100.96,
      "sid": 36,
      "location": 2,
      "content": "那我们就不用一下子分配好多的空间了"
    },
    {
      "from": 100.96,
      "to": 104.54,
      "sid": 37,
      "location": 2,
      "content": "嗯这个存储数据元素的这个空间呀"
    },
    {
      "from": 104.54,
      "to": 106.4,
      "sid": 38,
      "location": 2,
      "content": "我们可以动态的申请啊"
    },
    {
      "from": 106.4,
      "to": 109.11,
      "sid": 39,
      "location": 2,
      "content": "动态的申请需要呢我们就申请嗯"
    },
    {
      "from": 109.11,
      "to": 109.83,
      "sid": 40,
      "location": 2,
      "content": "不用了"
    },
    {
      "from": 109.83,
      "to": 110.55,
      "sid": 41,
      "location": 2,
      "content": "删除了"
    },
    {
      "from": 110.55,
      "to": 112.44,
      "sid": 42,
      "location": 2,
      "content": "那我们就把它释放了就可以了"
    },
    {
      "from": 112.44,
      "to": 114.17,
      "sid": 43,
      "location": 2,
      "content": "嗯动态的申请"
    },
    {
      "from": 114.17,
      "to": 119.81,
      "sid": 44,
      "location": 2,
      "content": "另外呢就是删除和插入操作的时候嗯"
    },
    {
      "from": 119.81,
      "to": 121.89,
      "sid": 45,
      "location": 2,
      "content": "我们只需要修改指针"
    },
    {
      "from": 121.89,
      "to": 124.83,
      "sid": 46,
      "location": 2,
      "content": "不需要移动大量的数据元素"
    },
    {
      "from": 124.83,
      "to": 126.33,
      "sid": 47,
      "location": 2,
      "content": "嗯这是它的优点"
    },
    {
      "from": 126.33,
      "to": 128.03,
      "sid": 48,
      "location": 2,
      "content": "那么它有什么缺点呀"
    },
    {
      "from": 128.03,
      "to": 129.59,
      "sid": 49,
      "location": 2,
      "content": "咱们刚才说了嗯"
    },
    {
      "from": 129.59,
      "to": 133.91,
      "sid": 50,
      "location": 2,
      "content": "每个数据元素在存储数据本身的同时呢"
    },
    {
      "from": 133.91,
      "to": 138.28,
      "sid": 51,
      "location": 2,
      "content": "还需要存储它的后继节点或者前驱节点的地址"
    },
    {
      "from": 138.28,
      "to": 141.1,
      "sid": 52,
      "location": 2,
      "content": "所以呢我们需要额外的指针域嗯"
    },
    {
      "from": 141.1,
      "to": 142.43,
      "sid": 53,
      "location": 2,
      "content": "占用额外的空间"
    },
    {
      "from": 142.43,
      "to": 145.4,
      "sid": 54,
      "location": 2,
      "content": "那么它的存储密度呢就比较小"
    },
    {
      "from": 145.4,
      "to": 148.01,
      "sid": 55,
      "location": 2,
      "content": "那么这个存储密度是怎么算的呢"
    },
    {
      "from": 148.01,
      "to": 149.21,
      "sid": 56,
      "location": 2,
      "content": "嗯是这样算的"
    },
    {
      "from": 149.21,
      "to": 150.8,
      "sid": 57,
      "location": 2,
      "content": "因为这个节点嗯"
    },
    {
      "from": 150.8,
      "to": 158.96,
      "sid": 58,
      "location": 2,
      "content": "它存储数据元素本身所占用的空间除以这个节点所占用的总的空间"
    },
    {
      "from": 158.96,
      "to": 159.32,
      "sid": 59,
      "location": 2,
      "content": "嗯"
    },
    {
      "from": 159.32,
      "to": 159.74,
      "sid": 60,
      "location": 2,
      "content": "总的空间"
    },
    {
      "from": 159.74,
      "to": 162.86,
      "sid": 61,
      "location": 2,
      "content": "这个总空间呢就是除了自己本身之外"
    },
    {
      "from": 162.86,
      "to": 166.37,
      "sid": 62,
      "location": 2,
      "content": "还需要再加上嗯这个存储指针"
    },
    {
      "from": 166.37,
      "to": 168.86,
      "sid": 63,
      "location": 2,
      "content": "存储指针唉所需要的空间"
    },
    {
      "from": 168.86,
      "to": 172.049,
      "sid": 64,
      "location": 2,
      "content": "比如说咱们存储一个节点"
    },
    {
      "from": 172.049,
      "to": 175.18,
      "sid": 65,
      "location": 2,
      "content": "存储这个数据元素呢本身需要八个字节"
    },
    {
      "from": 175.18,
      "to": 181.3,
      "sid": 66,
      "location": 2,
      "content": "那么另外呢我们还需要四个字节来存储下一数据元素的地址嗯"
    },
    {
      "from": 181.3,
      "to": 182.41,
      "sid": 67,
      "location": 2,
      "content": "有一个指针域"
    },
    {
      "from": 182.41,
      "to": 184.51,
      "sid": 68,
      "location": 2,
      "content": "那么这样它总共8+4"
    },
    {
      "from": 184.51,
      "to": 186.42,
      "sid": 69,
      "location": 2,
      "content": "需要12个字节"
    },
    {
      "from": 186.42,
      "to": 189.45,
      "sid": 70,
      "location": 2,
      "content": "那么存储自身需要八字节嗯"
    },
    {
      "from": 189.45,
      "to": 193.34,
      "sid": 71,
      "location": 2,
      "content": "存储自身需需要这个八个字节"
    },
    {
      "from": 194.339,
      "to": 197.749,
      "sid": 72,
      "location": 2,
      "content": "这个总共需要8+42个字节"
    },
    {
      "from": 197.749,
      "to": 200.419,
      "sid": 73,
      "location": 2,
      "content": "8÷12呢是67%"
    },
    {
      "from": 200.419,
      "to": 204.92,
      "sid": 74,
      "location": 2,
      "content": "那我们说它的存储密度呢嗯是67%"
    },
    {
      "from": 204.92,
      "to": 206.27,
      "sid": 75,
      "location": 2,
      "content": "0.67"
    },
    {
      "from": 206.27,
      "to": 207.35,
      "sid": 76,
      "location": 2,
      "content": "0.67"
    },
    {
      "from": 207.35,
      "to": 209.57,
      "sid": 77,
      "location": 2,
      "content": "那我们一呃一说呢"
    },
    {
      "from": 209.57,
      "to": 211.4,
      "sid": 78,
      "location": 2,
      "content": "一般这个存储密度越大"
    },
    {
      "from": 211.4,
      "to": 214.97,
      "sid": 79,
      "location": 2,
      "content": "那存储空间的利用率呢就会越高啊"
    },
    {
      "from": 214.97,
      "to": 216.25,
      "sid": 80,
      "location": 2,
      "content": "利用率就会越高"
    },
    {
      "from": 216.25,
      "to": 218.83,
      "sid": 81,
      "location": 2,
      "content": "那么在顺序表当中嗯"
    },
    {
      "from": 218.83,
      "to": 222.89,
      "sid": 82,
      "location": 2,
      "content": "顺序表当中我们只需要存储数据元素本身"
    },
    {
      "from": 222.89,
      "to": 229.83,
      "sid": 83,
      "location": 2,
      "content": "所以呢顺序表的存储密度最高是一嗯是1a它的存储密度比较大"
    },
    {
      "from": 229.83,
      "to": 233.67,
      "sid": 84,
      "location": 2,
      "content": "而链表呢存储密度就是小于一的嗯"
    },
    {
      "from": 233.67,
      "to": 235.78,
      "sid": 85,
      "location": 2,
      "content": "就是小于一的诶"
    },
    {
      "from": 236.959,
      "to": 242.68,
      "sid": 86,
      "location": 2,
      "content": "那我们说这个链式存储结构它的存储密度呢会比较小"
    },
    {
      "from": 242.68,
      "to": 244.54,
      "sid": 87,
      "location": 2,
      "content": "嗯这是它的一个缺点"
    },
    {
      "from": 244.54,
      "to": 245.32,
      "sid": 88,
      "location": 2,
      "content": "为什么小"
    },
    {
      "from": 245.32,
      "to": 249.52,
      "sid": 89,
      "location": 2,
      "content": "它需要额外的空间嗯来存储指针"
    },
    {
      "from": 249.76,
      "to": 252.79,
      "sid": 90,
      "location": 2,
      "content": "那么另外呢咱们这个链式存储结构啊"
    },
    {
      "from": 252.79,
      "to": 256.39,
      "sid": 91,
      "location": 2,
      "content": "它还是一个非随机存取的嗯"
    },
    {
      "from": 256.39,
      "to": 258.43,
      "sid": 92,
      "location": 2,
      "content": "随机存取是什么意思来着"
    },
    {
      "from": 258.43,
      "to": 260.24,
      "sid": 93,
      "location": 2,
      "content": "同学们回忆一下嗯"
    },
    {
      "from": 260.24,
      "to": 262.88,
      "sid": 94,
      "location": 2,
      "content": "我们说随机存取呢只说n一个元素"
    },
    {
      "from": 265.39,
      "to": 266.02,
      "sid": 95,
      "location": 2,
      "content": "是不是啊"
    },
    {
      "from": 266.02,
      "to": 268.06,
      "sid": 96,
      "location": 2,
      "content": "哎但是在链式存储结构当中"
    },
    {
      "from": 268.06,
      "to": 271.2,
      "sid": 97,
      "location": 2,
      "content": "我们想取任意一个元素呢是不行的啊"
    },
    {
      "from": 271.2,
      "to": 273.96,
      "sid": 98,
      "location": 2,
      "content": "我们必须通过头指针或者是为指针"
    },
    {
      "from": 274.159,
      "to": 279.229,
      "sid": 99,
      "location": 2,
      "content": "沿着这个指针链才能找到我们想要的这个节点"
    },
    {
      "from": 279.229,
      "to": 281.779,
      "sid": 100,
      "location": 2,
      "content": "所以呢这个时间复杂度就高了嗯"
    },
    {
      "from": 281.779,
      "to": 283.56,
      "sid": 101,
      "location": 2,
      "content": "时间复杂度高了好"
    },
    {
      "from": 283.56,
      "to": 286.92,
      "sid": 102,
      "location": 2,
      "content": "这就是咱们说的这个链式存储结构"
    },
    {
      "from": 286.92,
      "to": 288.45,
      "sid": 103,
      "location": 2,
      "content": "它的缺点嗯"
    },
    {
      "from": 288.45,
      "to": 289.2,
      "sid": 104,
      "location": 2,
      "content": "它的缺点"
    },
    {
      "from": 289.2,
      "to": 293.92,
      "sid": 105,
      "location": 2,
      "content": "那么接下来呢咱们就把这个顺序存储结构嗯"
    },
    {
      "from": 293.92,
      "to": 297.04,
      "sid": 106,
      "location": 2,
      "content": "如果线性表用顺序存储结构来存储"
    },
