  "type": "AIsubtitle",
  "lang": "zh",
  "version": "sync-v1.4.0.4",
  "body": [
    {
      "from": 1.5,
      "to": 2.46,
      "sid": 1,
      "location": 2,
      "content": "同学们好"
    },
    {
      "from": 2.46,
      "to": 7.9,
      "sid": 2,
      "location": 2,
      "content": "这节课我们继续来学习第一章绪论嗯"
    },
    {
      "from": 7.9,
      "to": 13.16,
      "sid": 3,
      "location": 2,
      "content": "接下来我们要学习第三节抽象数据类型的表示与实现"
    },
    {
      "from": 13.16,
      "to": 14.6,
      "sid": 4,
      "location": 2,
      "content": "开始这一节之前呢"
    },
    {
      "from": 14.6,
      "to": 17.46,
      "sid": 5,
      "location": 2,
      "content": "我们先把前两节内容稍微复习一下"
    },
    {
      "from": 17.62,
      "to": 20.56,
      "sid": 6,
      "location": 2,
      "content": "在第一节当中我们学习了嗯"
    },
    {
      "from": 20.56,
      "to": 25.63,
      "sid": 7,
      "location": 2,
      "content": "那么我们现在呢计算机发展的这个应用领域越来越广"
    },
    {
      "from": 25.63,
      "to": 26.26,
      "sid": 8,
      "location": 2,
      "content": "嗯"
    },
    {
      "from": 26.26,
      "to": 29.05,
      "sid": 9,
      "location": 2,
      "content": "那么非数值计算问题越来越多"
    },
    {
      "from": 29.05,
      "to": 33.01,
      "sid": 10,
      "location": 2,
      "content": "那我们要处理的数据呢就不再是纯粹的数值了"
    },
    {
      "from": 33.01,
      "to": 35.1,
      "sid": 11,
      "location": 2,
      "content": "而是字符图像"
    },
    {
      "from": 35.1,
      "to": 37.25,
      "sid": 12,
      "location": 2,
      "content": "声音表格等等"
    },
    {
      "from": 37.25,
      "to": 40.04,
      "sid": 13,
      "location": 2,
      "content": "那么这些新的杂乱无章的"
    },
    {
      "from": 40.04,
      "to": 44.06,
      "sid": 14,
      "location": 2,
      "content": "但是又有一定结构的数据该如何处理呢"
    },
    {
      "from": 44.06,
      "to": 45.84,
      "sid": 15,
      "location": 2,
      "content": "这就是我们要研究的问题"
    },
    {
      "from": 45.84,
      "to": 49.74,
      "sid": 16,
      "location": 2,
      "content": "我们要找出这些数据之间的逻辑关系"
    },
    {
      "from": 49.74,
      "to": 51.9,
      "sid": 17,
      "location": 2,
      "content": "这就是数据的逻辑结构"
    },
    {
      "from": 51.9,
      "to": 55.14,
      "sid": 18,
      "location": 2,
      "content": "然后呢我们要把这些数据存储在计算机里头"
    },
    {
      "from": 55.14,
      "to": 57.42,
      "sid": 19,
      "location": 2,
      "content": "这就是数据的存储结构"
    },
    {
      "from": 57.42,
      "to": 60.89,
      "sid": 20,
      "location": 2,
      "content": "那么存储到计算机当中的数据该如何处理呢"
    },
    {
      "from": 60.89,
      "to": 63.62,
      "sid": 21,
      "location": 2,
      "content": "嗯怎么样才能有效地运算呢"
    },
    {
      "from": 63.62,
      "to": 65.42,
      "sid": 22,
      "location": 2,
      "content": "就是算法研究的内容"
    },
    {
      "from": 65.42,
      "to": 70.58,
      "sid": 23,
      "location": 2,
      "content": "那么这三部分就是咱们这门课要重点研究的内容好了"
    },
    {
      "from": 70.58,
      "to": 74.19,
      "sid": 24,
      "location": 2,
      "content": "那么我们在第二节呢又学习了一些基本概念"
    },
    {
      "from": 74.19,
      "to": 74.49,
      "sid": 25,
      "location": 2,
      "content": "嗯"
    },
    {
      "from": 74.49,
      "to": 75.81,
      "sid": 26,
      "location": 2,
      "content": "有学习基本概念"
    },
    {
      "from": 75.81,
      "to": 78.03,
      "sid": 27,
      "location": 2,
      "content": "那么说用计算机来处理问题"
    },
    {
      "from": 78.03,
      "to": 82.11,
      "sid": 28,
      "location": 2,
      "content": "必须要把我们的问题当中抽象出来的嗯"
    },
    {
      "from": 82.11,
      "to": 84.03,
      "sid": 29,
      "location": 2,
      "content": "信息要处理的呃"
    },
    {
      "from": 84.03,
      "to": 89.55,
      "sid": 30,
      "location": 2,
      "content": "内容呢把它变成计算机能够识别和处理的啊"
    },
    {
      "from": 89.55,
      "to": 91.14,
      "sid": 31,
      "location": 2,
      "content": "这个数据诶"
    },
    {
      "from": 91.76,
      "to": 97.45,
      "sid": 32,
      "location": 2,
      "content": "这些被能够被计算机识别处理的这个信号的集合就是数据"
    },
    {
      "from": 97.45,
      "to": 102.85,
      "sid": 33,
      "location": 2,
      "content": "那么数据当中有一些内容呢唉相对关系比较紧密的啊"
    },
    {
      "from": 102.85,
      "to": 104.5,
      "sid": 34,
      "location": 2,
      "content": "这样的一个一个的个体"
    },
    {
      "from": 104.5,
      "to": 106.86,
      "sid": 35,
      "location": 2,
      "content": "我们就称作数据元素"
    },
    {
      "from": 107.24,
      "to": 111.86,
      "sid": 36,
      "location": 2,
      "content": "数据元素当中性质相同的这个构成的一个集合"
    },
    {
      "from": 111.86,
      "to": 115.32,
      "sid": 37,
      "location": 2,
      "content": "数据的子集我们称作数据对象"
    },
    {
      "from": 115.32,
      "to": 119.79,
      "sid": 38,
      "location": 2,
      "content": "那么我们在数据元素上再加上数据元素之间的关系"
    },
    {
      "from": 119.79,
      "to": 121.65,
      "sid": 39,
      "location": 2,
      "content": "这就是数据结构"
    },
    {
      "from": 121.65,
      "to": 124.0,
      "sid": 40,
      "location": 2,
      "content": "所以说我们说数据结构包括什么呢"
    },
    {
      "from": 124.0,
      "to": 127.37,
      "sid": 41,
      "location": 2,
      "content": "数据元素以及数据元素之间的关系"
    },
    {
      "from": 127.37,
      "to": 132.86,
      "sid": 42,
      "location": 2,
      "content": "如果这个关系我们是从呃实际问题当中抽象出来的"
    },
    {
      "from": 132.86,
      "to": 133.43,
      "sid": 43,
      "location": 2,
      "content": "嗯"
    },
    {
      "from": 133.43,
      "to": 137.18,
      "sid": 44,
      "location": 2,
      "content": "是这个和具体怎么存储无关"
    },
    {
      "from": 137.18,
      "to": 140.87,
      "sid": 45,
      "location": 2,
      "content": "嗯获得的是这个问题的逻辑模型嗯"
    },
    {
      "from": 140.87,
      "to": 142.52,
      "sid": 46,
      "location": 2,
      "content": "逻辑模型诶"
    },
    {
      "from": 142.52,
      "to": 145.72,
      "sid": 47,
      "location": 2,
      "content": "那么我们就把这种关系称作逻辑结构"
    },
    {
      "from": 145.72,
      "to": 147.58,
      "sid": 48,
      "location": 2,
      "content": "那我们学了逻辑结构呢"
    },
    {
      "from": 147.58,
      "to": 149.62,
      "sid": 49,
      "location": 2,
      "content": "嗯可以有两种分类方式"
    },
    {
      "from": 149.62,
      "to": 151.06,
      "sid": 50,
      "location": 2,
      "content": "一种分成非线性的"
    },
    {
      "from": 151.06,
      "to": 152.67,
      "sid": 51,
      "location": 2,
      "content": "另一种非常线性的"
    },
    {
      "from": 152.67,
      "to": 154.32,
      "sid": 52,
      "location": 2,
      "content": "那么也可以分成四种"
    },
    {
      "from": 154.32,
      "to": 156.6,
      "sid": 53,
      "location": 2,
      "content": "这四种分别就是集合结构"
    },
    {
      "from": 156.6,
      "to": 157.71,
      "sid": 54,
      "location": 2,
      "content": "线性结构"
    },
    {
      "from": 157.71,
      "to": 160.82,
      "sid": 55,
      "location": 2,
      "content": "树形结构和图状结构"
    },
    {
      "from": 160.82,
      "to": 165.38,
      "sid": 56,
      "location": 2,
      "content": "那么如果我们把逻辑结构嗯影影响到内存"
    },
    {
      "from": 165.38,
      "to": 168.41,
      "sid": 57,
      "location": 2,
      "content": "也就是说我们要考虑这个数据如何存储"
    },
    {
      "from": 168.41,
      "to": 169.7,
      "sid": 58,
      "location": 2,
      "content": "不仅要存储数据"
    },
    {
      "from": 169.7,
      "to": 172.55,
      "sid": 59,
      "location": 2,
      "content": "还要存储数据的逻辑关系"
    },
    {
      "from": 172.55,
      "to": 177.01,
      "sid": 60,
      "location": 2,
      "content": "那么这个就是我们要考虑的存储结构"
    },
    {
      "from": 177.01,
      "to": 179.23,
      "sid": 61,
      "location": 2,
      "content": "存储结构呢也有四种"
    },
    {
      "from": 179.23,
      "to": 186.0,
      "sid": 62,
      "location": 2,
      "content": "我们重点学习的是顺序存储结构和这个链式存储结构"
    },
    {
      "from": 186.42,
      "to": 193.58,
      "sid": 63,
      "location": 2,
      "content": "那么还给大家介绍了另外两种索引存储结构和散列存储结构好了"
    },
    {
      "from": 193.58,
      "to": 201.48,
      "sid": 64,
      "location": 2,
      "content": "那我们说这个嗯在研究了数据以及它们之间的关系之后"
    },
    {
      "from": 201.48,
      "to": 207.99,
      "sid": 65,
      "location": 2,
      "content": "接下来我们就要考虑到底怎么样对这个数据进行运算嗯运算"
    },
    {
      "from": 207.99,
      "to": 211.26,
      "sid": 66,
      "location": 2,
      "content": "所以我们说要对这个数据再加上操作的话"
    },
    {
      "from": 211.26,
      "to": 213.85,
      "sid": 67,
      "location": 2,
      "content": "这就是我们要研究的抽象数据类型"
    },
    {
      "from": 213.85,
      "to": 216.82,
      "sid": 68,
      "location": 2,
      "content": "所以抽象数据类型呢就包括数据对象"
    },
    {
      "from": 216.82,
      "to": 218.95,
      "sid": 69,
      "location": 2,
      "content": "数据对象之间的关系"
    },
    {
      "from": 218.95,
      "to": 222.17,
      "sid": 70,
      "location": 2,
      "content": "以及对数据的基本操作嗯"
    },
    {
      "from": 222.17,
      "to": 224.07,
      "sid": 71,
      "location": 2,
      "content": "最熟悉的基本操作好嘞"
    },
    {
      "from": 224.07,
      "to": 228.99,
      "sid": 72,
      "location": 2,
      "content": "那么咱们上一次课呢就研究了这个抽象数据类型嗯"
    },
    {
      "from": 228.99,
      "to": 231.51,
      "sid": 73,
      "location": 2,
      "content": "到底怎么样定义它呢"
    },
    {
      "from": 231.51,
      "to": 233.61,
      "sid": 74,
      "location": 2,
      "content": "是有固定的定义格式的"
    },
    {
      "from": 233.61,
      "to": 233.97,
      "sid": 75,
      "location": 2,
      "content": "嗯"
    },
    {
      "from": 233.97,
      "to": 236.27,
      "sid": 76,
      "location": 2,
      "content": "这样开头这样结束"
    },
    {
      "from": 236.27,
      "to": 239.0,
      "sid": 77,
      "location": 2,
      "content": "中间呢包括三个部分数据对象"
    },
    {
      "from": 239.0,
      "to": 242.83,
      "sid": 78,
      "location": 2,
      "content": "数据对象之间的关系以及基本操作好"
    },
    {
      "from": 242.83,
      "to": 247.09,
      "sid": 79,
      "location": 2,
      "content": "那比如说咱们现在呢定义了一个叫做圆的抽象数据类型"
    },
    {
      "from": 247.09,
      "to": 251.32,
      "sid": 80,
      "location": 2,
      "content": "那么它的数据对象呢包括rx y3 个嗯"
    },
    {
      "from": 251.32,
      "to": 253.04,
      "sid": 81,
      "location": 2,
      "content": "三个组成的一个圆"
    },
    {
      "from": 253.04,
      "to": 254.3,
      "sid": 82,
      "location": 2,
      "content": "就必须就这三个"
    },
    {
      "from": 254.3,
      "to": 255.56,
      "sid": 83,
      "location": 2,
      "content": "这三个是什么东西呢"
    },
    {
      "from": 255.56,
      "to": 257.24,
      "sid": 84,
      "location": 2,
      "content": "也就是这三个关系什么呢"
    },
    {
      "from": 257.24,
      "to": 259.039,
      "sid": 85,
      "location": 2,
      "content": "是一个虚无的这样的关系"
    },
    {
      "from": 259.039,
      "to": 261.919,
      "sid": 86,
      "location": 2,
      "content": "其中第一个r表示的是半径嗯"
    },
    {
      "from": 261.919,
      "to": 264.86,
      "sid": 87,
      "location": 2,
      "content": "后面的两个xy又是顺序的"
    },
    {
      "from": 264.86,
      "to": 268.97,
      "sid": 88,
      "location": 2,
      "content": "分别表示圆心的x坐标和y坐标嗯"
    },
    {
      "from": 268.97,
      "to": 270.919,
      "sid": 89,
      "location": 2,
      "content": "这就是数据之间的关系"
    },
    {
      "from": 270.919,
      "to": 272.509,
      "sid": 90,
      "location": 2,
      "content": "然后它有哪些操作呢"
    },
    {
      "from": 272.509,
      "to": 273.679,
      "sid": 91,
      "location": 2,
      "content": "构造一个圆呀"
    },
    {
      "from": 273.679,
      "to": 274.879,
      "sid": 92,
      "location": 2,
      "content": "求圆的面积"
    },
    {
      "from": 274.879,
      "to": 277.12,
      "sid": 93,
      "location": 2,
      "content": "求圆的周长啊等等嗯"
    },
    {
      "from": 277.78,
      "to": 283.6,
      "sid": 94,
      "location": 2,
      "content": "那么我们现在就把这个叫做圆的抽象数据类型给定义出来了"
    },
    {
      "from": 283.8,
      "to": 285.96,
      "sid": 95,
      "location": 2,
      "content": "为什么要定义抽象数据类型"
    },
    {
      "from": 285.96,
      "to": 287.52,
      "sid": 96,
      "location": 2,
      "content": "因为计算机里头没有"
    },
    {
      "from": 287.52,
      "to": 291.0,
      "sid": 97,
      "location": 2,
      "content": "是不是我们定义出来就这样就可以研究它嗯"
    },
    {
      "from": 291.0,
      "to": 292.68,
      "sid": 98,
      "location": 2,
      "content": "就可以操作它"
    },
    {
      "from": 292.68,
      "to": 294.48,
      "sid": 99,
      "location": 2,
      "content": "但是这个定义出来了以后"
    },
    {
      "from": 294.48,
      "to": 296.43,
      "sid": 100,
      "location": 2,
      "content": "只是形式上的定义嗯"
    },
    {
      "from": 296.43,
      "to": 298.59,
      "sid": 101,
      "location": 2,
      "content": "我们要想解决问题的话"
    },
    {
      "from": 298.59,
      "to": 300.24,
      "sid": 102,
      "location": 2,
      "content": "光靠这个形式定义不行"
    },
    {
      "from": 300.24,
      "to": 303.049,
      "sid": 103,
      "location": 2,
      "content": "我们还得把这个定义具体化嗯"
    },
    {
      "from": 303.049,
      "to": 304.669,
      "sid": 104,
      "location": 2,
      "content": "在计算机上实现了"
    },
    {
      "from": 304.669,
      "to": 308.51,
      "sid": 105,
      "location": 2,
      "content": "这才能是一个具体的有用的数据类型"
    },
    {
      "from": 308.51,
      "to": 310.12,
      "sid": 106,
      "location": 2,
      "content": "那怎么实现呢"
    },
    {
      "from": 310.12,
      "to": 313.18,
      "sid": 107,
      "location": 2,
      "content": "哎这就需要我们说具体的某一种语言"
    },
    {
      "from": 313.18,
      "to": 316.24,
      "sid": 108,
      "location": 2,
      "content": "那么咱们这门课程呢就是用c语言嗯"
    },
    {
      "from": 316.24,
      "to": 319.82,
      "sid": 109,
      "location": 2,
      "content": "用c语言来实现这个抽象数据类型"
    },
    {
      "from": 319.88,
      "to": 326.69,
      "sid": 110,
      "location": 2,
      "content": "我们用c语单元当中已经有的数据类型去定义它的存储结构"
    },
    {
      "from": 326.69,
      "to": 332.33,
      "sid": 111,
      "location": 2,
      "content": "然后呢再用c语言当中的函数去描述他是如何操作的"
    },
    {
      "from": 332.33,
      "to": 337.07,
      "sid": 112,
      "location": 2,
      "content": "嗯这样呢我们就可以变成计算机的程序了"
    },
    {
      "from": 337.07,
      "to": 341.5,
      "sid": 113,
      "location": 2,
      "content": "就可以在程序当中来使用这个抽象数据类型了"
    },
    {
      "from": 342.28,
      "to": 344.58,
      "sid": 114,
      "location": 2,
      "content": "那我们说这就是咱们的关键嗯"
    },
    {
      "from": 344.58,
      "to": 350.35,
      "sid": 115,
      "location": 2,
      "content": "抽象数据类型我们可以通过已经有的这个数据类型来表示"
    },
    {
      "from": 350.35,
      "to": 351.34,
      "sid": 116,
      "location": 2,
      "content": "可实现"
    },
    {
      "from": 351.34,
      "to": 356.42,
      "sid": 117,
      "location": 2,
      "content": "我们用已经有的数据类型来说明这个新的嗯类型"
    },
    {
      "from": 356.42,
      "to": 361.95,
      "sid": 118,
      "location": 2,
      "content": "用已经有的这些操作来来实现这个新的操作"
    },
    {
      "from": 361.95,
      "to": 365.7,
