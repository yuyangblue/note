      "to": 657.54,
      "sid": 244,
      "location": 2,
      "content": "再比如说这几个25"
    },
    {
      "from": 657.54,
      "to": 658.97,
      "sid": 245,
      "location": 2,
      "content": "39嗯"
    },
    {
      "from": 658.97,
      "to": 660.65,
      "sid": 246,
      "location": 2,
      "content": "还有这个11啊"
    },
    {
      "from": 660.65,
      "to": 661.52,
      "sid": 247,
      "location": 2,
      "content": "还有这个11"
    },
    {
      "from": 661.52,
      "to": 664.19,
      "sid": 248,
      "location": 2,
      "content": "他们的关键字的值不一样啊"
    },
    {
      "from": 664.19,
      "to": 667.68,
      "sid": 249,
      "location": 2,
      "content": "但是呢他们求出来的存储地址嗯"
    },
    {
      "from": 667.68,
      "to": 669.24,
      "sid": 250,
      "location": 2,
      "content": "存储地址都是四"
    },
    {
      "from": 669.24,
      "to": 670.2,
      "sid": 251,
      "location": 2,
      "content": "余数都是四"
    },
    {
      "from": 670.2,
      "to": 672.25,
      "sid": 252,
      "location": 2,
      "content": "都要存在这个4号位置"
    },
    {
      "from": 672.25,
      "to": 675.85,
      "sid": 253,
      "location": 2,
      "content": "那我们说这个时候就出现了嗯冲突"
    },
    {
      "from": 675.85,
      "to": 677.17,
      "sid": 254,
      "location": 2,
      "content": "这就叫做冲突"
    },
    {
      "from": 677.17,
      "to": 678.56,
      "sid": 255,
      "location": 2,
      "content": "什么叫做冲突啊"
    },
    {
      "from": 678.56,
      "to": 685.71,
      "sid": 256,
      "location": 2,
      "content": "我们按照这个散列函数来根据关键字的值计算它的存储位置"
    },
    {
      "from": 685.71,
      "to": 687.96,
      "sid": 257,
      "location": 2,
      "content": "虽然关键字值不相等"
    },
    {
      "from": 687.96,
      "to": 694.49,
      "sid": 258,
      "location": 2,
      "content": "但是呢计算出来的存储位置是相等的嗯这种情况我们就叫做冲突啊"
    },
    {
      "from": 694.49,
      "to": 695.62,
      "sid": 259,
      "location": 2,
      "content": "就叫做冲突"
    },
    {
      "from": 695.86,
      "to": 699.28,
      "sid": 260,
      "location": 2,
      "content": "那么下面一个概念呢叫做同义词"
    },
    {
      "from": 699.28,
      "to": 701.24,
      "sid": 261,
      "location": 2,
      "content": "那么什么叫做同义词啊"
    },
    {
      "from": 702.12,
      "to": 704.36,
      "sid": 262,
      "location": 2,
      "content": "就是像这样的嗯"
    },
    {
      "from": 704.36,
      "to": 705.8,
      "sid": 263,
      "location": 2,
      "content": "像这样的唉"
    },
    {
      "from": 705.8,
      "to": 713.41,
      "sid": 264,
      "location": 2,
      "content": "这些关键字它呢通过散列函数计算出来的函数值是一样的啊"
    },
    {
      "from": 713.41,
      "to": 713.89,
      "sid": 265,
      "location": 2,
      "content": "是一样的"
    },
    {
      "from": 713.89,
      "to": 719.52,
      "sid": 266,
      "location": 2,
      "content": "都是4÷7的余数都是四嗯那他们呢就称作同义词"
    },
    {
      "from": 719.52,
      "to": 724.2,
      "sid": 267,
      "location": 2,
      "content": "具有相同函数值的多个关键字就互称为同义词"
    },
    {
      "from": 724.2,
      "to": 725.639,
      "sid": 268,
      "location": 2,
      "content": "嗯好嘞"
    },
    {
      "from": 725.639,
      "to": 729.749,
      "sid": 269,
      "location": 2,
      "content": "这就是咱们关于散列表的基本概念"
    },
    {
      "from": 729.749,
